---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="よけろ！タクシー – 富士タクシー南相馬"
  description="画面の左右をタップしてよけるだけの簡単なミニゲーム。南相馬の道をどこまで走れるか挑戦してください。"
  noindex
  hideFloatCta
  hideNav
>

  <section class="section bg-black dg-page">
    <div class="container dg-shell">

      <header class="dg-topbar">
        <a class="dg-back" href="/game">
          <span class="dg-back__mark">‹</span>
          <span class="dg-back__text">よけろ！タクシー</span>
        </a>
        <div class="dg-scores">
          <div class="dg-score">
            <span class="dg-score__label">メーター</span>
            <span class="dg-score__value" id="dist">¥620</span>
          </div>
          <div class="dg-score">
            <span class="dg-score__label">さいこう</span>
            <span class="dg-score__value" id="best">¥0</span>
          </div>
        </div>
      </header>

      <div class="dg-stagewrap">
        <div class="dg-stage" id="stage">
          <canvas id="board" class="dg-canvas"></canvas>

          <!-- スタート -->
          <div class="dg-overlay" id="ovStart">
            <div class="dg-card">
              <img class="dg-logo" src="/images/logo-fuji-taxi.webp" alt="富士タクシー" width="72" height="72" />
              <h1 class="dg-card__title">よけろ！タクシー</h1>
              <p class="dg-card__lead">
                画面の<strong>左</strong>と<strong>右</strong>で車線をかえ、<br>
                <strong>まんなか</strong>でジャンプします。<br>
                道いっぱいの穴はジャンプでしか越えられません。<br>
                広い穴（×2の印）は2回タップしないと落ちてしまいます。
              </p>

              <ul class="dg-items">
                <li><span class="dg-chip dg-chip--fare">🙋</span>お客さま<em>チップがもらえる</em></li>
                <li><span class="dg-chip dg-chip--charm">🛡️</span>お守り<em>1回ぶつかっても平気</em></li>
                <li><span class="dg-chip dg-chip--slow">🐢</span>ゆっくり<em>5秒間ゆっくり走る</em></li>
                <li><span class="dg-chip dg-chip--ride">✨</span>お客さまを何人か<em>しばらく無敵</em></li>
                <li><span class="dg-chip dg-chip--boost">⚡</span>スピードアップ<em>4秒間、道の流れが速くなる</em></li>
                <li><span class="dg-chip dg-chip--wobble">💨</span>突風<em>3秒間、左右のタップが逆になる</em></li>
              </ul>

              <p class="dg-pick__label">乗る車をえらぶ</p>
              <div class="dg-cars" id="carPicker"></div>

              <p class="dg-suspend" id="suspendNote" hidden>
                <strong>免許停止中です</strong>
                人をはねてしまうと、しばらく運転できません。
              </p>
              <div class="dg-startRow">
                <button type="button" class="dg-btn" id="startBtn">はじめる</button>
                <button type="button" class="dg-btn dg-btn--ghost" id="rankOpenBtn">ランキング</button>
              </div>
            </div>
          </div>

          <!-- ゲームオーバー -->
          <div class="dg-overlay" id="ovOver" hidden>
            <div class="dg-card">
              <h2 class="dg-card__title" id="overTitle">ぶつかりました</h2>
              <p class="dg-result" id="overScore">¥620</p>
              <p class="dg-card__note" id="overNote">さいこう記録 ¥0</p>
              <p class="dg-suspend" id="suspendNote2" hidden>
                <strong>免許停止</strong>
                人をはねてしまいました。しばらく運転できません。
              </p>

              <!-- ランキング登録（今月の上位に入りそうなときだけ出す） -->
              <div class="dg-submit" id="submitBox" hidden>
                <p class="dg-submit__label" id="submitLabel">ランキングに登録しますか？</p>
                <div class="dg-submit__row">
                  <input type="text" id="nickInput" class="dg-submit__input" maxlength="12" placeholder="なまえ（12文字まで）" />
                  <button type="button" class="dg-btn dg-btn--sm" id="submitScoreBtn">登録</button>
                </div>
                <p class="dg-submit__msg" id="submitMsg"></p>
              </div>

              <div class="dg-overRow">
                <button type="button" class="dg-btn" id="retryBtn">もういちど</button>
                <button type="button" class="dg-btn dg-btn--ghost" id="rankOpenBtn2">ランキングを見る</button>
              </div>

              <!-- ご案内 -->
              <div class="dg-pr">
                <img class="dg-pr__logo" src="/images/logo-fuji-taxi.webp" alt="富士タクシー" width="44" height="44" />
                <div class="dg-pr__body">
                  <p class="dg-pr__name">富士タクシー南相馬</p>
                  <p class="dg-pr__sub">年中無休 7:00〜24:00／小高区・原町区</p>
                  <p class="dg-pr__links">
                    <a href="tel:0244442543">本社 0244-44-2543</a>
                    <a href="tel:0244320030">原町待機所 0244-32-0030</a>
                  </p>
                  <p class="dg-pr__links">
                    <a href="https://line.me/R/ti/p/@580lzpne" target="_blank" rel="noopener">公式LINE</a>
                    <a href="/">ホームページ</a>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- ランキング -->
          <div class="dg-overlay" id="ovRanking" hidden>
            <div class="dg-card">
              <h2 class="dg-card__title">ランキング</h2>
              <p class="dg-card__note">乗った車ごとに、みんなの記録を競います</p>
              <p class="dg-rankMonth" id="rankMonth"></p>
              <div class="dg-rankTabs" id="rankTabs"></div>
              <ol class="dg-rankList" id="rankList"></ol>
              <p class="dg-rankMsg" id="rankMsg"></p>
              <button type="button" class="dg-btn" id="rankCloseBtn">とじる</button>
            </div>
          </div>

          <!-- 一時停止 -->
          <div class="dg-overlay" id="ovPause" hidden>
            <div class="dg-card">
              <h2 class="dg-card__title">とまっています</h2>
              <button type="button" class="dg-btn" id="resumeBtn">つづける</button>
            </div>
          </div>
        </div>
      </div>

      <p class="dg-hint" id="hint">左＝左へ／まんなか＝ジャンプ／右＝右へ（PCは矢印キー）</p>

      <div class="dg-tools">
        <button type="button" class="dg-toolbtn" id="soundBtn" aria-pressed="true">🔊 音</button>
        <a class="dg-toolbtn" href="/game">ゲームをえらぶ</a>
      </div>

    </div>
  </section>

</Layout>

<style is:global>
  /* ============================================
     /game/dodge — よけろ！タクシー
     縦にスクロールする道を、左右にかわしていく。
     操作は「左半分か右半分をタップ」だけ。
     ============================================ */

  .dg-page {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    min-height: 100dvh;
  }

  .dg-shell {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .dg-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .dg-back {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--fuji-white);
    text-decoration: none;
  }
  .dg-back:hover { color: var(--fuji-yellow); }
  .dg-back__mark { opacity: 0.7; font-size: var(--text-lg); }

  .dg-scores { display: flex; gap: var(--space-2); }

  .dg-score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 62px;
    padding: 2px 8px;
    background: #1E1E1E;
    border: 1px solid var(--fuji-gray-border);
    border-radius: var(--radius-md);
  }
  .dg-score__label { font-size: 10px; color: var(--fuji-gray-muted); letter-spacing: 0.06em; }
  .dg-score__value {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--fuji-yellow);
    font-variant-numeric: tabular-nums;
  }
  .dg-score__value small { font-size: 10px; margin-left: 1px; }

  .dg-stagewrap { display: flex; justify-content: center; }

  .dg-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;   /* JSで実際の高さを入れる。これはその前の見た目 */
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--fuji-gray-border);
    background: #C8D6B4;
  }

  .dg-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
  }

  .dg-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    background: rgba(17, 17, 17, 0.84);
    z-index: 2;
  }
  .dg-overlay[hidden] { display: none; }

  .dg-card {
    width: 100%;
    max-height: 100%;
    overflow-y: auto;
    text-align: center;
  }

  .dg-logo {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    margin: 0 auto var(--space-3);
  }

  .dg-card__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--fuji-yellow);
    margin-bottom: var(--space-2);
  }
  .dg-card__lead {
    font-size: var(--text-sm);
    line-height: 1.8;
    color: #D8D5CC;
  }
  .dg-card__lead strong { color: var(--fuji-yellow); }
  .dg-card__note {
    font-size: var(--text-xs);
    color: var(--fuji-gray-muted);
  }

  /* 拾えるものの説明 */
  .dg-items {
    list-style: none;
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: left;
  }
  .dg-items li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: #E5E4DF;
  }
  .dg-items em {
    font-style: normal;
    font-weight: 400;
    font-size: 10px;
    color: var(--fuji-gray-muted);
    margin-left: auto;
  }
  .dg-chip {
    width: 26px;
    height: 26px;
    border-radius: 5px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    line-height: 1;
  }
  .dg-chip--fare  { background: #FBF0D5; border: 2px solid #8A6E1E; }
  .dg-chip--charm { background: #DCE8DE; border: 2px solid #3F6048; }
  .dg-chip--slow  { background: #DCE6F0; border: 2px solid #33465F; }
  .dg-chip--ride  { background: #FBF0D5; border: 2px solid #C8A23A; }
  .dg-chip--boost { background: #FBF0D5; border: 2px solid #8A6E1E; }
  .dg-chip--wobble { background: #F6E2D5; border: 2px solid #8A5A22; }

  /* 乗る車をえらぶ */
  .dg-pick__label {
    margin-top: var(--space-3);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--fuji-gray-muted);
  }
  .dg-cars {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }
  .dg-car {
    flex: 1;
    min-width: 0;
    padding: var(--space-2) 4px;
    background: #1E1E1E;
    border: 1px solid #3A3A3A;
    border-radius: var(--radius-md);
    font-family: inherit;
    color: #D8D5CC;
    cursor: pointer;
    text-align: center;
  }
  .dg-car[aria-pressed="true"] {
    border-color: var(--fuji-yellow);
    background: #2A2515;
  }
  .dg-car__icon { display: block; font-size: 18px; line-height: 1.2; }
  .dg-car__name { display: block; font-size: 11px; font-weight: 700; }
  .dg-car__sub { display: block; font-size: 9px; color: var(--fuji-gray-muted); line-height: 1.4; }
  .dg-car__best {
    display: block;
    margin-top: 4px;
    font-size: 9px;
    font-weight: 700;
    color: #7A5B12;
    background: #FBF0D5;
    border: 1px solid #E3CD8E;
    border-radius: var(--radius-full);
    padding: 1px 4px;
    font-variant-numeric: tabular-nums;
  }

  .dg-result {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--fuji-white);
    font-variant-numeric: tabular-nums;
    margin: var(--space-1) 0;
  }
  .dg-result small { font-size: var(--text-lg); margin-left: 2px; }

  .dg-btn {
    margin-top: var(--space-3);
    padding: 14px var(--space-8);
    border: none;
    border-radius: var(--radius-md);
    background: var(--fuji-yellow);
    color: var(--fuji-black);
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 700;
    cursor: pointer;
  }
  .dg-btn:hover:not(:disabled) { background: var(--fuji-yellow-dark); }
  .dg-btn:active:not(:disabled) { transform: scale(0.98); }
  .dg-btn:disabled {
    background: #3A3A3A;
    color: var(--fuji-gray-muted);
    cursor: not-allowed;
  }
  .dg-btn--ghost {
    background: transparent;
    border: 1px solid #3A3A3A;
    color: #E5E4DF;
  }
  .dg-btn--ghost:hover:not(:disabled) { background: transparent; border-color: var(--fuji-yellow); color: var(--fuji-yellow); }
  .dg-btn--sm { margin-top: 0; padding: 9px var(--space-4); font-size: var(--text-xs); white-space: nowrap; }

  .dg-startRow,
  .dg-overRow {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .dg-startRow .dg-btn,
  .dg-overRow .dg-btn { flex: 1; margin-top: 0; }

  /* 免許停止のお知らせ。淡い背景＋濃い文字 */
  .dg-suspend {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: #F3E2DE;
    border: 1px solid #D3AFA6;
    border-radius: var(--radius-md);
    font-size: 11px;
    line-height: 1.6;
    color: #7A3B2C;
    text-align: left;
  }
  .dg-suspend strong {
    display: block;
    font-size: var(--text-sm);
    margin-bottom: 2px;
  }
  .dg-suspend[hidden] { display: none; }

  /* ご案内（ゲームオーバー画面の下） */
  .dg-pr {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-align: left;
    margin-top: var(--space-5);
    padding: var(--space-3);
    background: #F6F3EA;
    border: 1px solid #DDD6C4;
    border-radius: var(--radius-md);
  }
  .dg-pr__logo { width: 44px; height: 44px; border-radius: var(--radius-full); flex-shrink: 0; }
  .dg-pr__body { min-width: 0; }
  .dg-pr__name { font-size: var(--text-sm); font-weight: 700; color: #2A2A2A; }
  .dg-pr__sub { font-size: 10px; color: #6B655A; line-height: 1.5; margin-top: 1px; }
  .dg-pr__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 4px;
  }
  .dg-pr__links a {
    font-size: var(--text-xs);
    font-weight: 700;
    color: #7A5B12;
    background: #FBF0D5;
    border: 1px solid #E3CD8E;
    border-radius: var(--radius-full);
    padding: 2px 10px;
    text-decoration: none;
  }
  .dg-pr__links a:hover { background: #F3E4BD; }

  /* ランキング登録フォーム（自己ベストのときだけ出る） */
  .dg-submit {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: #FBF0D5;
    border: 1px solid #E3CD8E;
    border-radius: var(--radius-md);
    text-align: left;
  }
  .dg-submit[hidden] { display: none; }
  .dg-submit__label { font-size: var(--text-xs); font-weight: 700; color: #6B4E0E; }
  .dg-submit__row { display: flex; gap: 6px; margin-top: var(--space-2); }
  .dg-submit__input {
    flex: 1;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid #D8C088;
    border-radius: var(--radius-md);
    background: #FDFBF3;
    color: #2A2A2A;
    font-family: inherit;
    font-size: var(--text-sm);
  }
  .dg-submit__input:focus { outline: 2px solid #C8A23A; outline-offset: 1px; }
  .dg-submit__msg { margin-top: 6px; font-size: 11px; color: #6B4E0E; min-height: 1.4em; }

  /* ランキング画面 */
  .dg-rankMonth {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 700;
    color: #7A5B12;
    background: #FBF0D5;
    border: 1px solid #E3CD8E;
    border-radius: var(--radius-full);
  }
  .dg-rankTabs {
    display: flex;
    gap: 6px;
    margin-top: var(--space-3);
  }
  .dg-rankTab {
    flex: 1;
    padding: 7px 4px;
    background: #1E1E1E;
    border: 1px solid #3A3A3A;
    border-radius: var(--radius-md);
    color: #D8D5CC;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  .dg-rankTab[aria-pressed="true"] { border-color: var(--fuji-yellow); background: #2A2515; color: var(--fuji-yellow); }

  .dg-rankList {
    list-style: none;
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
    max-height: 46vh;
    overflow-y: auto;
  }
  .dg-rankRow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px var(--space-2);
    background: #1E1E1E;
    border: 1px solid var(--fuji-gray-border);
    border-radius: var(--radius-md);
  }
  .dg-rankRow--me { border-color: var(--fuji-yellow); background: #2A2515; }
  .dg-rankRow__no {
    width: 20px;
    flex-shrink: 0;
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--fuji-gray-muted);
  }
  .dg-rankRow__name {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: #E5E4DF;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dg-rankRow__fare {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--fuji-yellow);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .dg-rankMsg {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fuji-gray-muted);
    text-align: center;
    min-height: 1.4em;
  }

  .dg-hint {
    font-size: var(--text-xs);
    color: var(--fuji-gray-muted);
    text-align: center;
    line-height: 1.6;
    min-height: 2.4em;
  }

  .dg-tools {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
  }
  .dg-toolbtn {
    padding: 7px 14px;
    background: transparent;
    border: 1px solid #3A3A3A;
    border-radius: var(--radius-md);
    color: #E5E4DF;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .dg-toolbtn:hover { border-color: var(--fuji-yellow); color: var(--fuji-yellow); }
</style>

<script>
  import { fetchTopScores, submitScore, normalizeNickname, currentMonthLabel, wouldEnterRanking } from '../../lib/game-scores';

  /* ============================================================
     よけろ！タクシー
     道が下へ流れてくるのを、左右の車線移動だけでよける。
     ご乗車中に片手で遊べるよう、押す場所は「画面の左半分／右半分」
     の2つしかない。
     ============================================================ */

  /* ── 世界の横幅。縦は画面の高さから決める ── */
  const W = 200;
  const ROAD_L = 46;
  const ROAD_R = 154;
  const LANES = [64, 100, 136];   // 3車線の中心
  const LANE_W = 36;

  const TAXI_W = 26;
  const TAXI_H = 40;
  const TAXI_BOTTOM = 18;         // 画面下からの距離

  const SPEED_START = 130;        // 道が流れてくる速さ（単位／秒）
  const SPEED_UP = 2.2;           // 1秒ごとに速くなる量。止まらずに上がっていく
  /* 障害物が画面に現れてからタクシーに届くまでの距離（≒画面の高さ）は
     速さが変わっても一定なので、これ以上速くすると反応できる時間が
     人（特に子ども）の限界を割ってしまう、という上限。
     最高速でも「見てから0.7〜0.8秒」は残るように選んでいる */
  const SPEED_MAX = 300;

  /* 速いほど車線移動もきびきびさせないと、操作が置いていかれる */
  const SHIFT_BASE = 170;
  /* 速くなるほど車線変更そのものも機敏にして、反応の余裕を
