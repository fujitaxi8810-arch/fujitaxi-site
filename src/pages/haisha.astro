    }
    .ha-handover .kt-btn--ghost:hover { background: rgba(14,116,144,0.1); }

    /* ── 乗務割 ── */
    /* スクロールしても見えるよう、ヘッダーの真下に貼り付ける。
       --ha-sticky-top はヘッダーの実測値をJSが入れる */
    .ha-duty-panel {
      position: sticky;
      top: var(--ha-sticky-top, 100px);
      z-index: 5;
      background: var(--fuji-black-card, #1a1a1a);
      box-shadow: 0 6px 16px rgba(0,0,0,0.45);
      /*
       * 画面高さの割合で上限を付ける（ヘッダー分を引いた残り全部、ではない）。
       * ページ先頭〜乗務割までの間にヒーロー見出しやタブがあるため、
       * 「残り全部」を許すと乗務割だけで画面がほぼ埋まり、開いた瞬間
       * 配車ボードが画面外に押し出されてしまう（実測で確認済み）。
       * 画面の半分弱に絶対制限し、超えた分は中でスクロールする。
       */
      max-height: min(46vh, 420px);
      overflow-y: auto;
      /* 貼り付いた状態への変化を分かりやすくする */
      transition: max-width 0.15s ease, margin 0.15s ease;
    }
    /*
     * 以前は summary を position:sticky; top:0 にして、内部スクロール中も
     * 見出しだけ常に見えるようにしていた。しかし .ha-duty-panel 自体が
     * ページに対して sticky（貼り付き表示）でもあるため、「ページに対して
     * sticky」「内部スクロールに対してもsticky」という二重構造になり、
     * 見出しと1行目（普通）が重なって表示される不具合になっていた
     * （ユーザー指摘のスクリーンショットで確認）。見出し固定はやめ、
     * 中身と同じ通常のフローに戻す。
     */
    /* 画面上部に貼り付いている間、他のパネルと同じ幅のまま
       枠だけ強調して「浮いている」ことが分かるようにする
       （幅を狭くする案は不採用。IntersectionObserver自体は他の用途にも使えるので残す） */
    .ha-duty-panel.is-stuck {
      border-color: rgba(245,200,0,0.35);
    }

    /* ラベル列は中身に合わせて伸ばす。固定幅だと「スクール原町」が折り返す */
    .ha-duty {
