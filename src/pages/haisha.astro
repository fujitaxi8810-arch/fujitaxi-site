---
import Layout from '../layouts/Layout.astro';
import '../styles/kt-components.css';
---

<Layout
  title="配車管理 – 富士タクシー（社内用）"
  description="富士タクシー社内用の配車管理アプリ。予約の取り込み、担当者の割り当て、日別の配車確認ができます。"
  noindex
  hideFloatCta
>

  <section class="page-hero bg-black">
    <div class="container">
      <p class="eyebrow">Staff Only</p>
      <h1>配車<span class="text-yellow">管理</span></h1>
      <p class="page-hero__lead">予約を取り込んで担当者を割り当て、日別の配車表を確認できます。このページは社内用です。</p>
    </div>
  </section>

  <section class="section bg-black" style="padding-top: 1rem;">
    <div class="container kintai-wrap ha-wrap">

      <!-- 管理者ロック（削除のみ管理者限定） -->
      <div class="kt-adminbar">
        <span class="kt-adminbar__label" id="adminState">🔒 閲覧・編集は可能／削除は管理者のみ</span>
        <!-- 65型のタッチ表示と手元のPCでは適切な文字サイズが違う。端末側からは
             視距離が分からないので、見る人が選べるようにする -->
        <div class="ha-zoom" role="group" aria-label="文字サイズ">
          <span class="ha-zoom__label">文字サイズ</span>
          <button type="button" class="ha-zoom__btn" data-zoom="100">標準</button>
          <button type="button" class="ha-zoom__btn" data-zoom="130">大</button>
          <button type="button" class="ha-zoom__btn" data-zoom="165">特大</button>
        </div>
        <button type="button" class="kt-btn kt-btn--ghost" id="adminToggleBtn">管理者ロック解除</button>
      </div>

      <!-- ログインしていないときの警告（未ログインだと参照は0件で返り、書き込みだけが失敗するため明示する） -->
      <div class="ha-authbanner" id="authBanner" hidden>
        <div>
          <strong>ログインしていません。</strong>
          <span id="authBannerMsg"></span><br />
          この状態では予約が0件と表示され、取り込みや保存も失敗します。
        </div>
        <button type="button" class="kt-btn" id="authRetryBtn">ログインする</button>
      </div>

      <!-- タブ -->
      <div class="ha-tabs">
        <button type="button" class="ha-tab is-active" id="tabBoardBtn">日別の配車ボード</button>
        <button type="button" class="ha-tab" id="tabListBtn">予約一覧</button>
      </div>

      <!-- ── 引き継ぎ（「新着」判定の基準時刻。交代した人が最初に見る想定で一番上に置く） ── -->
      <div class="ha-handover" id="handoverBar">
        <div class="ha-handover__info">
          <span class="ha-handover__label">前回の引き継ぎ</span>
          <span class="ha-handover__when" id="handoverWhen">—</span>
          <p class="ha-handover__note" id="handoverNote" hidden></p>
          <button type="button" class="ha-handover__noteedit" id="noteEditBtn">✎ 申し送りを書く</button>
        </div>
        <div class="ha-handover__actions">
          <button type="button" class="kt-btn" id="handoverBtn">引き継ぎ・申し送りを記録</button>
          <button type="button" class="kt-btn kt-btn--ghost" id="handoverUndoBtn" hidden>1つ前に戻す</button>
        </div>
      </div>

      <!-- 乗務割が画面上部に貼り付いた（stuck）状態を検知するための目印。
           これが画面外に出た＝乗務割が本来の位置を離れてヘッダー直下に固定された、
           という合図として使う（IntersectionObserverで監視） -->
      <div id="dutyStickySentinel"></div>

      <!-- ── 乗務割（/shift の内容を読むだけ。編集は /shift 側）
           スクロールしても見えるよう固定。邪魔なときは畳める。
           既定は閉じておく：開いたままページ最上部にいると、その手前の
           見出し・管理者バー・タブだけで画面の大半を使ってしまい、
           下の配車ボードが完全に画面外へ押し出されるため（実測で確認済み） ── -->
      <details class="kt-panel ha-details ha-duty-panel" id="dutyPanel">
        <summary class="ha-details__summary">
          <span class="kt-title" id="dutyTitle">乗務割</span>
          <span class="ha-details__hint">クリックで開く</span>
        </summary>
        <div class="ha-details__body">
          <div class="kt-panel__tools">
            <a href="/shift" class="kt-btn kt-btn--ghost" target="_blank" rel="noopener">シフトを編集</a>
          </div>
          <div id="dutyBody" class="ha-duty"></div>
          <p class="ha-note ha-duty-legend" id="dutyNote"></p>
        </div>
      </details>

      <!-- ── ① 日別の配車ボード ── -->
      <div class="kt-panel" id="boardPanel">
        <div class="kt-panel__head">
          <h2 class="kt-title" id="boardTitle">配車ボード</h2>
          <div class="kt-panel__tools">
            <button type="button" class="kt-btn kt-btn--ghost" id="prevDayBtn">◀</button>
            <input type="date" id="datePick" class="kt-input" />
            <button type="button" class="kt-btn kt-btn--ghost" id="nextDayBtn">▶</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="todayBtn">今日</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="showPastBtn" hidden>経過分も表示</button>
            <button type="button" class="kt-btn" id="printBtn">印刷</button>
          </div>
        </div>

        <p class="ha-legend" id="boardSummary"></p>

        <div class="kt-table-wrap ha-grid-wrap">
          <table class="kt-table ha-grid" id="boardTable"></table>
        </div>
        <p class="kt-empty" id="boardEmpty" hidden>この日の予約はありません。</p>
      </div>

      <!-- ── ② 予約一覧 ── -->
      <div class="kt-panel" id="listPanel" hidden>
        <div class="kt-panel__head">
          <h2 class="kt-title">予約一覧</h2>
          <div class="kt-panel__tools">
            <button type="button" class="kt-btn" id="importBtn">CSVを取り込む</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="newBtn">＋ 新規予約</button>
          </div>
        </div>

        <div class="ha-filters">
          <label class="ha-field">
            <span>開始日</span>
            <input type="date" id="fromPick" class="kt-input" />
          </label>
          <label class="ha-field">
            <span>終了日</span>
            <input type="date" id="toPick" class="kt-input" />
          </label>
          <label class="ha-field ha-field--grow">
            <span>検索（お客様名・電話・場所）</span>
            <input type="search" id="searchInput" class="kt-input" placeholder="例：菅野 / 9067 / 病院" />
          </label>
          <button type="button" class="kt-btn kt-btn--ghost" id="reloadBtn">再読み込み</button>
        </div>

        <p class="ha-legend" id="listSummary"></p>

        <div class="kt-table-wrap ha-grid-wrap">
          <table class="kt-table ha-grid" id="listTable"></table>
        </div>
        <p class="kt-empty" id="listEmpty" hidden>該当する予約はありません。</p>
      </div>

      <!-- ── 変更履歴（DBトリガーが自動記録。普段は畳んでおく） ── -->
      <details class="kt-panel ha-details" id="historyPanel">
        <summary class="ha-details__summary">
          <span class="kt-title">変更履歴</span>
          <span class="ha-details__hint">クリックで開く</span>
        </summary>
        <div class="ha-details__body">
          <div class="kt-panel__tools">
            <button type="button" class="kt-btn kt-btn--ghost" id="historyReloadBtn">更新</button>
          </div>
          <p class="ha-note">
            予約の追加・変更・削除を新しい順に最大100件表示します。「元に戻す」で変更前の状態に戻せます。<br />
            CSVの取り込みで<strong>中身が変わらなかった行は記録されません</strong>（毎回100件流れてしまうため）。
          </p>
          <div id="historyBody"></div>
        </div>
      </details>

      <!-- ── 配車担当者の設定（管理者のみ） ── -->
      <div class="kt-panel" id="staffAdminPanel" hidden>
        <div class="kt-panel__head">
          <h2 class="kt-title">配車に関わる人の設定（管理者）</h2>
        </div>
        <p class="ha-note">
          チェックを入れた人が、<strong>乗務割と担当者の選択肢</strong>に出ます。
          事務職の方など配車に乗らない人は外してください（シフトに入っていても乗務割に出なくなります）。<br />
          外しても、<strong>すでに割り当て済みの予約はそのまま残ります</strong>。<br />
          ここに名前が無い人は、まだスタッフ登録されていません。<a href="/kintai" target="_blank" rel="noopener">勤怠ページ</a>で登録してください。
        </p>
        <div id="staffAdminBody" class="ha-assign-grid"></div>
      </div>

    </div>
  </section>

  <!-- ── 予約の編集モーダル ── -->
  <div class="kt-modal-overlay" id="editModal" hidden>
    <div class="kt-modal ha-modal" role="dialog" aria-modal="true" aria-labelledby="editTitle">
      <h2 class="kt-title" id="editTitle">予約の編集</h2>

      <div class="ha-form">
        <label class="ha-field"><span>予約日時 *</span><input type="datetime-local" id="fReservedAt" class="kt-input" /></label>
        <label class="ha-field"><span>お客様名 *</span><input type="text" id="fCustomerName" class="kt-input" /></label>
        <label class="ha-field"><span>読み</span><input type="text" id="fCustomerKana" class="kt-input" /></label>
        <label class="ha-field"><span>電話番号</span><input type="tel" id="fPhone" class="kt-input" /></label>
        <label class="ha-field"><span>アラーム(分前)</span><input type="number" id="fAlarm" class="kt-input" min="0" step="5" /></label>
        <label class="ha-field"><span>担当者</span><span id="fStaffWrap"></span></label>
        <label class="ha-field"><span>状態</span><span id="fStatusWrap"></span></label>
        <label class="ha-field ha-field--full"><span>迎車場所名</span><input type="text" id="fPickupName" class="kt-input" /></label>
        <label class="ha-field ha-field--full"><span>迎車住所</span><input type="text" id="fPickupAddress" class="kt-input" /></label>
        <label class="ha-field ha-field--full"><span>場所メモ</span><input type="text" id="fPickupMemo" class="kt-input" /></label>
        <label class="ha-field ha-field--full"><span>降車場所名</span><input type="text" id="fDropoffName" class="kt-input" /></label>
        <label class="ha-field ha-field--full"><span>降車住所</span><input type="text" id="fDropoffAddress" class="kt-input" /></label>
        <label class="ha-field ha-field--full"><span>オペレーター用メモ（行き先など）</span><textarea id="fOperatorMemo" class="kt-input" rows="3"></textarea></label>
        <label class="ha-field ha-field--full"><span>アプリ側の申し送り</span><textarea id="fAppMemo" class="kt-input" rows="2"></textarea></label>
      </div>

      <p class="ha-note" id="editSourceNote"></p>

      <div class="kt-modal__actions">
        <button type="button" class="kt-btn" id="editSaveBtn">保存</button>
        <button type="button" class="kt-btn kt-btn--danger" id="editDeleteBtn" hidden>削除（管理者）</button>
        <button type="button" class="kt-btn kt-btn--ghost" id="editCancelBtn">キャンセル</button>
      </div>
    </div>
  </div>

  <!-- ── 引き継ぎモーダル ── -->
  <div class="kt-modal-overlay" id="handoverModal" hidden>
    <div class="kt-modal ha-modal" role="dialog" aria-modal="true" aria-labelledby="handoverTitle">
      <h2 class="kt-title" id="handoverTitle">引き継ぎと申し送り</h2>
      <p class="ha-note">
        ここまでに入った予約の「新着」表示を消し、<strong>これ以降に入った予約を新着として表示</strong>します。<br />
        全員の画面に反映されます。押し間違えたときは「1つ前に戻す」で取り消せます。
      </p>

      <div class="ha-field ha-field--full">
        <span>引き継ぐ人（任意）</span>
        <input type="text" id="hoBy" class="kt-input" placeholder="例：佐藤" />
      </div>
      <div class="ha-field ha-field--full">
        <span>申し送り ― 次の担当者に伝えること（任意）</span>
        <textarea id="hoNote" class="kt-input" rows="3" placeholder="例：中村様の予約は折り返し待ち。19時までに連絡がなければキャンセル"></textarea>
      </div>

      <div class="kt-modal__actions">
        <button type="button" class="kt-btn" id="hoConfirmBtn">確定する</button>
        <button type="button" class="kt-btn kt-btn--ghost" id="hoCancelBtn">やめる</button>
      </div>
    </div>
  </div>

  <!-- ── 申し送りモーダル（引き継ぎとは別。新着の基準を動かさない） ── -->
  <div class="kt-modal-overlay" id="noteModal" hidden>
    <div class="kt-modal ha-modal" role="dialog" aria-modal="true" aria-labelledby="noteModalTitle">
      <h2 class="kt-title" id="noteModalTitle">申し送り</h2>
      <p class="ha-note">
        次の担当者に伝えることを書きます。<strong>「新着」の表示は消えません</strong>
        ―引き継ぎの記録とは別なので、何度でも書き足せます。
      </p>

      <div class="ha-field ha-field--full">
        <span>申し送り</span>
        <textarea id="noteText" class="kt-input" rows="4" placeholder="例：中村様の予約は折り返し待ち。19時までに連絡がなければキャンセル"></textarea>
      </div>

      <div class="kt-modal__actions">
        <button type="button" class="kt-btn" id="noteSaveBtn">保存</button>
        <button type="button" class="kt-btn kt-btn--ghost" id="noteCancelBtn">やめる</button>
      </div>
    </div>
  </div>

  <!-- ── CSV取り込みモーダル ── -->
  <div class="kt-modal-overlay" id="importModal" hidden>
    <div class="kt-modal ha-modal" role="dialog" aria-modal="true" aria-labelledby="importTitle">
      <h2 class="kt-title" id="importTitle">CSVの取り込み</h2>

      <p class="ha-note">
        配車システム「DS」から書き出したCSVファイルを選ぶか、スプレッドシート「配車確認表」を
        <strong>ヘッダー行ごと</strong>コピーして下の欄に貼り付けてください。<br />
        すでに取り込んだ予約は<strong>上書き更新</strong>されます。割り当て済みの担当者・チェック・申し送りは消えません。
      </p>

      <div class="ha-field ha-field--full">
        <span>CSVファイルを選ぶ</span>
        <input type="file" id="importFile" class="kt-input" accept=".csv,.txt,text/csv,text/plain" />
      </div>

      <div class="ha-field ha-field--full">
        <span>または貼り付け</span>
        <textarea id="importText" class="kt-input ha-import-text" rows="6" placeholder="予約日時	アラーム(分前)	事業所名	お客様名 ..."></textarea>
      </div>

      <div id="importPreview" class="ha-preview" hidden></div>

      <div class="kt-modal__actions">
        <button type="button" class="kt-btn kt-btn--ghost" id="importParseBtn">内容を確認する</button>
        <button type="button" class="kt-btn" id="importApplyBtn" disabled>取り込む</button>
        <button type="button" class="kt-btn kt-btn--ghost" id="importCancelBtn">閉じる</button>
      </div>
    </div>
  </div>

  <script>
    import {
      initAuth, isAdmin, signInAdmin, signOutToKiosk, fetchStaff,
      fetchReservationsByDate, fetchReservationsRange, fetchShiftsByDate,
      fetchDailyDuties, addDailyDuty, removeDailyDuty,
      insertReservation, updateReservation, deleteReservation,
      assignStaff, setChecked, setStatus, setStaffAssignable,
      fetchLatestHandover, recordHandover, deleteHandover, updateHandoverNote,
      fetchDispatchHistory, revertHistoryEntry,
      buildImportPlan, applyImportPlan,
      jstDateKey, jstTimeLabel, todayJst,
      hasSession, isAuthError,
    } from '../lib/haisha-db';
    import { parseReservationCsv, decodeCsvBuffer } from '../lib/haisha-csv';

    /**
     * 失敗の理由に応じた案内を返す。
     * ログイン切れに「電波状況を確認してください」と出しても永久に直らないため、必ず区別する。
     */
    function failMsg(e: any, what = '保存') {
      if (isAuthError(e)) {
        showLoggedOut('ログインの有効期限が切れた可能性があります。');
        return `${what}できませんでした。ログインし直してください。`;
      }
      return `${what}に失敗しました。電波状況を確認して、もう一度お試しください。`;
    }
    // 入力要素の .value / .disabled を直接触るため any で受ける
    const $ = (id: string): any => document.getElementById(id);

    let staff: any[] = [];
    let boardRows: any[] = [];
    let listRows: any[] = [];
    let dutyRows: any[] = [];
    let dailyDutyRows: any[] = [];
    let latestHandover: any = null;
    let historyRows: any[] = [];
    let editing: any = null;      // 編集中の予約（新規はnull）
    let importPlan: any = null;

    // ── 日付ユーティリティ ──
    const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];

    function shiftDate(dateKey: string, days: number) {
      const d = new Date(`${dateKey}T00:00:00+09:00`);
      d.setUTCDate(d.getUTCDate() + days);
      return jstDateKey(d.toISOString());
    }

    /**
     * dateKey（'YYYY-MM-DD'）そのものの曜日を返す。
     *
     * 以前は `new Date(dateKey+'T00:00:00+09:00').getUTCDay()` としていたが、
     * これは「JST午前0時」をUTCのタイムスタンプに変換した上でUTC基準の曜日を
     * 取っていたことになり、JST00:00はUTC前日15:00なので**曜日が1日ずれる**
     * バグがあった（8/6[木] が「水」と表示される）。
     * dateKeyの年月日をそのままUTCの日付として組み立て、その曜日を取れば、
     * 実行環境やブラウザのタイムゾーン設定に関係なく常に正しい。
     */
    function weekdayOf(dateKey: string) {
      const [y, m, d] = dateKey.split('-').map(Number);
      return WEEKDAYS[new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
    }

    /** ISO → datetime-localの値（JST） */
    function toLocalInput(iso: string) {
      return `${jstDateKey(iso)}T${jstTimeLabel(iso)}`;
    }

    /** datetime-localの値（JST前提） → ISO */
    function fromLocalInput(v: string) {
      if (!v) return null;
      const d = new Date(`${v}:00+09:00`);
      return Number.isNaN(d.getTime()) ? null : d.toISOString();
    }

    // ── スタッフごとの色 ──
    // 配車確認シートと同じく、人ごとに固有の色を持たせる。
    // 勤務欄の名前と、配車ボードの担当者欄で同じ色になるので、
    // 「今日の普通番は誰か」と「この予約は誰に割り当てたか」を色で照合できる。
    // 淡い背景＋濃い文字（高彩度のベタ塗りは使わない）。
    const STAFF_COLORS = [
      { bg: '#eff6ff', fg: '#1d4ed8' }, { bg: '#fef2f2', fg: '#b91c1c' },
      { bg: '#f0fdf4', fg: '#15803d' }, { bg: '#fffbeb', fg: '#92400e' },
      { bg: '#f5f3ff', fg: '#6d28d9' }, { bg: '#ecfeff', fg: '#0e7490' },
      { bg: '#fdf2f8', fg: '#be185d' }, { bg: '#f7fee7', fg: '#4d7c0f' },
      { bg: '#eef2ff', fg: '#4338ca' }, { bg: '#fff7ed', fg: '#c2410c' },
      { bg: '#f0fdfa', fg: '#115e59' }, { bg: '#fef3c7', fg: '#a16207' },
      { bg: '#faf5ff', fg: '#a21caf' }, { bg: '#f1f5f9', fg: '#334155' },
      { bg: '#fef7ed', fg: '#b45309' }, { bg: '#eceff1', fg: '#37474f' },
    ];

    let staffColorMap = new Map();

    /** 表示順で色を配る。隣り合う人が必ず別の色になるようにするため、ハッシュではなく順番で決める */
    function rebuildStaffColors() {
      const sorted = [...staff].sort((a, b) =>
        (a.shiftDisplayOrder ?? a.displayOrder) - (b.shiftDisplayOrder ?? b.displayOrder));
      staffColorMap = new Map(sorted.map((s, i) => [s.id, STAFF_COLORS[i % STAFF_COLORS.length]]));
    }

    /** 要素にその人の色を当てる。未割当なら既定の見た目に戻す */
    function applyStaffColor(el: HTMLElement, staffId: string | null) {
      const c = staffId ? staffColorMap.get(staffId) : null;
      if (c) {
        el.style.background = c.bg;
        el.style.color = c.fg;
        el.style.borderColor = c.fg;
      } else {
        el.style.background = '';
        el.style.color = '';
        el.style.borderColor = '';
      }
    }

    // ── 担当者セレクト ──
    const STAFF_GROUPS = [
      { key: null, label: '乗務員' },
      { key: 'jumbo', label: 'ジャンボ' },
      { key: 'office', label: '事務' },
      { key: 'maintenance', label: '整備' },
    ];

    /**
     * 担当者の候補。staff.haisha_assignable が false の人は外す。
     * 誰を外すかはDBで管理する（コードに氏名を書くと、異体字や表記ゆれで壊れるため）。
     * ただし既に割り当て済みの人は、対象外になっていても選択肢に残す
     * （そうしないと選択が空欄になり、保存し直したときに割り当てが消えてしまう）。
     */
    function assignableStaff(keepId?: string | null) {
      return staff.filter((s) => s.haishaAssignable !== false || (keepId && s.id === keepId));
    }

    function buildStaffSelect(selectedId?: string | null) {
      const sel = document.createElement('select');
      sel.className = 'ha-select';

      const blank = document.createElement('option');
      blank.value = '';
      blank.textContent = '— 未割当 —';
      sel.appendChild(blank);

      for (const g of STAFF_GROUPS) {
        const members = assignableStaff(selectedId)
          .filter((s) => (s.shiftGroup ?? null) === g.key)
          .sort((a, b) => (a.shiftDisplayOrder ?? a.displayOrder) - (b.shiftDisplayOrder ?? b.displayOrder));
        if (members.length === 0) continue;
        const og = document.createElement('optgroup');
        og.label = g.label;
        for (const m of members) {
          const o = document.createElement('option');
          o.value = m.id;
          o.textContent = m.name;
          og.appendChild(o);
        }
        sel.appendChild(og);
      }

      sel.value = selectedId || '';
      applyStaffColor(sel, sel.value || null);
      return sel;
    }

    function staffName(staffId: string | null) {
      if (!staffId) return '';
      const s = staff.find((x) => x.id === staffId);
      return s ? s.name : '（退職者）';
    }

    // ── ログイン状態の表示 ──
    // 未ログインでも参照は「0件」で返ってしまうので、画面に明示しないと
    // 「予約が無い」のか「ログインできていない」のか区別がつかない。
    function showLoggedOut(reason = '') {
      $('authBannerMsg').textContent = reason;
      $('authBanner').hidden = false;
      $('importBtn').disabled = true;
      $('newBtn').disabled = true;
    }

    function clearLoggedOut() {
      $('authBanner').hidden = true;
      $('importBtn').disabled = false;
      $('newBtn').disabled = false;
    }

    $('authRetryBtn').onclick = async () => {
      const result = await initAuth();
      if (!result.ok) {
        alert(result.error || 'ログインできませんでした。');
        return;
      }
      clearLoggedOut();
      try {
        staff = await fetchStaff();
        rebuildStaffColors();
      } catch (e) { /* 表示は続行する */ }
      renderAdminBar();
      await refreshCurrentTab();
    };

    // ── 管理者バー ──
    function renderAdminBar() {
      const unlocked = isAdmin();
      $('adminState').textContent = unlocked
        ? '🔓 管理者：削除もできます'
        : '🔒 閲覧・編集は可能／削除は管理者のみ';
      $('adminToggleBtn').textContent = unlocked ? 'ロックする' : '管理者ロック解除';
      $('staffAdminPanel').hidden = !unlocked;
      if (unlocked) renderStaffAdmin();
    }

    // ── 配車担当者の設定（管理者のみ） ──
    // 誰を担当者候補に出すかをこの画面で切り替える。
    // 氏名ではなく id で更新するので、異体字や同姓の取り違えが起きない。
    const GROUP_LABELS = { null: '乗務員', jumbo: 'ジャンボ', office: '事務', maintenance: '整備' };

    function renderStaffAdmin() {
      const body = $('staffAdminBody');
      body.innerHTML = '';

      const sorted = [...staff].sort((a, b) =>
        (a.shiftDisplayOrder ?? a.displayOrder) - (b.shiftDisplayOrder ?? b.displayOrder));

      for (const s of sorted) {
        const label = document.createElement('label');
        label.className = 'ha-assign-item';

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'ha-check';
        cb.checked = s.haishaAssignable !== false;
        cb.onchange = async () => {
          const next = cb.checked;
          cb.disabled = true;
          try {
            await setStaffAssignable(s.id, next);
            s.haishaAssignable = next;
            // 担当者セレクトの中身が変わるので、表示中の画面を作り直す
            if (!$('boardPanel').hidden) renderBoard();
            else renderList();
            renderDuty();
          } catch (e) {
            alert(isAuthError(e)
              ? '変更できませんでした。管理者としてログインし直してください。'
              : '変更に失敗しました。電波状況を確認して、もう一度お試しください。');
            cb.checked = !next;
          } finally {
            cb.disabled = false;
          }
        };
        label.appendChild(cb);

        // 管理画面でも本人の色を出して、どの色が誰かを確認できるようにする
        const name = document.createElement('span');
        name.className = 'ha-badge ha-assign-name';
        applyStaffColor(name, s.id);
        name.textContent = s.name;
        label.appendChild(name);

        const grp = document.createElement('span');
        grp.className = 'ha-assign-group';
        grp.textContent = GROUP_LABELS[String(s.shiftGroup)] ?? '乗務員';
        label.appendChild(grp);

        body.appendChild(label);
      }
    }

    async function requireAdmin() {
      if (isAdmin()) return true;
      const email = prompt('管理者アカウントのメールアドレスを入力してください。', 'admin@fujitaxi.local');
      if (!email) return false;
      const password = prompt('管理者パスワードを入力してください。');
      if (!password) return false;
      const result = await signInAdmin(email.trim(), password);
      if (!result.ok) {
        alert(result.error || 'ログインに失敗しました。');
        return false;
      }
      return true;
    }

    $('adminToggleBtn').onclick = async () => {
      if (isAdmin()) await signOutToKiosk();
      else await requireAdmin();
      renderAdminBar();
    };

    // ── タブ ──
    function showTab(which: string) {
      const board = which === 'board';
      $('boardPanel').hidden = !board;
      $('dutyPanel').hidden = !board;
      $('handoverBar').hidden = !board;
      $('historyPanel').hidden = !board;
      $('listPanel').hidden = board;
      $('tabBoardBtn').classList.toggle('is-active', board);
      $('tabListBtn').classList.toggle('is-active', !board);
      if (!board) loadList();
    }
    $('tabBoardBtn').onclick = () => showTab('board');
    $('tabListBtn').onclick = () => showTab('list');

    // ── 共通のセル生成 ──
    function td(text: string | null | undefined, className = '') {
      const cell = document.createElement('td');
      if (className) cell.className = className;
      cell.textContent = text ?? '';
      return cell;
    }

    function headerRow(labels: string[]) {
      const thead = document.createElement('thead');
      const tr = document.createElement('tr');
      for (const l of labels) {
        const th = document.createElement('th');
        th.textContent = l;
        if (l === '時刻' || l === '予約日時') th.className = 'ha-sticky';
        tr.appendChild(th);
      }
      thead.appendChild(tr);
      return thead;
    }

    // ── 引き継ぎ後の新着 ──
    // 事務所終了後などに配車担当者が交代した際、それ以降に入った予約に印を付ける。
    // 基準は「引き継ぎ・申し送りを記録」を押した時刻（固定時刻ではない）。
    // 固定時刻を基準にしていた頃は、昼間に見ると前日の基準時刻が採用され、
    // その日の朝に入った予約まで新着扱いになる問題があった。

    /** DSでの登録時刻。手入力の予約はDBに入った時刻で代用する */
    function addedAt(r: any) {
      return r.registeredAt || r.createdAt || null;
    }

    // 引き継ぎボタンの押し忘れに備えた自動判定。
    // 事務所は19時で終了し、以降は担当者が交代する。
    const AUTO_HANDOVER_HOUR = 19;
    // 自動判定を効かせる時間の長さ（19時から翌9時までの夜勤帯）。
    //
    // この「窓」がこの機能の肝。以前は窓を設けず「直近に過ぎた19時」を
    // 無条件に基準にしていたため、昼14時に画面を見ると基準が前日19時になり、
    // その日の朝に入った予約まで新着扱いになってしまった（ユーザー指摘で発覚）。
    // 窓を設けると、昼間は自動基準が外れて誤検知が起きない。
    const AUTO_HANDOVER_WINDOW_HOURS = 14;

    /**
     * 直近に過ぎた19:00（JST）。ただし夜勤帯を過ぎていたら null。
     * 例：19時→当日19時 ／ 深夜2時→前日19時 ／ 昼14時→null（前日19時は19時間前で窓の外）
     */
    function autoHandoverTime(now = Date.now()): number | null {
      const jst = new Date(now + 9 * 3600 * 1000);
      let boundary = Date.UTC(
        jst.getUTCFullYear(), jst.getUTCMonth(), jst.getUTCDate(), AUTO_HANDOVER_HOUR
      ) - 9 * 3600 * 1000;
      if (boundary > now) boundary -= 24 * 3600 * 1000; // まだ19時前なら前日の19時
      const ageHours = (now - boundary) / 3600000;
      return ageHours <= AUTO_HANDOVER_WINDOW_HOURS ? boundary : null;
    }

    /**
     * 「新着」の基準時刻。手動の引き継ぎ記録と、19時の自動判定の
     * **新しい方**を使う。
     *
     * 手動を優先しないのは、押し忘れ防止のため。逆に自動を優先しないのは、
     * 19時より後に手で押し直したとき（例：20時に実際に交代）に、
     * その操作が無視されてしまわないようにするため。
     */
    function newBaselineTime(): number | null {
      const manual = latestHandover?.handedOverAt ? new Date(latestHandover.handedOverAt).getTime() : null;
      const auto = autoHandoverTime();
      if (manual === null) return auto;
      if (auto === null) return manual;
      return Math.max(manual, auto);
    }

    /** 今の基準が自動判定によるものか（画面の説明文の出し分けに使う） */
    function baselineIsAuto(): boolean {
      const base = newBaselineTime();
      const auto = autoHandoverTime();
      return base !== null && auto !== null && base === auto;
    }

    function isNewSinceHandover(r: any) {
      const base = newBaselineTime();
      if (base === null) return false;
      const t = addedAt(r);
      return t ? new Date(t).getTime() >= base : false;
    }

    // ── 引き継ぎ ──
    const HANDOVER_NAME_KEY = 'fuji-haisha-handover-name';

    function renderHandover() {
      const when = $('handoverWhen');
      const noteEl = $('handoverNote');

      const auto = autoHandoverTime();

      if (!latestHandover) {
        when.textContent = auto !== null
          // 押し忘れていても19時の自動判定が効いている状態
          ? `${AUTO_HANDOVER_HOUR}時（自動）以降が新着　※記録を押すとその時刻が基準になります`
          : 'まだありません（記録すると、それ以降の予約に「新着」が付きます）';
        // 申し送りの置き場所が分かるよう、まだ無くても枠は出しておく
        noteEl.hidden = false;
        noteEl.className = 'ha-handover__note ha-handover__note--empty';
        noteEl.textContent = '申し送りはまだありません。';
        $('noteEditBtn').textContent = '✎ 申し送りを書く';
        $('handoverUndoBtn').hidden = true;
        return;
      }

      const t = latestHandover.handedOverAt;
      const who = latestHandover.handedOverBy ? `（${latestHandover.handedOverBy}）` : '';
      when.textContent = baselineIsAuto()
        // 記録はあるが、それより後に19時を過ぎている（前日の記録が残っている等）
        ? `${AUTO_HANDOVER_HOUR}時（自動）以降が新着　`
          + `※前回の記録は ${jstDateKey(t).slice(5).replace('-', '/')} ${jstTimeLabel(t)}${who}`
        : `${jstDateKey(t).slice(5).replace('-', '/')} ${jstTimeLabel(t)}${who} 以降が新着`;

      noteEl.hidden = false;
      if (latestHandover.note) {
        noteEl.className = 'ha-handover__note';
        noteEl.textContent = `申し送り：${latestHandover.note}`;
        $('noteEditBtn').textContent = '✎ 申し送りを編集';
      } else {
        noteEl.className = 'ha-handover__note ha-handover__note--empty';
        noteEl.textContent = '申し送りなし';
        $('noteEditBtn').textContent = '✎ 申し送りを書く';
      }
      $('handoverUndoBtn').hidden = false;
    }

    // 申し送りだけを書き換える。引き継ぎの記録時刻は触らないので新着は消えない
    $('noteEditBtn').onclick = () => {
      $('noteText').value = latestHandover?.note || '';
      $('noteModal').hidden = false;
      $('noteText').focus();
    };
    $('noteCancelBtn').onclick = () => { $('noteModal').hidden = true; };
    $('noteModal').onclick = (e) => { if (e.target === $('noteModal')) $('noteCancelBtn').click(); };

    $('noteSaveBtn').onclick = async () => {
      const note = $('noteText').value.trim() || null;
      $('noteSaveBtn').disabled = true;
      try {
        if (latestHandover) {
          await updateHandoverNote(latestHandover.id, note);
          latestHandover = { ...latestHandover, note };
        } else {
          // まだ引き継ぎ記録が無い場合は、この時点を基準として作る。
          // 過去の時刻にすると、申し送りを書いただけで既存の予約に
          // 新着が一斉に付いてしまうため。
          latestHandover = await recordHandover(null, note);
        }
        $('noteModal').hidden = true;
        renderHandover();
      } catch (e) {
        alert(failMsg(e, '申し送りの保存'));
      } finally {
        $('noteSaveBtn').disabled = false;
      }
    };

    $('handoverBtn').onclick = () => {
      $('hoBy').value = localStorage.getItem(HANDOVER_NAME_KEY) || '';
      $('hoNote').value = '';
      $('handoverModal').hidden = false;
      $('hoBy').focus();
    };
    $('hoCancelBtn').onclick = () => { $('handoverModal').hidden = true; };
    $('handoverModal').onclick = (e) => { if (e.target === $('handoverModal')) $('hoCancelBtn').click(); };

    $('hoConfirmBtn').onclick = async () => {
      const by = $('hoBy').value.trim();
      const note = $('hoNote').value.trim();
      $('hoConfirmBtn').disabled = true;
      try {
        latestHandover = await recordHandover(by || null, note || null);
        if (by) localStorage.setItem(HANDOVER_NAME_KEY, by);
        $('handoverModal').hidden = true;
        renderHandover();
        renderBoard();
      } catch (e) {
        alert(failMsg(e, '引き継ぎの記録'));
      } finally {
        $('hoConfirmBtn').disabled = false;
      }
    };

    $('handoverUndoBtn').onclick = async () => {
      if (!latestHandover) return;
      if (!confirm('直前の引き継ぎ記録を取り消します。ひとつ前の引き継ぎが基準に戻ります。よろしいですか？')) return;
      try {
        await deleteHandover(latestHandover.id);
        latestHandover = await fetchLatestHandover();
        renderHandover();
        renderBoard();
      } catch (e) {
        alert(failMsg(e, '引き継ぎの取り消し'));
      }
    };

    /** 「8/5 19:23」形式。新着バッジの説明に使う */
    function addedLabel(r: any) {
      const t = addedAt(r);
      if (!t) return '登録日時 不明';
      return `登録 ${jstDateKey(t).slice(5).replace('-', '/')} ${jstTimeLabel(t)}`;
    }

    /** 新着の説明文（いつ入った予約で、何を基準に新着なのか）。ツールチップに使う */
    function newBadgeTitle(r: any) {
      // 基準は「手動の記録」か「19時の自動判定」の新しい方。実際に使われた時刻を出す
      const base = newBaselineTime();
      if (base === null) return addedLabel(r);
      const baseIso = new Date(base).toISOString();
      return `${addedLabel(r)}（${jstDateKey(baseIso).slice(5).replace('-', '/')} `
        + `${jstTimeLabel(baseIso)}${baselineIsAuto() ? '（自動）' : 'の引き継ぎ'}以降）`;
    }

    /** 迎車場所の表示文字列（場所名＋住所を1セルにまとめる） */
    function pickupText(r: any) {
      const parts = [r.pickupName, r.pickupAddress].filter(Boolean);
      return parts.join(' / ');
    }

    // ── 状態（通常／変更あり／キャンセル） ──
    // DS側の変更・取り消しは自動判定せず、人がここで指定する。
    // アプリ側の列なのでCSVを取り込み直しても消えない。
    const STATUS_KEYS = ['normal', 'changed', 'cancelled'];
    const STATUS_LABELS = { normal: '通常', changed: '変更あり', cancelled: 'キャンセル' };

    /**
     * 状態のセレクト。
     *
     * isNew（引き継ぎ以降に入った予約）のときは「通常」を **「新着」と表記**する。
     * 値は 'normal' のままで、新着はDBに持たない“導出値”のまま扱う
     * （引き継ぎを記録すれば自然に消える。人が消す操作は要らない）。
     *
     * 新着の予約に「変更あり」「キャンセル」を付けると、この欄からは新着の
     * 表記が消えるが、行左端の青緑の縦線（.ha-row--new）は残るので
     * 「引き継ぎ後に入ったもの」だと分かる。
     */
    function buildStatusSelect(current: string, isNew = false) {
      const sel = document.createElement('select');
      const showAsNew = isNew && current === 'normal';
      sel.className = `ha-select ha-status ha-status--${showAsNew ? 'new' : current}`;
      for (const key of STATUS_KEYS) {
        const o = document.createElement('option');
        o.value = key;
        o.textContent = key === 'normal' && isNew ? '新着' : STATUS_LABELS[key];
        sel.appendChild(o);
      }
      sel.value = current;
      return sel;
    }

    /** 行の見た目を状態に合わせる。キャンセル済みは未割当扱いにしない */
    function applyRowStatus(tr: HTMLElement, r: any) {
      tr.classList.toggle('ha-row--cancelled', r.status === 'cancelled');
      tr.classList.toggle('ha-row--changed', r.status === 'changed');
      tr.classList.toggle('ha-row--unassigned', !r.staffId && r.status !== 'cancelled');
    }

    // ── この日の勤務（/shift から読むだけ） ──
    // 配車確認シート上部の勤務区分に対応する。記号の対応はユーザー確認済み。
    // 「スクール原町」「交流」「乗合」は /shift に該当記号が無いため未対応。
    // 配車確認シートの並び順に合わせる。
    // shiftKey … /shift のコードから引く（表示のみ。変更は /shift 側）
    // dailyKey … この画面で日ごとに足す分（×で外せる）
    // 貸切は両方持つ：基本はシフト通りだが、当日変わることがあるため追加もできる
    const DUTY_GROUPS: { label: string; shiftKey?: string; dailyKey?: DutyCat }[] = [
      { label: '普通', shiftKey: '①' },
      { label: '遅番', shiftKey: '③' },
      { label: 'スクール', shiftKey: 'S' },
      { label: 'スクール原町', dailyKey: 'school_haramachi' },
      { label: '交流', dailyKey: 'exchange' },
      { label: '貸切', shiftKey: '貸切', dailyKey: 'charter' },
      { label: '乗合', shiftKey: 'SH' },
    ];

    type DutyCat = 'school_haramachi' | 'exchange' | 'charter';

    function dutyDateKey() {
      return $('datePick').value || todayJst();
    }

    function sortByShiftOrder(list: any[]) {
      return list.sort((a, b) =>
        (a.staff.shiftDisplayOrder ?? a.staff.displayOrder) - (b.staff.shiftDisplayOrder ?? b.staff.displayOrder));
    }

    /** 名前バッジ。日次割り当ての行では×で外せる */
    function dutyBadge(st: any, opts: { phoneDuty?: boolean; onRemove?: () => void }) {
      const b = document.createElement('span');
      b.className = 'ha-badge ha-duty-name';
      applyStaffColor(b, st.id);
      b.appendChild(document.createTextNode(st.name));
      if (opts.phoneDuty) {
        const p = document.createElement('span');
        p.className = 'ha-duty-phone';
        p.textContent = '電';
        p.title = '電話番';
        b.appendChild(p);
      }
      if (opts.onRemove) {
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'ha-duty-remove';
        x.textContent = '×';
        x.title = '外す';
        x.onclick = opts.onRemove;
        b.appendChild(x);
      }
      return b;
    }

    function renderDuty() {
      const body = $('dutyBody');
      body.innerHTML = '';
      const dateKey = dutyDateKey();

      const byCode = new Map();
      for (const d of dutyRows) {
        if (!byCode.has(d.code)) byCode.set(d.code, []);
        byCode.get(d.code).push(d);
      }

      // ラベルと名前を同じグリッドに直接入れる。行ごとにdivで囲むと、
      // 区分名の長さ（「スクール原町」など）で列幅がずれるため。
      let shiftShown = 0;
      for (const g of DUTY_GROUPS) {
        const label = document.createElement('span');
        label.className = 'ha-duty-label';
        label.textContent = g.label;
        body.appendChild(label);

        const names = document.createElement('span');
        names.className = 'ha-duty-names';

        // /shift 由来（表示のみ。変更は /shift 側で行う）。
        // 配車に関わらない人（事務など）はシフトに入っていても乗務割には出さない。
        // 出す・出さないは「配車担当者の設定」の チェックボックス（staff.haisha_assignable）で決まる。
        const fromShift = g.shiftKey
          ? sortByShiftOrder(
              (byCode.get(g.shiftKey) || [])
                .map((d) => ({ ...d, staff: staff.find((s) => s.id === d.staffId) }))
                .filter((d) => d.staff && d.staff.haishaAssignable !== false)
            )
          : [];
        shiftShown += fromShift.length;
        for (const m of fromShift) {
          names.appendChild(dutyBadge(m.staff, { phoneDuty: m.phoneDuty }));
        }

        // この画面で日ごとに足した分（×で外せる）
        const cat = g.dailyKey;
        const fromDaily = cat
          ? sortByShiftOrder(
              dailyDutyRows
                .filter((d) => d.category === cat)
                .map((d) => ({ ...d, staff: staff.find((s) => s.id === d.staffId) }))
                .filter((d) => d.staff)
            )
          : [];
        for (const m of fromDaily) {
          names.appendChild(dutyBadge(m.staff, {
            onRemove: async () => {
              try {
                await removeDailyDuty(dateKey, cat!, m.staffId);
                dailyDutyRows = dailyDutyRows.filter(
                  (d) => !(d.category === cat && d.staffId === m.staffId));
                renderDuty();
              } catch (e) {
                alert(failMsg(e, '担当の削除'));
              }
            },
          }));
        }

        if (fromShift.length === 0 && fromDaily.length === 0) {
          const none = document.createElement('span');
          none.className = 'ha-duty-none';
          none.textContent = 'なし';
          names.appendChild(none);
        }

        // 追加用のセレクト。選ぶと即保存して、すぐ次を選べるように戻す。
        // すでに出ている人（シフト由来も含む）は候補から外す
        if (cat) {
          const already = new Set([...fromShift, ...fromDaily].map((a) => a.staffId));
          const pick = document.createElement('select');
          pick.className = 'ha-select ha-duty-add';
          pick.appendChild(new Option('＋ 追加', ''));
          for (const s of assignableStaff().filter((s) => !already.has(s.id))) {
            pick.appendChild(new Option(s.name, s.id));
          }
          pick.onchange = async () => {
            const staffId = pick.value;
            if (!staffId) return;
            pick.disabled = true;
            try {
              await addDailyDuty(dateKey, cat, staffId);
              dailyDutyRows = [...dailyDutyRows, { category: cat, staffId }];
              renderDuty();
            } catch (e) {
              alert(failMsg(e, '担当の追加'));
              pick.value = '';
              pick.disabled = false;
            }
          };
          names.appendChild(pick);
        }

        body.appendChild(names);
      }

      $('dutyNote').textContent = shiftShown === 0
        ? 'この日のシフトが未入力です。/shift で作成すると、普通・遅番・スクール・貸切・乗合がここに出ます。'
        : '× が付いた名前がこの画面で足した分です。それ以外はシフトの内容なので、変更は /shift で行ってください。';
    }

    // ── 変更履歴 ──
    // 何がどう変わったかを日本語で出す。列名のままでは現場で読めないため。
    const FIELD_LABELS = {
      reserved_at: '予約日時', alarm_minutes: 'アラーム(分前)', customer_name: 'お客様名',
      customer_kana: '読み', phone: '電話番号', reservation_memo: '予約メモ',
      operator_memo: 'オペレーター用メモ', pickup_name: '迎車場所名', pickup_memo: '場所メモ',
      pickup_address: '迎車住所', dropoff_name: '降車場所名', dropoff_address: '降車住所',
      staff_id: '担当者', checked: '確認', app_memo: '申し送り', status: '状態',
      registered_by: '登録オペレーター', registered_at: '登録日時', office_name: '事業所名',
    };

    /** 値を読める形にする。担当者はid→氏名、状態はコード→日本語 */
    function fieldValueLabel(field: string, v: any) {
      if (v === null || v === undefined || v === '') return '（空）';
      if (field === 'staff_id') return staffName(v) || '（不明）';
      if (field === 'status') return STATUS_LABELS[v] ?? v;
      if (field === 'checked') return v ? '済' : '未';
      if (field === 'reserved_at' || field === 'registered_at') {
        return `${jstDateKey(v).slice(5).replace('-', '/')} ${jstTimeLabel(v)}`;
      }
      return String(v);
    }

    /** old と new を比べて、変わった項目だけを返す */
    function diffFields(oldRow: any, newRow: any) {
      const out: { field: string; from: any; to: any }[] = [];
      for (const field of Object.keys(FIELD_LABELS)) {
        const a = oldRow?.[field] ?? null;
        const b = newRow?.[field] ?? null;
        if (JSON.stringify(a) !== JSON.stringify(b)) out.push({ field, from: a, to: b });
      }
      return out;
    }

    function historySubject(e: any) {
      const row = e.newRow || e.oldRow || {};
      const when = row.reserved_at
        ? `${jstDateKey(row.reserved_at).slice(5).replace('-', '/')} ${jstTimeLabel(row.reserved_at)}`
        : '';
      return `${when} ${row.customer_name || '（お客様名なし）'}`.trim();
    }

    let historyLoaded = false;

    async function loadHistory() {
      try {
        historyRows = await fetchDispatchHistory(100);
        historyLoaded = true;
      } catch (e) {
        $('historyBody').textContent = '履歴を読み込めませんでした。';
        return;
      }
      renderHistory();
    }

    // ── 乗務割の固定表示と開閉 ──
    // サイトのヘッダーが sticky なので、その真下に貼り付ける。
    // 高さは画面幅で変わるため、決め打ちせず実測してCSS変数に入れる。
    function syncStickyOffset() {
      const nav = document.querySelector('.nav');
      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 0;
      document.documentElement.style.setProperty('--ha-sticky-top', `${h}px`);
    }
    syncStickyOffset();
    window.addEventListener('resize', syncStickyOffset);

    // 貼り付いている（stuck）間だけ幅を狭くする。
    // 直前に置いたセンチネルが画面外に出た＝乗務割が本来の位置を離れて
    // ヘッダー直下に固定された、という合図として使う。
    const dutySentinel = document.getElementById('dutyStickySentinel');
    if (dutySentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => $('dutyPanel').classList.toggle('is-stuck', !entry.isIntersecting),
        { threshold: 0 }
      ).observe(dutySentinel);
    }

    // ── 文字サイズ ──
    // ルートの font-size を変えることで、rem指定のものが一括で拡大する。
    // 65型のタッチ表示では離れて見るため、PCと同じ大きさでは読めない。
    const ZOOM_KEY = 'fuji-haisha-zoom';

    function applyZoom(pct: number) {
      document.documentElement.style.fontSize = pct === 100 ? '' : `${pct}%`;
      for (const b of document.querySelectorAll('.ha-zoom__btn')) {
        b.classList.toggle('is-active', Number((b as HTMLElement).dataset.zoom) === pct);
      }
      // 65型の大画面では、標準幅（--container-max: 1200px、ヘッダーや見出しも
      // これに従う）が実機の横幅に対して狭く、中央の帯に寄って見える
      // （実機の写真で確認済み）。文字を大きくするほど、コンテナの上限も
      // 一緒に緩める。--container-max はヘッダーの nav__inner や
      // page-hero も使っている変数なので、これを上書きすればページ全体が
      // 連動して広がる（.ha-wrap 個別に広げても、ヘッダーは変わらないため）。
      if (pct >= 165) document.documentElement.style.setProperty('--container-max', 'min(96vw, 2200px)');
      else if (pct >= 130) document.documentElement.style.setProperty('--container-max', 'min(92vw, 1600px)');
      else document.documentElement.style.removeProperty('--container-max');
      localStorage.setItem(ZOOM_KEY, String(pct));
      // ヘッダーの高さも一緒に変わるので、乗務割の貼り付き位置を取り直す
      syncStickyOffset();
    }

    applyZoom(Number(localStorage.getItem(ZOOM_KEY)) || 100);
    for (const b of document.querySelectorAll('.ha-zoom__btn')) {
      (b as HTMLElement).onclick = () => applyZoom(Number((b as HTMLElement).dataset.zoom));
    }

    // 開閉の状態は端末に覚えさせる（閉じた人が毎回開き直さずに済むように）。
    // 既定は閉じている（HTML側）。前回「開いた」を選んだ端末だけ開いた状態にする。
    const DUTY_OPEN_KEY = 'fuji-haisha-duty-open';
    if (localStorage.getItem(DUTY_OPEN_KEY) === 'open') $('dutyPanel').open = true;
    $('dutyPanel').addEventListener('toggle', () => {
      localStorage.setItem(DUTY_OPEN_KEY, $('dutyPanel').open ? 'open' : 'closed');
      if ($('dutyPanel').open) {
        // 開いた直後は、ページ最上部にいるとその手前の見出し・タブ等だけで
        // 画面の大半を使ってしまい「乗務割しか見えない」状態になる。
        // sticky位置（ヘッダー直下）まで運んで、乗務割と配車ボードが
        // 両方見える状態にする。
        requestAnimationFrame(() => {
          $('dutyPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });

    // 開いたときに初めて読み込む（普段は畳んでいるので、毎回取りに行かない）
    $('historyPanel').addEventListener('toggle', () => {
      if ($('historyPanel').open && !historyLoaded) loadHistory();
    });

    function renderHistory() {
      const body = $('historyBody');
      body.innerHTML = '';

      if (historyRows.length === 0) {
        const p = document.createElement('p');
        p.className = 'kt-empty';
        p.textContent = 'まだ変更はありません。';
        body.appendChild(p);
        return;
      }

      for (const e of historyRows) {
        const item = document.createElement('div');
        item.className = 'ha-hist';

        const head = document.createElement('div');
        head.className = 'ha-hist__head';

        const kind = document.createElement('span');
        kind.className = `ha-badge ha-hist__kind ha-hist__kind--${e.action}`;
        kind.textContent = { insert: '追加', update: '変更', delete: '削除' }[e.action] ?? e.action;
        head.appendChild(kind);

        const subject = document.createElement('span');
        subject.className = 'ha-hist__subject';
        subject.textContent = historySubject(e);
        head.appendChild(subject);

        const meta = document.createElement('span');
        meta.className = 'ha-hist__meta';
        meta.textContent =
          `${jstDateKey(e.changedAt).slice(5).replace('-', '/')} ${jstTimeLabel(e.changedAt)}`
          + (e.changedBy ? ` ${e.changedBy}` : '');
        head.appendChild(meta);

        const revert = document.createElement('button');
        revert.type = 'button';
        revert.className = 'kt-btn kt-btn--ghost ha-hist__revert';
        revert.textContent = '元に戻す';
        revert.onclick = async () => {
          const label = { insert: 'この追加を取り消します（予約が削除されます）',
                          update: 'この変更を取り消して、変更前の状態に戻します',
                          delete: '削除された予約を復元します' }[e.action];
          if (!confirm(`${label}。よろしいですか？\n\n対象：${historySubject(e)}`)) return;
          revert.disabled = true;
          try {
            await revertHistoryEntry(e);
            await loadBoard();
            await loadHistory();
          } catch (err) {
            // 削除の復元中に、CSV取り込みで同じ予約が作り直されているとここに来る
            alert(err?.code === '23505'
              ? '同じ予約がすでに存在するため復元できません。CSVの取り込みで作り直された可能性があります。'
              : failMsg(err, '元に戻す操作'));
            revert.disabled = false;
          }
        };
        head.appendChild(revert);
        item.appendChild(head);

        // 変更内容の明細
        if (e.action === 'update') {
          const changes = diffFields(e.oldRow, e.newRow);
          const ul = document.createElement('ul');
          ul.className = 'ha-hist__changes';
          for (const c of changes) {
            const li = document.createElement('li');
            li.textContent =
              `${FIELD_LABELS[c.field]}：${fieldValueLabel(c.field, c.from)} → ${fieldValueLabel(c.field, c.to)}`;
            ul.appendChild(li);
          }
          if (changes.length > 0) item.appendChild(ul);
        }

        body.appendChild(item);
      }
    }

    $('historyReloadBtn').onclick = loadHistory;

    // ── 経過した予約を隠す ──
    // 予約時刻から1時間たった分は配車ボードから消していく。
    // ただし今日を見ているときだけ。過去の日を開いたら全件が対象になってしまうため。
    const HIDE_AFTER_MINUTES = 60;
    let showPast = false;
    let lastHiddenCount = -1;

    function isPastReservation(r: any) {
      return Date.now() - new Date(r.reservedAt).getTime() > HIDE_AFTER_MINUTES * 60 * 1000;
    }

    function hidingApplies() {
      return !showPast && ($('datePick').value || todayJst()) === todayJst();
    }

    function hiddenRows() {
      return hidingApplies() ? boardRows.filter(isPastReservation) : [];
    }

    function visibleBoardRows() {
      return hidingApplies() ? boardRows.filter((r) => !isPastReservation(r)) : boardRows;
    }

    $('showPastBtn').onclick = () => {
      showPast = !showPast;
      $('showPastBtn').textContent = showPast ? '経過分を隠す' : '経過分も表示';
      renderBoard();
    };

    // 時間が過ぎたら勝手に消えるように。表示が変わるときだけ描き直す
    // （毎分描き直すと、開いている担当者セレクトが閉じてしまうため）
    setInterval(() => {
      if ($('boardPanel').hidden) return;
      if (hiddenRows().length !== lastHiddenCount) renderBoard();
    }, 60 * 1000);

    // ── ① 配車ボード ──
    async function loadBoard() {
      const dateKey = $('datePick').value || todayJst();
      try {
        const [rows, duties, daily, handover] = await Promise.all([
          fetchReservationsByDate(dateKey),
          fetchShiftsByDate(dateKey),
          fetchDailyDuties(dateKey),
          fetchLatestHandover(),
        ]);
        boardRows = rows;
        dutyRows = duties;
        dailyDutyRows = daily;
        latestHandover = handover;
      } catch (e) {
        alert(failMsg(e, 'データの読み込み'));
        return;
      }
      // 日付は真下の配車ボードの見出しと日付選択に出ているので、ここでは繰り返さない
      renderHandover();
      renderDuty();
      renderBoard();
    }

    function renderBoard() {
      const dateKey = $('datePick').value || todayJst();
      $('boardTitle').textContent = `配車ボード　${dateKey.replace(/-/g, '/')}（${weekdayOf(dateKey)}）`;

      const rows = visibleBoardRows();
      const hidden = hiddenRows().length;
      lastHiddenCount = hidden;

      // 「経過分も表示」は、隠す対象が実際にあるときだけ出す
      $('showPastBtn').hidden = hidden === 0 && !showPast;

      const table = $('boardTable');
      table.innerHTML = '';
      $('boardEmpty').hidden = rows.length > 0;
      $('boardEmpty').textContent = boardRows.length > 0 && rows.length === 0
        ? `この日の予約はすべて時間が過ぎました（${hidden}件）。「経過分も表示」で確認できます。`
        : 'この日の予約はありません。';

      renderBoardSummary();

      if (rows.length === 0) return;

      // 電話番号はこの一覧には出さない（編集を開けば見える）。指で操作する
      // タッチ画面で番号がそのまま並んでいると誤って見えてしまうため
      table.appendChild(headerRow(['時刻', '状態', '担当者', 'お客様名', '迎車場所', '行き先・メモ', '済', '']));

      const tbody = document.createElement('tbody');
      for (const r of rows) {
        const tr = document.createElement('tr');
        applyRowStatus(tr, r);

        // 新着は状態欄にまとめて表示する（時刻の隣のバッジは廃止）。
        // 行左端の縦線だけは、状態を変えても残るように別途付けておく
        const isNew = isNewSinceHandover(r);
        const timeCell = td(jstTimeLabel(r.reservedAt), 'ha-sticky ha-time');
        if (isNew) tr.classList.add('ha-row--new');
        tr.appendChild(timeCell);

        // 状態（選択で即保存）
        const statusCell = document.createElement('td');
        const stSel = buildStatusSelect(r.status, isNew);
        if (isNew) stSel.title = newBadgeTitle(r);
        stSel.onchange = async () => {
          const next = stSel.value as 'normal' | 'changed' | 'cancelled';
          const prev = r.status;
          stSel.disabled = true;
          try {
            await setStatus(r.id, next);
            r.status = next;
            const showAsNew = isNew && next === 'normal';
            stSel.className = `ha-select ha-status ha-status--${showAsNew ? 'new' : next}`;
            applyRowStatus(tr, r);
            renderBoardSummary();
          } catch (e) {
            alert(failMsg(e, '状態の保存'));
            stSel.value = prev;
          } finally {
            stSel.disabled = false;
          }
        };
        statusCell.appendChild(stSel);
        tr.appendChild(statusCell);

        // 担当者（選択で即保存）
        const staffCell = document.createElement('td');
        const sel = buildStaffSelect(r.staffId);
        sel.onchange = async () => {
          const next = sel.value || null;
          const prev = r.staffId;
          sel.disabled = true;
          try {
            await assignStaff(r.id, next);
            r.staffId = next;
            applyStaffColor(sel, next);
            applyRowStatus(tr, r);
            renderBoardSummary();
          } catch (e) {
            alert(failMsg(e, '担当者の保存'));
            sel.value = prev || '';
          } finally {
            sel.disabled = false;
          }
        };
        staffCell.appendChild(sel);
        tr.appendChild(staffCell);

        tr.appendChild(td(r.customerName));
        tr.appendChild(td(pickupText(r), 'ha-wrapcell'));
        tr.appendChild(td(r.operatorMemo, 'ha-wrapcell'));

        // 確認チェック（即保存）
        const checkCell = document.createElement('td');
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'ha-check';
        cb.checked = r.checked;
        cb.onchange = async () => {
          const next = cb.checked;
          cb.disabled = true;
          try {
            await setChecked(r.id, next);
            r.checked = next;
            renderBoardSummary();
          } catch (e) {
            alert(failMsg(e, 'チェックの保存'));
            cb.checked = !next;
          } finally {
            cb.disabled = false;
          }
        };
        checkCell.appendChild(cb);
        tr.appendChild(checkCell);

        const editCell = document.createElement('td');
        editCell.className = 'ha-noprint';
        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'ha-linkbtn';
        editBtn.textContent = '編集';
        editBtn.onclick = () => openEdit(r);
        editCell.appendChild(editBtn);
        tr.appendChild(editCell);

        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
    }

    function renderBoardSummary() {
      // 件数も画面に出ている分だけを数える（隠した分を足すと数が合わなく見えるため）
      const shown = visibleBoardRows();
      const hidden = hiddenRows().length;

      // キャンセル済みは「未割当」「確認済」の母数から外す（対応不要のため）
      const live = shown.filter((r) => r.status !== 'cancelled');
      const unassigned = live.filter((r) => !r.staffId).length;
      const done = live.filter((r) => r.checked).length;
      const changed = live.filter((r) => r.status === 'changed').length;
      const cancelled = shown.length - live.length;

      const fresh = live.filter(isNewSinceHandover).length;

      const parts = [`要対応 ${live.length}件`, `未割当 ${unassigned}件`, `確認済 ${done}件`];
      if (changed > 0) parts.push(`変更あり ${changed}件`);
      if (cancelled > 0) parts.push(`キャンセル ${cancelled}件`);
      if (fresh > 0) parts.push(`新着 ${fresh}件`);
      if (hidden > 0) parts.push(`時間経過で非表示 ${hidden}件`);

      const baseTime = newBaselineTime();
      const baseIso = baseTime === null ? null : new Date(baseTime).toISOString();
      const tail = fresh > 0 && baseIso
        ? `　　「新着」は${jstDateKey(baseIso).slice(5).replace('-', '/')} `
          + `${jstTimeLabel(baseIso)}${baselineIsAuto() ? '（自動）' : 'の引き継ぎ'}以降に入った予約です。`
        : '　　担当者・状態を選ぶとその場で保存されます。';
      $('boardSummary').textContent = parts.join('　') + tail;
    }

    $('datePick').onchange = loadBoard;
    $('prevDayBtn').onclick = () => { $('datePick').value = shiftDate($('datePick').value, -1); loadBoard(); };
    $('nextDayBtn').onclick = () => { $('datePick').value = shiftDate($('datePick').value, 1); loadBoard(); };
    $('todayBtn').onclick = () => { $('datePick').value = todayJst(); loadBoard(); };
    $('printBtn').onclick = () => window.print();

    // ── ② 予約一覧 ──
    async function loadList() {
      const from = $('fromPick').value;
      const to = $('toPick').value;
      if (!from || !to) return;
      try {
        listRows = await fetchReservationsRange(from, to);
      } catch (e) {
        alert(failMsg(e, 'データの読み込み'));
        return;
      }
      renderList();
    }

    function renderList() {
      const q = ($('searchInput').value || '').trim().toLowerCase();
      const digits = q.replace(/\D/g, '');
      const rows = listRows.filter((r) => {
        if (!q) return true;
        const hay = [r.customerName, r.customerKana, r.pickupName, r.pickupAddress, r.operatorMemo]
          .filter(Boolean).join(' ').toLowerCase();
        if (hay.includes(q)) return true;
        return digits !== '' && (r.phone || '').replace(/\D/g, '').includes(digits);
      });

      const table = $('listTable');
      table.innerHTML = '';
      $('listEmpty').hidden = rows.length > 0;
      $('listSummary').textContent = `${rows.length}件を表示（期間内 ${listRows.length}件）　行をクリックすると編集できます。`;

      if (rows.length === 0) return;

      table.appendChild(headerRow(['予約日時', '状態', 'お客様名', '電話', '迎車場所', '行き先・メモ', '担当者', '済']));

      const tbody = document.createElement('tbody');
      for (const r of rows) {
        const tr = document.createElement('tr');
        tr.className = 'ha-row--click';
        applyRowStatus(tr, r);
        tr.onclick = () => openEdit(r);

        // 配車ボードと同じく、新着は状態欄にまとめる
        const isNew = isNewSinceHandover(r);
        const when = `${jstDateKey(r.reservedAt).slice(5).replace('-', '/')}(${weekdayOf(jstDateKey(r.reservedAt))}) ${jstTimeLabel(r.reservedAt)}`;
        const whenCell = td(when, 'ha-sticky ha-time');
        if (isNew) tr.classList.add('ha-row--new');
        tr.appendChild(whenCell);

        const stCell = td('');
        if (isNew && r.status === 'normal') {
          const badge = document.createElement('span');
          badge.className = 'ha-badge ha-badge--new';
          badge.textContent = '新着';
          badge.title = newBadgeTitle(r);
          stCell.appendChild(badge);
        } else if (r.status !== 'normal') {
          const badge = document.createElement('span');
          badge.className = `ha-badge ha-badge--${r.status}`;
          badge.textContent = STATUS_LABELS[r.status];
          stCell.appendChild(badge);
        }
        tr.appendChild(stCell);

        tr.appendChild(td(r.customerName));
        tr.appendChild(td(r.phone));
        tr.appendChild(td(pickupText(r), 'ha-wrapcell'));
        tr.appendChild(td(r.operatorMemo, 'ha-wrapcell'));

        const staffCell = td('');
        if (r.staffId) {
          const badge = document.createElement('span');
          badge.className = 'ha-badge ha-badge--assigned';
          applyStaffColor(badge, r.staffId);
          badge.textContent = staffName(r.staffId);
          staffCell.appendChild(badge);
        } else {
          const badge = document.createElement('span');
          badge.className = 'ha-badge ha-badge--unassigned';
          badge.textContent = '未割当';
          staffCell.appendChild(badge);
        }
        tr.appendChild(staffCell);

        tr.appendChild(td(r.checked ? '✓' : ''));
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
    }

    $('searchInput').oninput = renderList;
    $('fromPick').onchange = loadList;
    $('toPick').onchange = loadList;
    $('reloadBtn').onclick = loadList;

    // ── 編集モーダル ──
    function openEdit(rec: any) {
      editing = rec;
      $('editTitle').textContent = rec ? '予約の編集' : '新規予約';
      $('fReservedAt').value = rec ? toLocalInput(rec.reservedAt) : `${$('datePick').value || todayJst()}T09:00`;
      $('fCustomerName').value = rec?.customerName || '';
      $('fCustomerKana').value = rec?.customerKana || '';
      $('fPhone').value = rec?.phone || '';
      $('fAlarm').value = rec?.alarmMinutes ?? '';
      $('fPickupName').value = rec?.pickupName || '';
      $('fPickupAddress').value = rec?.pickupAddress || '';
      $('fPickupMemo').value = rec?.pickupMemo || '';
      $('fDropoffName').value = rec?.dropoffName || '';
      $('fDropoffAddress').value = rec?.dropoffAddress || '';
      $('fOperatorMemo').value = rec?.operatorMemo || '';
      $('fAppMemo').value = rec?.appMemo || '';

      const wrap = $('fStaffWrap');
      wrap.innerHTML = '';
      wrap.appendChild(buildStaffSelect(rec?.staffId));

      const stWrap = $('fStatusWrap');
      stWrap.innerHTML = '';
      stWrap.appendChild(buildStatusSelect(rec?.status || 'normal'));

      $('editSourceNote').textContent = rec
        ? (rec.source === 'csv'
            ? '※ この予約はCSV取り込み由来です。予約日時・お客様名・電話番号を変更すると、次回の取り込みで別の予約として扱われることがあります。'
            : '※ この予約はアプリで手入力されたものです。CSV取り込みの対象外です。')
        : '※ アプリで手入力した予約はCSV取り込みで上書きされません。';

      $('editDeleteBtn').hidden = !rec || !isAdmin();
      $('editModal').hidden = false;
    }

    $('editCancelBtn').onclick = () => { $('editModal').hidden = true; editing = null; };
    $('editModal').onclick = (e) => { if (e.target === $('editModal')) $('editCancelBtn').click(); };

    $('editSaveBtn').onclick = async () => {
      const reservedAt = fromLocalInput($('fReservedAt').value);
      if (!reservedAt) { alert('予約日時を入力してください。'); return; }
      const customerName = $('fCustomerName').value.trim();
      if (!customerName) { alert('お客様名を入力してください。'); return; }

      const alarmRaw = $('fAlarm').value.trim();
      const sel = $('fStaffWrap').querySelector('select');
      const stSel = $('fStatusWrap').querySelector('select');
      const payload = {
        reservedAt,
        customerName,
        customerKana: $('fCustomerKana').value.trim() || null,
        phone: $('fPhone').value.trim() || null,
        alarmMinutes: alarmRaw === '' ? null : Number(alarmRaw),
        pickupName: $('fPickupName').value.trim() || null,
        pickupAddress: $('fPickupAddress').value.trim() || null,
        pickupMemo: $('fPickupMemo').value.trim() || null,
        dropoffName: $('fDropoffName').value.trim() || null,
        dropoffAddress: $('fDropoffAddress').value.trim() || null,
        operatorMemo: $('fOperatorMemo').value.trim() || null,
        appMemo: $('fAppMemo').value.trim() || null,
        staffId: sel && sel.value ? sel.value : null,
        status: stSel ? stSel.value : 'normal',
      };

      $('editSaveBtn').disabled = true;
      try {
        if (editing) await updateReservation(editing.id, payload);
        else await insertReservation(payload);
        $('editModal').hidden = true;
        editing = null;
        await refreshCurrentTab();
      } catch (e) {
        alert(failMsg(e, '予約の保存'));
      } finally {
        $('editSaveBtn').disabled = false;
      }
    };

    $('editDeleteBtn').onclick = async () => {
      if (!editing) return;
      if (!confirm(`「${editing.customerName}」の予約を削除します。よろしいですか？`)) return;
      try {
        await deleteReservation(editing.id);
        $('editModal').hidden = true;
        editing = null;
        await refreshCurrentTab();
      } catch (e) {
        alert(isAuthError(e) ? '削除できませんでした。管理者としてログインし直してください。' : '削除に失敗しました。電波状況を確認して、もう一度お試しください。');
      }
    };

    $('newBtn').onclick = () => openEdit(null);

    async function refreshCurrentTab() {
      if ($('boardPanel').hidden) await loadList();
      else await loadBoard();
    }

    // ── CSV取り込み ──
    function openImport() {
      importPlan = null;
      $('importText').value = '';
      $('importFile').value = '';
      $('importPreview').hidden = true;
      $('importPreview').innerHTML = '';
      $('importApplyBtn').disabled = true;
      $('importModal').hidden = false;
    }

    $('importBtn').onclick = openImport;
    $('importCancelBtn').onclick = () => { $('importModal').hidden = true; };

    $('importFile').onchange = async () => {
      const file = $('importFile').files?.[0];
      if (!file) return;
      const buf = await file.arrayBuffer();
      $('importText').value = decodeCsvBuffer(buf);
      $('importApplyBtn').disabled = true;
      $('importPreview').hidden = true;
    };

    $('importText').oninput = () => {
      $('importApplyBtn').disabled = true;
      $('importPreview').hidden = true;
    };

    function line(parent: HTMLElement, text: string, className = '') {
      const p = document.createElement('p');
      if (className) p.className = className;
      p.textContent = text;
      parent.appendChild(p);
      return p;
    }

    $('importParseBtn').onclick = async () => {
      const text = $('importText').value;
      if (!text.trim()) { alert('CSVファイルを選ぶか、内容を貼り付けてください。'); return; }

      const parsed = parseReservationCsv(text);
      const box = $('importPreview');
      box.innerHTML = '';
      box.hidden = false;
      $('importApplyBtn').disabled = true;

      if (parsed.rows.length === 0) {
        line(box, '取り込める行がありませんでした。', 'ha-preview__error');
        for (const e of parsed.errors.slice(0, 10)) {
          line(box, e.line === 0 ? e.reason : `${e.line}行目: ${e.reason}`, 'ha-preview__error');
        }
        return;
      }

      $('importParseBtn').disabled = true;
      try {
        importPlan = await buildImportPlan(parsed.rows);
      } catch (e) {
        line(box, isAuthError(e) ? 'ログインしていないため確認できません。画面上部の「ログインする」を押してください。' : '既存データの確認に失敗しました。電波状況を確認してもう一度お試しください。', 'ha-preview__error');
        return;
      } finally {
        $('importParseBtn').disabled = false;
      }

      const keepStaff = importPlan.updates.filter((u) => u.hasStaff).length;

      line(box, `対象期間：${importPlan.dateFrom} 〜 ${importPlan.dateTo}`);
      line(box, `新規に追加：${importPlan.inserts.length}件`, 'ha-preview__ok');
      line(box, `既存を更新：${importPlan.updates.length}件`
        + (keepStaff > 0 ? `（うち${keepStaff}件は担当者が割り当て済み。担当者はそのまま残します）` : ''), 'ha-preview__ok');
      if (importPlan.duplicatesInFile > 0) {
        line(box, `ファイル内で重複していた行：${importPlan.duplicatesInFile}件（後の行を採用します）`, 'ha-preview__warn');
      }
      if (parsed.errors.length > 0) {
        line(box, `読み取れなかった行：${parsed.errors.length}件`, 'ha-preview__warn');
        for (const e of parsed.errors.slice(0, 5)) {
          line(box, `　${e.line}行目: ${e.reason}`, 'ha-preview__warn');
        }
      }

      const cols = document.createElement('details');
      const sum = document.createElement('summary');
      sum.textContent = `読み取った列（${parsed.mapping.length}列）`;
      cols.appendChild(sum);
      const ul = document.createElement('ul');
      for (const m of parsed.mapping) {
        const li = document.createElement('li');
        li.textContent = `${m.header} → ${m.field}`;
        ul.appendChild(li);
      }
      cols.appendChild(ul);
      box.appendChild(cols);

      $('importApplyBtn').disabled = false;
    };

    $('importApplyBtn').onclick = async () => {
      if (!importPlan) return;
      $('importApplyBtn').disabled = true;
      try {
        const result = await applyImportPlan(importPlan);
        $('importModal').hidden = true;
        alert(`取り込みました。\n新規 ${result.inserted}件 / 更新 ${result.updated}件`);
        if (importPlan.dateFrom) {
          $('datePick').value = importPlan.dateFrom;
          $('fromPick').value = importPlan.dateFrom;
          $('toPick').value = importPlan.dateTo;
        }
        importPlan = null;
        await refreshCurrentTab();
      } catch (e) {
        alert(failMsg(e, '取り込み'));
        $('importApplyBtn').disabled = false;
      }
    };

    // ── 起動 ──
    async function boot() {
      // 日付欄はログインの成否に関わらず先に埋めておく
      // （ログインに失敗したときに日付が空のまま残ると、壊れて見えるため）
      const today = todayJst();
      $('datePick').value = today;
      $('fromPick').value = shiftDate(today, -7);
      $('toPick').value = shiftDate(today, 30);

      const authResult = await initAuth();
      if (!authResult.ok || !(await hasSession())) {
        // ここで return せずに画面は出しておく。ログインできていないことを
        // バナーで示し、「ログインする」からやり直せるようにする。
        showLoggedOut(authResult.error || '');
        renderAdminBar();
        return;
      }
      clearLoggedOut();

      try {
        staff = await fetchStaff();
        rebuildStaffColors();
      } catch (e) {
        alert(failMsg(e, 'スタッフ情報の読み込み'));
        return;
      }

      renderAdminBar();
      await loadBoard();
    }

    boot();
  </script>

