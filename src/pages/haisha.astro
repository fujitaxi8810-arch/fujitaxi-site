    // ── 共通のセル生成 ──
    // label はスマホ幅でカード表示に切り替えたときの見出し（td::beforeで使う）。
    // 省略した場合はそのセルにラベルを付けない（編集ボタンなど、無くても分かるもの用）
    function td(text: string | null | undefined, className = '', label?: string) {
