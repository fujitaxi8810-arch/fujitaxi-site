        label.appendChild(cb);

        // 管理画面でも本人の色を出して、どの色が誰かを確認できるようにする
        const name = document.createElement('span');
        name.className = 'ha-badge ha-assign-name';
        applyStaffColor(name, s.id);
        name.textContent = s.name;
