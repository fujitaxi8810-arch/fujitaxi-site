    // 氏名ではなく id で更新するので、異体字や同姓の取り違えが起きない。
    const GROUP_LABELS = { null: '乗務員', jumbo: 'ジャンボ', office: '事務', maintenance: '整備' };

    function renderStaffAdmin() {
      const body = $('staffAdminBody');
      body.innerHTML = '';

      const sorted = [...staff].sort((a, b) =>
        (a.shiftDisplayOrder ?? a.displayOrder) - (b.shiftDisplayOrder ?? b.displayOrder));

      for (const s of sorted) {
        const label = document.createElement('label');
        label.className = 'ha-assign-item';

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'ha-check';
        cb.checked = s.haishaAssignable !== false;
        cb.onchange = async () => {
          const next = cb.checked;
          cb.disabled = true;
          try {
            await setStaffAssignable(s.id, next);
            s.haishaAssignable = next;
            // 担当者セレクトの中身が変わるので、表示中の画面を作り直す
            if (!$('boardPanel').hidden) renderBoard();
            else renderList();
