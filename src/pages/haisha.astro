    /* 日次割り当ての「×」。バッジの中に収める */
    .ha-duty-remove {
      background: transparent;
      border: none;
      color: #312e81;
      font-size: 1.25rem;
      font-weight: 900;
      line-height: 1;
      padding: 0 0 0 0.15rem;
      cursor: pointer;
      opacity: 0.55;
    }
    .ha-duty-remove:hover { opacity: 1; color: #b91c1c; }
    /* 追加用セレクトは名前バッジと同じ丸い形にして、並んでも浮かないようにする */
    .ha-select.ha-duty-add {
      /* 名前バッジと同じく、乗務割の高さを詰めるため 2.625rem から下げた。
         指で押す想定なので、下げすぎないようにしている */
      min-height: 2.3rem;
      min-width: 0;
      width: auto;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 0.15rem 0.7rem;
      border-radius: var(--radius-full);
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.22);
      color: rgba(255,255,255,0.75);
    }
    .ha-select.ha-duty-add:hover {
      background: rgba(245,200,0,0.14);
      border-color: var(--fuji-yellow);
      color: var(--fuji-yellow);
    }
    .ha-select.ha-duty-add option { background: #141414; color: #fff; }

    /* ── 折りたたみパネル ── */
    .ha-details { padding: 0; }
    .ha-details__summary {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.4rem 1.1rem;
      cursor: pointer;
      list-style: none;
      min-height: 2.75rem;
    }
    .ha-details__summary::-webkit-details-marker { display: none; }
    /* 開閉の向きが分かる三角を自前で描く */
    .ha-details__summary::before {
      content: '';
      border-left: 6px solid var(--fuji-yellow);
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
      transition: transform 0.15s ease;
    }
    .ha-details[open] > .ha-details__summary::before { transform: rotate(90deg); }
    .ha-details__summary:hover .kt-title { text-decoration: underline; }
    .ha-details__hint { color: rgba(255,255,255,0.45); font-size: 0.8rem; }
    .ha-details[open] .ha-details__hint { display: none; }
    .ha-details__body { padding: 0 1.1rem 0.5rem; }
    .ha-details__body .kt-panel__tools { justify-content: flex-end; margin-bottom: 0.3rem; }

    /* 見出しの行に同居させる「シフトを編集」。
       右端に寄せ、見出しの高さ（2.75rem）を超えないよう .kt-btn より小さくする
       ―― ここで大きいままだと、専用行を廃した分の節約が相殺されてしまう */
    .ha-duty-shiftlink {
      margin-left: auto;
      min-height: 0;
      padding: 0.25rem 0.75rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    /* ── 変更履歴 ── */
    .ha-hist {
      border-bottom: 1px solid rgba(255,255,255,0.1);
      padding: 0.6rem 0;
    }
    .ha-hist:last-child { border-bottom: none; }
    .ha-hist__head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .ha-hist__kind { font-size: 0.8rem; }
    .ha-hist__kind--insert { background: #f0fdf4; border-color: #15803d; color: #15803d; }
    .ha-hist__kind--update { background: #eff6ff; border-color: #1d4ed8; color: #1d4ed8; }
    .ha-hist__kind--delete { background: #fef2f2; border-color: #b91c1c; color: #b91c1c; }
    .ha-hist__subject { color: #fff; font-size: 1rem; font-weight: 700; flex: 1; min-width: 12rem; }
    .ha-hist__meta { color: rgba(255,255,255,0.55); font-size: 0.8rem; white-space: nowrap; }
    .ha-hist__revert { min-height: 2.25rem; padding: 0.3rem 0.8rem; font-size: 0.85rem; }
    .ha-hist__changes {
      margin: 0.35rem 0 0 0.5rem;
      padding-left: 1rem;
      color: rgba(255,255,255,0.8);
      font-size: 0.9rem;
      line-height: 1.7;
    }

    /* ── 配車担当者の設定 ── */
    .ha-assign-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: 0.35rem;
      margin-top: 0.6rem;
    }
    .ha-assign-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-md);
      padding: 0.5rem 0.75rem;
      min-height: 2.75rem;
      cursor: pointer;
    }
    .ha-assign-item:hover { border-color: rgba(245,200,0,0.5); }
    .ha-assign-item .ha-assign-name { flex: 1; }
    .ha-assign-name { font-size: 0.95rem; }
    .ha-assign-group {
      background: #eef2ff;
      border: 1px solid #312e81;
      border-radius: var(--radius-full);
      color: #312e81;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.1rem 0.5rem;
      white-space: nowrap;
    }

    /* 配車ボード見出しの日付・曜日の色分け（ユーザー要望）。
       見出し自体は.kt-titleの黄色のまま、日付・曜日（平日）は白にして見やすくし、
       土曜=水色／日曜・祝日=赤で一目で分かるようにする。
       .ha-board-weekday--sat/--red は .ha-board-weekday と同じ詳細度なので、
       打ち消されないよう平日用の色は必ず先に書く（後勝ち） */
    .ha-board-date { color: #fff; }
    .ha-board-paren { color: #fff; }
    .ha-board-weekday { color: #fff; }
    .ha-board-weekday--sat { color: #67e8f9; }
    .ha-board-weekday--red { color: #f87171; }

    .ha-legend { color: rgba(255,255,255,0.85); font-size: 0.9rem; margin: 0.25rem 0 0.75rem; }
    .ha-note { color: rgba(255,255,255,0.75); font-size: 0.85rem; line-height: 1.6; margin: 0; }
    /* 「このデータは最新版か」の確認用。控えめだが常に見える位置に出す */
    .ha-import-log {
      color: #0e7490;
      font-size: 0.85rem;
      font-weight: 700;
      margin: 0.4rem 0 0.8rem;
    }

    /* ── 絞り込み ── */
    .ha-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: flex-end;
      margin-bottom: 0.75rem;
    }
    .ha-field { display: flex; flex-direction: column; gap: 0.25rem; }
    .ha-field > span { color: rgba(255,255,255,0.75); font-size: 0.8rem; font-weight: 700; }
    .ha-field--grow { flex: 1 1 14rem; }
    .ha-field--full { grid-column: 1 / -1; }

    /* ── 表（白背景・濃い文字。印刷にも耐えるように） ── */
    .ha-grid-wrap {
      overflow-x: auto;
      background: #fff;
      border-radius: var(--radius-md);
      padding: 0.5rem;
    }
    .ha-grid { border-collapse: collapse; width: 100%; }
    .ha-grid th, .ha-grid td { color: #111; font-size: 1rem; padding: 0.5rem 0.6rem; }
    /* 文字を折り返して表を画面幅に収める。横スクロールはタッチだと操作しづらいので、
       できるだけ起こさない（.kt-table の nowrap を打ち消す） */
    .ha-grid td, .ha-grid th { white-space: normal; }
    .ha-grid td.ha-time, .ha-grid th.ha-sticky { white-space: nowrap; }
    .ha-grid th {
      color: #111;
      border-bottom: 2px solid #d4a900;
      background: #fff;
      font-size: 0.9rem;
    }
    .ha-grid td { border-bottom: 1px solid #e5e5e5; }
    .ha-grid tbody tr:hover { background: #fafafa; }

    /* 1列目（時刻）はスクロールしても残す */
    .ha-grid th.ha-sticky, .ha-grid td.ha-sticky {
      position: sticky;
      left: 0;
      background: #fff;
      z-index: 1;
      white-space: nowrap;
    }
    .ha-grid thead th.ha-sticky { z-index: 2; }
    .ha-time { font-weight: 900; font-size: 1.1rem; }

    /* 長文セルは折り返す */
    .ha-wrapcell { white-space: normal; min-width: 14rem; max-width: 24rem; line-height: 1.5; }

    .ha-row--unassigned td.ha-sticky, .ha-row--unassigned { background: #fffaf0; }
    .ha-row--click { cursor: pointer; }

    /* 変更あり：確認が要る行として目立たせる */
    .ha-row--changed td.ha-sticky, .ha-row--changed { background: #fffbeb; }
    .ha-row--changed td.ha-time { color: #92400e; }

    /* キャンセル：対応不要なので沈める。取り消し線で一目で分かるように */
    .ha-row--cancelled td.ha-sticky, .ha-row--cancelled { background: #f4f4f5; }
    .ha-row--cancelled td { color: #9ca3af; text-decoration: line-through; }
    .ha-row--cancelled td.ha-time { color: #9ca3af; }
    /* 操作できる部分に取り消し線がかかると読みにくいので戻す */
    .ha-row--cancelled select,
    .ha-row--cancelled .ha-badge,
    .ha-row--cancelled .ha-linkbtn { text-decoration: none; }

    /* ── バッジ（淡い背景＋濃い文字） ── */
    .ha-badge {
      display: inline-block;
      border: 1px solid;
      border-radius: var(--radius-full);
      font-size: 0.9rem;
      font-weight: 700;
      padding: 0.15rem 0.7rem;
      white-space: nowrap;
    }
    .ha-badge--assigned { background: #eff6ff; border-color: #1d4ed8; color: #1d4ed8; }
    .ha-badge--unassigned { background: #fef7ed; border-color: #b45309; color: #b45309; }
    .ha-badge--changed { background: #fffbeb; border-color: #92400e; color: #92400e; }
    .ha-badge--cancelled { background: #f4f4f5; border-color: #6b7280; color: #6b7280; }
    /* 引き継ぎ後の新着。他の状態色と衝突しないよう青緑を当てる */
    .ha-badge--new {
      background: #ecfeff;
      border-color: #0e7490;
      color: #0e7490;
      font-size: 0.75rem;
      margin-left: 0.4rem;
      vertical-align: middle;
    }
    /* 背景色は未割当・変更あり・キャンセルで使い切っているので、左の縦線で示す */
    .ha-row--new td.ha-sticky { box-shadow: inset 4px 0 0 #0e7490; }

    /* 状態セレクトも同じ配色にして、表を見渡したときに色で判別できるようにする。
       .ha-select が後ろで定義されているため、クラス2つ分の詳細度で上書きする */
    /* 「キャンセル」（5文字）がぎりぎり収まる幅まで狭め、
       浮いた分を隣の「行き先・メモ」列（.ha-wrapcell）に回す */
    .ha-select.ha-status { font-size: 0.85rem; min-width: 5.2rem; padding: 0.3rem 0.4rem; font-weight: 700; }
    .ha-select.ha-status--normal { background: #fff; border-color: #bbb; color: #111; }
    .ha-select.ha-status--changed { background: #fffbeb; border-color: #92400e; color: #92400e; }
    .ha-select.ha-status--cancelled { background: #f4f4f5; border-color: #6b7280; color: #6b7280; }
    /* 新着（＝状態は通常のまま、引き継ぎ以降に入った予約）。行左端の縦線と同じ青緑で揃える */
    .ha-select.ha-status--new { background: #ecfeff; border-color: #0e7490; color: #0e7490; }

    /* 「変更あり」「キャンセル」で状態欄の表記が新着から差し変わっても、
       小さな丸印で新着だと分かるようにする（状態セレクトの右肩・バッジの隣に添える） */
    .ha-status-newmark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.3rem;
      height: 1.3rem;
      margin-left: 0.3rem;
      border-radius: 50%;
      background: #0e7490;
      color: #fff;
      font-size: 0.65rem;
      font-weight: 900;
      line-height: 1;
      vertical-align: middle;
      flex-shrink: 0;
    }

    /* ── 表の中の入力 ── */
    .ha-select {
      background: #fff;
      border: 1px solid #bbb;
      border-radius: var(--radius-md);
      color: #111;
      font-size: 1rem;
      font-weight: 700;
      padding: 0.35rem 0.4rem;
      min-height: 2.75rem;
      min-width: 8rem;
      cursor: pointer;
    }
    .ha-select:disabled { opacity: 0.6; }
    .ha-check { width: 1.375rem; height: 1.375rem; cursor: pointer; }
    .ha-linkbtn {
      background: transparent;
      border: 1px solid #bbb;
      border-radius: var(--radius-md);
      color: #444;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 0.35rem 0.75rem;
      min-height: 2.5rem;
      cursor: pointer;
    }
    .ha-linkbtn:hover { border-color: #111; color: #111; }

    /* ── モーダル ── */
    .ha-modal { max-width: 680px; }
    /* 過去履歴は表形式で列数が多いので、通常のモーダルより広くする */
    .ha-modal--wide { max-width: 960px; }
    .ha-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: 0.7rem;
    }
    .ha-form .kt-input { width: 100%; }
    .ha-import-text { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; white-space: pre; }

    .ha-preview {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem;
      color: rgba(255,255,255,0.9);
      font-size: 0.9rem;
      line-height: 1.7;
      max-height: 16rem;
      overflow-y: auto;
    }
    .ha-preview p { margin: 0; }
    .ha-preview__ok { color: #86efac; font-weight: 700; }
    .ha-preview__warn { color: #fcd34d; }
    .ha-preview__error { color: #fca5a5; font-weight: 700; }
    .ha-preview details { margin-top: 0.5rem; }
    .ha-preview summary { cursor: pointer; color: var(--fuji-yellow); }
    .ha-preview ul { margin: 0.35rem 0 0 1.2rem; font-size: 0.82rem; color: rgba(255,255,255,0.75); }

    /* ── スマホ幅（配車ボード・予約一覧の表）──
     * 最初は列幅を詰めるだけの対応をしたが（表941px→614px）、8列ある表を
     * 横スクロールさせる形自体がスマホでは根本的に見にくいとの指摘があり、
     * 表→カード形式に作り替えた。各セルに data-label 属性を持たせておき
     * （td()ヘルパー・各render関数側で付与）、::before でラベルを出す
     * 典型的な「レスポンシブテーブル」の手法。横スクロールが無くなるので
     * 行き先メモ等の省略（ellipsis）は不要になり、素直に折り返す。
     */
    @media (max-width: 600px) {
      .ha-grid-wrap { overflow-x: visible; }
      .ha-grid thead { display: none; }
      .ha-grid, .ha-grid tbody, .ha-grid tr { display: block; width: 100%; }
      .ha-grid tr {
        border: 1px solid #e5e5e5;
        border-radius: var(--radius-md);
        margin-bottom: 0.6rem;
        padding: 0.3rem 0.7rem;
      }
      .ha-grid td {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.7rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f2f2f2;
        white-space: normal;
        min-width: 0;
        max-width: none;
        text-align: right;
      }
      .ha-grid tr > td:last-child { border-bottom: none; }
      .ha-grid td[data-label]::before {
        content: attr(data-label);
        font-weight: 700;
        color: #888;
        font-size: 0.78rem;
        flex: none;
        text-align: left;
      }
      /* ラベルの無いセル（編集ボタン等）は左右中央寄せのままでよい */
      .ha-grid td:not([data-label]) { justify-content: flex-end; }
      .ha-grid td.ha-sticky { position: static; background: none; }
      .ha-time { font-size: 1.05rem; }
      .ha-select { max-width: 65%; }
    }

    /* ── 印刷 ── */
    @media print {
      .nav, .footer, .page-hero, .kt-adminbar, .ha-zoombar, .ha-tabs,
      .kt-panel__tools, .ha-noprint { display: none !important; }
      body, .section { background: #fff !important; }
      .kt-panel { border-color: #000; background: #fff; padding: 0; }
      .kt-title { color: #000; }
      .ha-legend { color: #000; }
      .ha-grid-wrap { overflow: visible; padding: 0; }
      .ha-grid th, .ha-grid td { color: #000; font-size: 0.9rem; }
      .ha-row--unassigned, .ha-row--unassigned td.ha-sticky { background: #f5f5f5 !important; }
      .ha-select { border: none; background: transparent; font-size: 0.95rem; padding: 0; min-height: 0; }
      .ha-wrapcell { max-width: none; }
    }
  </style>
</Layout>
