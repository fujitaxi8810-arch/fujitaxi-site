  function renderStaff() {
    const list = $('staffList');
    list.innerHTML = '';
    $('staffEmpty').hidden = staff.length > 0;
    // 正社員グループには時給制の正社員も含める（区分表示は雇用形態、計算方式は別）
    const fulltime = staff.filter(s => staffType(s) !== 'part');
    const part = staff.filter(s => staffType(s) === 'part');
    const groups = [['正社員', fulltime], ['パート', part]];
    for (const [label, members] of groups) {
      if (!members.length) continue;
      if (part.length) { // 両区分あるときだけ見出しを表示
        const head = document.createElement('p');
        head.className = 'kt-staff-group';
        head.textContent = label;
        list.appendChild(head);
      }
      const wrap = document.createElement('div');
      wrap.className = 'kt-staff-grid';
      for (const s of members) wrap.appendChild(makeStaffChip(s));
      list.appendChild(wrap);
    }
  }

  // 区分・時給・月給・交通費の入力（管理者のみ）
  function promptEmpType(s) {
    const cur = staffType(s);
    const defAnsMap = { part: '2', 'fulltime-hourly': '3', monthly: '4', 'fulltime-base': '5', 'monthly-commission': '6' };
    const defAns = defAnsMap[cur] || '1';
    const input = prompt(`${s.name} の区分を選んでください（現在：${EMP_LABEL[cur]}）\n1 = 正社員（シフト日給＋歩合）\n2 = パート（時給制）\n3 = 正社員（時給制）\n4 = 正社員（月給制）\n5 = 正社員（基本給のみ・歩合なし）\n6 = 正社員（月給制＋歩合）`, defAns);
    if (input === null) return null;
    if (input.trim() === '1') return 'fulltime';
    if (input.trim() === '2') return 'part';
    if (input.trim() === '3') return 'fulltime-hourly';
    if (input.trim() === '4') return 'monthly';
    if (input.trim() === '5') return 'fulltime-base';
    if (input.trim() === '6') return 'monthly-commission';
    alert('1〜6 の番号を入力してください。');
    return null;
  }
  function promptCommute(s) {
    const cm = prompt(`${s.name} の交通費（円）を入力してください（なければ 0）`, s.commuteAllowance != null ? String(s.commuteAllowance) : '0');
    if (cm === null) return false;
    const cmNum = parseInt(cm, 10);
    if (isNaN(cmNum) || cmNum < 0) { alert('交通費は 0 以上の数字で入力してください。'); return false; }
    s.commuteAllowance = cmNum;
    if (cmNum > 0) {
      const curAns = s.commuteType === 'daily' ? '2' : '1';
      const typeInput = prompt(`${s.name} の交通費の支給方式を選んでください\n1 = 月額（出勤日数に関わらず毎月固定額）\n2 = 日額（出勤した日数分だけ加算）`, curAns);
      if (typeInput === null) return false;
      if (typeInput.trim() === '2') s.commuteType = 'daily';
      else if (typeInput.trim() === '1') s.commuteType = 'monthly';
      else { alert('1 か 2 を入力してください。'); return false; }
    } else {
      s.commuteType = 'monthly';
    }
    return true;
  }
  function promptPartWages(s) {
    const hw = prompt(`${s.name} の時間給（円）を入力してください`, s.hourlyWage != null ? String(s.hourlyWage) : String(settings.minWage));
    if (hw === null) return false;
    const hwNum = parseInt(hw, 10);
    if (isNaN(hwNum) || hwNum <= 0) { alert('時間給は正の数字で入力してください。'); return false; }
    s.hourlyWage = hwNum;
    return promptCommute(s);
  }
  function promptMonthlyWage(s) {
    const mw = prompt(`${s.name} の月給（円）を入力してください`, s.monthlyWage != null ? String(s.monthlyWage) : '300000');
    if (mw === null) return false;
    const mwNum = parseInt(mw, 10);
    if (isNaN(mwNum) || mwNum <= 0) { alert('月給は正の数字で入力してください。'); return false; }
    s.monthlyWage = mwNum;
    return promptCommute(s);
  }
  function promptDailyWage(s) {
    const dw = prompt(`${s.name} の基本日給（円・普通番／遅番に関わらず固定）を入力してください`, s.dailyWage != null ? String(s.dailyWage) : String(settings.normalWage));
    if (dw === null) return false;
    const dwNum = parseInt(dw, 10);
    if (isNaN(dwNum) || dwNum <= 0) { alert('基本日給は正の数字で入力してください。'); return false; }
    s.dailyWage = dwNum;
    return promptCommute(s);
  }
  function promptWagesFor(type, s) {
    if (isHourlyType(type)) return promptPartWages(s);
    if (isMonthlyType(type)) return promptMonthlyWage(s);
    if (type === 'fulltime-base') return promptDailyWage(s);
    return promptCommute(s);
  }
  function commuteTypeLabel(s) {
    return s.commuteType === 'daily' ? '日額' : '月額';
  }
  function promptBreakMode(s) {
    const curAns = s.breakMode === 'fixed' ? '2' : (s.breakMode === 'manual' ? '3' : '1');
    const input = prompt(`${s.name} の休憩の記録方法を選んでください\n1 = 通常（休憩開始／終了ボタンで打刻）\n2 = 固定（毎日決まった分数を自動で差し引く・ボタンは使わない）\n3 = 手入力（管理者が日ごとに休憩時間を入力・ボタンは使わない）`, curAns);
    if (input === null) return false;
    const v = input.trim();
    if (v === '1') { s.breakMode = 'punch'; s.breakFixedMinutes = null; return true; }
    if (v === '2') {
      const fm = prompt(`${s.name} の1日あたりの休憩時間（分）を入力してください`, s.breakFixedMinutes != null ? String(s.breakFixedMinutes) : '60');
      if (fm === null) return false;
      const fmNum = parseInt(fm, 10);
      if (isNaN(fmNum) || fmNum < 0) { alert('休憩時間は0以上の数字で入力してください。'); return false; }
      s.breakMode = 'fixed';
      s.breakFixedMinutes = fmNum;
      return true;
    }
    if (v === '3') { s.breakMode = 'manual'; s.breakFixedMinutes = null; return true; }
    alert('1〜3 の番号を入力してください。');
    return false;
  }
  function breakModeLabel(s) {
    if (s.breakMode === 'fixed') return `固定${s.breakFixedMinutes ?? 60}分`;
    if (s.breakMode === 'manual') return '手入力';
    return '通常';
  }
  function promptManagerAllowance(s) {
    const ma = prompt(`${s.name} の管理者手当（月額・円、運行管理者補助者手当＋整備管理者手当等の合計。無ければ0）を入力してください`, s.managerAllowance != null ? String(s.managerAllowance) : '0');
    if (ma === null) return false;
    const maNum = parseInt(ma, 10);
    if (isNaN(maNum) || maNum < 0) { alert('管理者手当は0以上の数字で入力してください。'); return false; }
    s.managerAllowance = maNum;
    return true;
  }
  function promptHousingAllowance(s) {
    const ha = prompt(`${s.name} の住宅手当（月額・円、無ければ0）を入力してください`, s.housingAllowance != null ? String(s.housingAllowance) : '0');
    if (ha === null) return false;
    const haNum = parseInt(ha, 10);
    if (isNaN(haNum) || haNum < 0) { alert('住宅手当は0以上の数字で入力してください。'); return false; }
    s.housingAllowance = haNum;
    return true;
  }
  function wageNoteFor(type, s) {
    if (isHourlyType(type)) return `（時間給 ${yen(s.hourlyWage)}円／交通費 ${yen(s.commuteAllowance)}円・${commuteTypeLabel(s)}）`;
    if (isMonthlyType(type)) return `（月給 ${yen(s.monthlyWage)}円／交通費 ${yen(s.commuteAllowance)}円・${commuteTypeLabel(s)}）`;
    if (type === 'fulltime-base') return `（基本日給 ${yen(s.dailyWage)}円／交通費 ${yen(s.commuteAllowance)}円・${commuteTypeLabel(s)}）`;
    return `（交通費 ${yen(s.commuteAllowance)}円・${commuteTypeLabel(s)}）`;
  }
  async function editStaff(s) {
    if (!(await requireAdmin())) return;
    renderAdminBar();
    const type = promptEmpType(s);
    if (type === null) return;
    if (!promptWagesFor(type, s)) return;
    if (!promptBreakMode(s)) return;
    if (!promptManagerAllowance(s)) return;
    if (!promptHousingAllowance(s)) return;
    try {
      await updateStaff(s.id, {
        type,
        hourlyWage: s.hourlyWage ?? null,
        monthlyWage: s.monthlyWage ?? null,
        dailyWage: s.dailyWage ?? null,
        commuteAllowance: s.commuteAllowance ?? 0,
        commuteType: s.commuteType || 'monthly',
        breakMode: s.breakMode || 'punch',
        breakFixedMinutes: s.breakFixedMinutes ?? null,
        managerAllowance: s.managerAllowance ?? 0,
        housingAllowance: s.housingAllowance ?? 0,
      });
      staff = await fetchStaff();
      renderStaff(); renderPunch();
      alert(`${s.name} を ${EMP_LABEL[type]} に設定しました。${wageNoteFor(type, s)}（休憩：${breakModeLabel(s)}／管理者手当：${yen(s.managerAllowance || 0)}円／住宅手当：${yen(s.housingAllowance || 0)}円）`);
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    }
  }

  $('addStaffBtn').onclick = async () => {
    const name = prompt('スタッフの名前を入力してください');
    if (!name || !name.trim()) return;
    const s = { name: name.trim() };
    const type = promptEmpType(s);
    if (type === null) return;
    if (isHourlyType(type) || isMonthlyType(type) || type === 'fulltime-base') {
      if (!(await requireAdmin())) { alert('時給・月給・基本日給の設定には管理者パスワードが必要です。'); return; }
      renderAdminBar();
      if (!promptWagesFor(type, s)) return;
      if (!promptBreakMode(s)) return;
      if (!promptManagerAllowance(s)) return;
      if (!promptHousingAllowance(s)) return;
    }
    s.type = type;
    try {
      await insertStaff({
        name: s.name,
        type: s.type,
        hourlyWage: s.hourlyWage ?? null,
        monthlyWage: s.monthlyWage ?? null,
        dailyWage: s.dailyWage ?? null,
        commuteAllowance: s.commuteAllowance ?? 0,
        commuteType: s.commuteType || 'monthly',
        breakMode: s.breakMode || 'punch',
        breakFixedMinutes: s.breakFixedMinutes ?? null,
        managerAllowance: s.managerAllowance ?? 0,
        housingAllowance: s.housingAllowance ?? 0,
      });
      staff = await fetchStaff();
      renderStaff();
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    }
  };

  // ── 状態判定 ──
  // 日をまたぐ遅番などで前日付けのまま退勤していないレコードがあれば、それを優先して「現在の状態」とする
  function todayRec(staffId) {
    const recs = todayLog.filter(r => r.staffId === staffId);
    return recs.find(r => !r.out) || recs.find(r => r.date === dateKey()) || recs[0];
  }
  function statusOf(rec) {
    if (!rec || !rec.in) return 'before';        // 未出勤
    if (rec.out) return 'done';                  // 退勤済み
    const lastBreak = rec.breaks[rec.breaks.length - 1];
    if (lastBreak && !lastBreak.end) return 'break'; // 休憩中
    const leaves = rec.leaves || [];
    const lastLeave = leaves[leaves.length - 1];
    if (lastLeave && !lastLeave.end) return 'away'; // 時間内退勤中
    return 'working';                            // 勤務中
  }
  const STATUS_LABEL = { before: '未出勤', working: '勤務中', break: '休憩中', away: '時間内退勤中', done: '退勤済み' };
  const SHIFT_LABEL = { normal: '普通番', late: '遅番', part: 'パート' };

  // ── 雇用区分（正社員＝日給＋歩合／パート・正社員(時給)＝時給制／正社員(月給)＝固定給／正社員(基本給のみ)＝日給のみ・歩合なし） ──
  const EMP_LABEL = { fulltime: '正社員', part: 'パート', 'fulltime-hourly': '正社員（時給）', monthly: '正社員（月給）', 'fulltime-base': '正社員（基本給のみ）', 'monthly-commission': '正社員（月給＋歩合）' };
  // 時給制（時間給×実働＋割増＋交通費）で計算する区分か。パートと「正社員だが時給制」の両方が該当
  function isHourlyType(t) { return t === 'part' || t === 'fulltime-hourly'; }
  function isMonthlyType(t) { return t === 'monthly' || t === 'monthly-commission'; }
  // シフト選択なしの単一出勤ボタンを使う区分（時給制・月給制）
  function usesSimplePunch(t) { return isHourlyType(t) || isMonthlyType(t); }
  // 歩合給（売上連動）を計算する区分か。通常の正社員と「月給＋歩合」が対象
  function hasCommission(t) { return t === 'fulltime' || t === 'monthly-commission'; }
  const OT_RATE = 0.25;    // 残業割増率（8時間超）
  const NIGHT_RATE = 0.25; // 深夜割増率（22時以降）
  const NIGHT_START_HOUR = 22;

  function staffType(s) {
    const t = s && s.type;
    return (t === 'part' || t === 'fulltime-hourly' || t === 'monthly' || t === 'fulltime-base' || t === 'monthly-commission') ? t : 'fulltime';
  }
  // 電話番チェック欄を出すかどうか。正社員（シフト制）は既定で表示（phoneDutyDisabledで個別に非表示）、
  // パート・時給制・月給制（シンプル打刻）は既定で非表示（phoneDutyEnabledで個別に表示）
  function staffPhoneDutyAvailable(s) {
    if (!s) return false;
    return usesSimplePunch(staffType(s)) ? !!s.phoneDutyEnabled : !s.phoneDutyDisabled;
  }
  function recEmpType(rec) {
    if (rec.empType) return rec.empType;
    return staffType(staff.find(x => x.id === rec.staffId));
  }
  function recHourlyWage(rec) {
    if (rec.hourlyWage != null) return rec.hourlyWage;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.hourlyWage != null) ? s.hourlyWage : settings.minWage;
  }
  function recMonthlyWage(rec) {
    if (rec.monthlyWage != null) return rec.monthlyWage;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.monthlyWage != null) ? s.monthlyWage : 0;
  }
  function recCommute(rec) {
    if (rec.commute != null) return rec.commute;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.commuteAllowance != null) ? s.commuteAllowance : 0;
  }
  // 交通費の支給方式。'monthly'＝出勤日数に関わらず月額を1回だけ支給（既定）／'daily'＝出勤日数分だけ日額を毎日加算
  function recCommuteType(rec) {
    if (rec.commuteType) return rec.commuteType;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.commuteType) ? s.commuteType : 'monthly';
  }
  // 休憩の記録方式。'punch'＝休憩開始/終了ボタンで打刻（既定）／'fixed'＝毎日固定分数を自動控除／'manual'＝管理者が日ごとに手入力
  function recBreakMode(rec) {
    if (rec.breakMode) return rec.breakMode;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.breakMode) ? s.breakMode : 'punch';
  }
  function recBreakFixedMinutes(rec) {
    if (rec.breakFixedMinutes != null) return rec.breakFixedMinutes;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.breakFixedMinutes != null) ? s.breakFixedMinutes : 60;
  }
  // 22時以降の勤務分（分）。退勤時刻ベースの近似（22時以降の休憩は考慮しない）
  function nightMinutes(rec) {
    if (!rec.out) return 0;
    const out = new Date(rec.out);
    const t22 = new Date(out);
    t22.setHours(NIGHT_START_HOUR, 0, 0, 0);
    return Math.max(0, Math.round((out - t22) / 60000));
  }

  function renderPunch() {
    const panel = $('punchPanel');
    if (!selectedId) { panel.hidden = true; return; }
    const s = staff.find(x => x.id === selectedId);
    if (!s) { panel.hidden = true; return; }
    panel.hidden = false;
    // 選択中ラベルは表示を簡略化（正社員（時給）／正社員（月給）は単に「正社員」と表示。区分自体・計算方法は変更なし）
    const SIMPLIFIED_PUNCH_TYPES = ['fulltime-hourly', 'monthly', 'fulltime-base'];
    const punchLabel = SIMPLIFIED_PUNCH_TYPES.includes(staffType(s)) ? '正社員' : EMP_LABEL[staffType(s)];
    $('selectedName').textContent = `${s.name}（${punchLabel}）`;
    const rec = todayRec(selectedId);
    const st = statusOf(rec);
    const shiftNote = rec && rec.shiftType
      ? '（' + (rec.shiftType === 'part' ? EMP_LABEL[recEmpType(rec)] : SHIFT_LABEL[rec.shiftType]) + '）'
      : '';
    $('statusLabel').textContent = `現在：${STATUS_LABEL[st]}${shiftNote}`;

    const isSimple = usesSimplePunch(staffType(s));
    $('phoneDutyBlock').hidden = !staffPhoneDutyAvailable(s);
    $('fulltimeShiftGrid').hidden = isSimple;
    $('fulltimeShiftGrid').classList.toggle('kt-shift-grid--single', !!s.lateShiftDisabled);
    $('punchInLate').hidden = !!s.lateShiftDisabled;
    $('partShiftGrid').hidden = !isSimple;

    const canPunchIn = st === 'before';
    $('shiftSelect').hidden = !canPunchIn;
    $('punchGrid').hidden = canPunchIn;

    $('punchOut').disabled = st !== 'working';
    const usesBreakButtons = (s.breakMode || 'punch') === 'punch';
    $('punchBreakStart').hidden = !usesBreakButtons;
    $('punchBreakEnd').hidden = !usesBreakButtons;
    $('punchBreakStart').disabled = st !== 'working';
    $('punchBreakEnd').disabled = st !== 'break';
    $('punchAwayStart').disabled = st !== 'working';
    $('punchAwayEnd').disabled = st !== 'away';

    $('undoBtn').hidden = !lastActions.has(selectedId);
  }

  // 給与計算条件を出勤時点でレコードに固定するためのスナップショット（後から区分や時給・交通費を変えても過去分に影響しない）
  function buildEmploymentSnapshot(s) {
    const empType = staffType(s);
    const snap = {
      empType,
      commute: s.commuteAllowance != null ? s.commuteAllowance : 0,
      commuteType: s.commuteType || 'monthly',
      breakMode: s.breakMode || 'punch',
      breakFixedMinutes: s.breakFixedMinutes != null ? s.breakFixedMinutes : 60,
      managerAllowance: s.managerAllowance != null ? s.managerAllowance : 0,
      housingAllowance: s.housingAllowance != null ? s.housingAllowance : 0,
    };
    if (isHourlyType(empType)) snap.hourlyWage = s.hourlyWage != null ? s.hourlyWage : settings.minWage;
    if (isMonthlyType(empType)) snap.monthlyWage = s.monthlyWage != null ? s.monthlyWage : 0;
    if (s.dailyWage != null) snap.dailyWage = s.dailyWage;
    return snap;
  }
  async function punchIn(shiftType) {
    if (!selectedId) return;
    const s = staff.find(x => x.id === selectedId);
    if (!s) return;
    const now = new Date().toISOString();
    const existing = todayRec(selectedId);
    const patch = {
      staffId: selectedId,
      date: dateKey(),
      in: now,
      shiftType,
      phoneDuty: staffPhoneDutyAvailable(s) ? $('phoneDutyCheck').checked : false,
      ...buildEmploymentSnapshot(s),
    };
    if (!existing) { patch.breaks = []; patch.leaves = []; }

    const shiftBtnIds = ['punchInNormal', 'punchInLate', 'punchInPart'];
    shiftBtnIds.forEach(id => { $(id).disabled = true; });
    let punchedIn = false;
    try {
      await upsertAttendance(patch);
      await refreshData();
      armUndo(selectedId, dateKey(), existing ? { ...existing } : null);
      const msg = shiftType === 'part'
        ? `✅ ${s.name} さんが出勤しました（${timeStr(now)}）`
        : `✅ ${s.name} さんが${SHIFT_LABEL[shiftType]}で出勤しました（${timeStr(now)}）`;
      $('punchMsg').textContent = msg;
      $('staffMsg').textContent = msg;
      $('phoneDutyCheck').checked = false;
      punchedIn = true;
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    } finally {
      shiftBtnIds.forEach(id => { $(id).disabled = false; });
    }
    // 出勤後は名前の選択を解除し、次の人がすぐ選べるようスタッフ一覧まで戻す
    if (punchedIn) selectedId = null;
    renderStaff(); renderPunch(); renderToday(); renderHist(); renderWage();
    if (punchedIn) $('staffList').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ── 退勤・売上入力モーダル ──
  const CONSUMPTION_TAX_RATE = 0.10; // 消費税率（標準10%）
  function taxExcluded(gross) {
    return Math.round(gross / (1 + CONSUMPTION_TAX_RATE));
  }
  let salesModalExcludesSharedRide = false; // 開いている対象が乗合分を歩合から除外する設定かどうか
  function updateSalesNetPreview() {
    const gross = parseFloat($('salesTotalInput').value);
    const net = (!isNaN(gross) && gross >= 0) ? taxExcluded(gross) : 0;
    $('salesNetPreview').textContent = `税抜：${yen(net)}円（歩合給の計算に使用）`;
    let commissionBaseNet = net;
    if (salesModalExcludesSharedRide) {
      const sharedRaw = parseFloat($('salesSharedRideInput').value);
      const sharedNet = (!isNaN(sharedRaw) && sharedRaw >= 0) ? taxExcluded(sharedRaw) : 0;
      commissionBaseNet = Math.max(0, net - sharedNet);
    }
    $('salesCommissionAuto').textContent = `${yen(Math.round(commissionBaseNet * (settings.commissionRate / 100)))}円`;
  }
  let salesModalTargetKey = null; // "staffId|date" 形式で編集対象を保持

  function openSalesModal(staffId, date) {
    const rec = log.find(r => r.staffId === staffId && r.date === date);
    if (!rec) return;
    salesModalTargetKey = `${staffId}|${date}`;
    const s = staff.find(x => x.id === staffId);
    $('salesModalStaff').textContent = `${s ? s.name : '（削除済み）'} さん・${date.slice(5).replace('-', '/')}`;
    $('salesTotalInput').value = rec.salesGross != null ? rec.salesGross : (rec.sales != null ? rec.sales : '');
    $('salesUncollectedInput').value = rec.uncollected != null ? rec.uncollected : '';
    $('salesCommissionOverride').value = rec.commissionOverride != null ? rec.commissionOverride : '';
    salesModalExcludesSharedRide = !!(s && s.commissionExcludesSharedRide);
    $('salesSharedRideBlock').hidden = !salesModalExcludesSharedRide;
    $('salesSharedRideInput').value = rec.sharedRideSalesGross != null ? rec.sharedRideSalesGross : '';
    updateSalesNetPreview();
    $('salesModal').hidden = false;
    $('salesTotalInput').focus();
  }
  function closeSalesModal() {
    $('salesModal').hidden = true;
    salesModalTargetKey = null;
  }
  $('salesModal').addEventListener('click', (e) => {
    if (e.target.id === 'salesModal') closeSalesModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !$('salesModal').hidden) closeSalesModal();
  });
  async function saveSalesModal() {
    if (!salesModalTargetKey) { closeSalesModal(); return; }
    const [staffId, date] = salesModalTargetKey.split('|');
    const rec = log.find(r => r.staffId === staffId && r.date === date);
    if (!rec) { closeSalesModal(); return; }

    const gross = parseFloat($('salesTotalInput').value);
    if (isNaN(gross) || gross < 0) {
      alert('売上合計（税込）を入力してください。');
      return;
    }
    const uncollectedRaw = parseFloat($('salesUncollectedInput').value);
    const overrideRaw = parseFloat($('salesCommissionOverride').value);
    const sharedRideRaw = parseFloat($('salesSharedRideInput').value);
    const patch = {
      staffId, date,
      salesGross: gross,
      sales: taxExcluded(gross),
      uncollected: (!isNaN(uncollectedRaw) && uncollectedRaw >= 0) ? uncollectedRaw : 0,
      // 空欄なら自動計算に戻す（nullを保存）
      commissionOverride: (!isNaN(overrideRaw) && overrideRaw >= 0) ? overrideRaw : null,
      sharedRideSalesGross: (!isNaN(sharedRideRaw) && sharedRideRaw >= 0) ? sharedRideRaw : null,
    };
    $('salesModalSubmit').disabled = true;
    try {
      await upsertAttendance(patch);
      await refreshData();
      closeSalesModal();
      renderHist(); renderWage();
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    } finally {
      $('salesModalSubmit').disabled = false;
    }
  }
  $('salesModalSubmit').onclick = () => saveSalesModal();
  $('salesModalCancel').onclick = () => closeSalesModal();
  $('salesTotalInput').addEventListener('input', updateSalesNetPreview);
  $('salesSharedRideInput').addEventListener('input', updateSalesNetPreview);

  // ── 打刻の手入力モーダル（電波障害等で打刻できなかった分をあとから入力） ──
  function timeInputToIso(dateStr, timeStr) {
    if (!dateStr || !timeStr) return null;
    return new Date(`${dateStr}T${timeStr}:00`).toISOString();
  }
  function isoToTimeInput(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }
  function fillManualEntryStaffOptions() {
    const sel = $('manualEntryStaff');
    sel.innerHTML = '';
    for (const s of staff) {
      const opt = document.createElement('option');
      opt.value = s.id;
      opt.textContent = s.name;
      sel.appendChild(opt);
    }
  }
  // 通常の打刻手入力は必ずシフト区分を選ぶため、shiftTypeが無い記録は「歩合給のみ」で作った記録とみなす
  function isCommissionOnlyRec(rec) {
    return !!rec && !rec.shiftType;
  }
  function updateManualEntryMode() {
    const commissionOnly = $('manualEntryCommissionOnly').checked;
    $('manualEntryShiftFields').hidden = commissionOnly;
    $('manualEntrySalesBlock').hidden = !commissionOnly;
  }
  async function loadManualEntryForDate() {
    const staffId = $('manualEntryStaff').value;
    const date = $('manualEntryDate').value;
    if (!staffId || !date) return;
    let rec = null;
    try {
      rec = await fetchOne(staffId, date);
    } catch (e) {
      alert(SAVE_FAIL_MSG);
      return;
    }
    if (rec && isCommissionOnlyRec(rec)) {
      $('manualEntryExisting').textContent = '※ この日はすでに「歩合給のみ」の記録があります。内容を修正して保存できます。';
      $('manualEntryCommissionOnly').checked = true;
      $('manualEntrySalesInput').value = rec.salesGross != null ? rec.salesGross : '';
    } else if (rec) {
      $('manualEntryExisting').textContent = '※ この日はすでに記録があります。内容を修正して保存できます。';
      $('manualEntryCommissionOnly').checked = false;
      const radio = document.querySelector(`input[name="manualEntryShift"][value="${rec.shiftType || 'normal'}"]`);
      if (radio) radio.checked = true;
      $('manualEntryPhoneDuty').checked = !!rec.phoneDuty;
      $('manualEntryIn').value = isoToTimeInput(rec.in);
      $('manualEntryOut').value = isoToTimeInput(rec.out);
      const firstBreak = (rec.breaks || [])[0];
      $('manualEntryBreakStart').value = firstBreak ? isoToTimeInput(firstBreak.start) : '';
      $('manualEntryBreakEnd').value = firstBreak ? isoToTimeInput(firstBreak.end) : '';
      const firstLeave = (rec.leaves || [])[0];
      $('manualEntryAwayStart').value = firstLeave ? isoToTimeInput(firstLeave.start) : '';
      $('manualEntryAwayEnd').value = firstLeave ? isoToTimeInput(firstLeave.end) : '';
      $('manualEntrySalesInput').value = '';
    } else {
      $('manualEntryExisting').textContent = 'この日はまだ記録がありません（新規に追加します）。';
      $('manualEntryCommissionOnly').checked = false;
      document.querySelector('input[name="manualEntryShift"][value="normal"]').checked = true;
      $('manualEntryPhoneDuty').checked = false;
      $('manualEntryIn').value = '';
      $('manualEntryOut').value = '';
      $('manualEntryBreakStart').value = '';
      $('manualEntryBreakEnd').value = '';
      $('manualEntryAwayStart').value = '';
      $('manualEntryAwayEnd').value = '';
      $('manualEntrySalesInput').value = '';
    }
    updateManualEntryMode();
  }
  function openManualEntryModal(prefill) {
    fillManualEntryStaffOptions();
    $('manualEntryDate').value = (prefill && prefill.date) || dateKey();
    if (prefill && prefill.staffId) $('manualEntryStaff').value = prefill.staffId;
    $('manualEntryModal').hidden = false;
    loadManualEntryForDate();
  }
  function closeManualEntryModal() {
    $('manualEntryModal').hidden = true;
  }
  async function saveManualEntry() {
    const staffId = $('manualEntryStaff').value;
    const date = $('manualEntryDate').value;
    if (!staffId || !date) { alert('スタッフと日付を指定してください。'); return; }
    const s = staff.find(x => x.id === staffId);
    if (!s) return;

    let existing = null;
    try {
      existing = await fetchOne(staffId, date);
    } catch (e) {
      alert(SAVE_FAIL_MSG);
      return;
    }

    let patch;
    if ($('manualEntryCommissionOnly').checked) {
      // 歩合給のみ：出勤の実態は無いので、集計対象になるための便宜上の時刻（正午）を出退勤両方に入れる
      // （シフト区分をnullにすることで、基本給・実働時間は発生しない。歩合給だけが売上から自動計算される）
      const gross = parseFloat($('manualEntrySalesInput').value);
      if (isNaN(gross) || gross < 0) { alert('売上合計（税込）を入力してください。'); return; }
      const noonIso = timeInputToIso(date, '12:00');
      patch = {
        staffId, date,
        in: noonIso, out: noonIso,
        shiftType: null,
        phoneDuty: false,
        breaks: [],
        leaves: [],
        salesGross: gross,
        sales: taxExcluded(gross),
      };
    } else {
      const shiftType = document.querySelector('input[name="manualEntryShift"]:checked').value;
      const inIso = timeInputToIso(date, $('manualEntryIn').value);
      const outIso = timeInputToIso(date, $('manualEntryOut').value);
      if (!inIso) { alert('出勤時刻を入力してください。'); return; }
      if (outIso && new Date(outIso) < new Date(inIso)) {
        alert('退勤時刻が出勤時刻より前になっています。時刻を確認してください。');
        return;
      }
      const breakStartIso = timeInputToIso(date, $('manualEntryBreakStart').value);
      const breakEndIso = timeInputToIso(date, $('manualEntryBreakEnd').value);
      const breaks = breakStartIso ? [{ start: breakStartIso, end: breakEndIso || null }] : [];
      const awayStartIso = timeInputToIso(date, $('manualEntryAwayStart').value);
      const awayEndIso = timeInputToIso(date, $('manualEntryAwayEnd').value);
      const leaves = awayStartIso ? [{ start: awayStartIso, end: awayEndIso || null }] : [];
      patch = {
        staffId, date,
        in: inIso,
        out: outIso || null,
        shiftType,
        phoneDuty: $('manualEntryPhoneDuty').checked,
        breaks,
        leaves,
      };
    }
    // 既存記録が無い場合のみ、現在のスタッフ設定を給与計算条件としてスナップショットする
    // （既存記録がある場合は、出勤当時のスナップショットを上書きしないよう触らない）
    if (!existing) Object.assign(patch, buildEmploymentSnapshot(s));

    $('manualEntrySubmit').disabled = true;
    try {
      await upsertAttendance(patch);
      await refreshData();
      renderStaff(); renderPunch(); renderToday(); renderHist(); renderWage();
      alert(`${s.name} さんの${date.slice(5).replace('-', '/')}分の打刻を保存しました。`);
      closeManualEntryModal();
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    } finally {
      $('manualEntrySubmit').disabled = false;
    }
  }
  $('manualEntryOpenBtn').onclick = () => openManualEntryModal();
  $('manualEntryCancel').onclick = () => closeManualEntryModal();
  $('manualEntrySubmit').onclick = () => saveManualEntry();
  $('manualEntryStaff').addEventListener('change', loadManualEntryForDate);
  $('manualEntryDate').addEventListener('change', loadManualEntryForDate);
  $('manualEntryCommissionOnly').addEventListener('change', updateManualEntryMode);

  async function punch(type) {
    if (!selectedId) return;
    const rec = todayRec(selectedId);
    if (!rec) return;
    const s = staff.find(x => x.id === selectedId);
    if (!s) return;
    const now = new Date().toISOString();
    const breaks = [...(rec.breaks || [])];
    const leaves = [...(rec.leaves || [])];
    // 日をまたぐ遅番など、レコードが前日付けのままの場合もあるため、そのレコード自身の日付を使う（今日の日付ではない）
    const patch = { staffId: selectedId, date: rec.date };

    if (type === 'out') {
      patch.out = now;
    } else if (type === 'breakStart') {
      breaks.push({ start: now, end: null });
      patch.breaks = breaks;
    } else if (type === 'breakEnd') {
      const b = breaks[breaks.length - 1];
      if (b && !b.end) b.end = now;
      patch.breaks = breaks;
    } else if (type === 'awayStart') {
      leaves.push({ start: now, end: null });
      patch.leaves = leaves;
    } else if (type === 'awayEnd') {
      const l = leaves[leaves.length - 1];
      if (l && !l.end) l.end = now;
      patch.leaves = leaves;
    }

    const btnIds = ['punchOut', 'punchBreakStart', 'punchBreakEnd', 'punchAwayStart', 'punchAwayEnd'];
    btnIds.forEach(id => { $(id).disabled = true; });
    let punchedOut = false;
    try {
      await upsertAttendance(patch);
      await refreshData();
      armUndo(selectedId, rec.date, { ...rec });
      if (type === 'out') {
        let msg = `✅ ${s.name} さんの退勤を ${timeStr(now)} に記録しました。売上は後ほど管理者が入力します。`;
        if (isAdmin()) {
          const handle = await getExcelHandle();
          if (handle) {
            const result = await syncUnsyncedToExcel(false);
            if (result.ok && result.count) msg += `（Excelにも自動記録しました）`;
          }
        }
        $('punchMsg').textContent = msg;
        $('staffMsg').textContent = msg;
        punchedOut = true;
      } else {
        const labels = { breakStart: '休憩開始', breakEnd: '休憩終了', awayStart: '時間内退勤', awayEnd: '時間内出勤' };
        $('punchMsg').textContent = `✅ ${s.name} さんの${labels[type]}を ${timeStr(now)} に記録しました`;
      }
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    }
    // 退勤後は名前の選択を解除し、次の人がすぐ選べるようスタッフ一覧まで戻す
    if (punchedOut) selectedId = null;
    renderStaff(); renderPunch(); renderToday(); renderHist(); renderWage();
    if (punchedOut) $('staffList').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('punchInNormal').onclick = () => punchIn('normal');
  $('punchInLate').onclick = () => punchIn('late');
  $('punchInPart').onclick = () => punchIn('part');
  $('punchOut').onclick = () => punch('out');
  $('punchBreakStart').onclick = () => punch('breakStart');
  $('punchBreakEnd').onclick = () => punch('breakEnd');
  $('punchAwayStart').onclick = () => punch('awayStart');
  $('punchAwayEnd').onclick = () => punch('awayEnd');
  $('undoBtn').onclick = () => undoLastAction();

  // ── 実働計算 ──
  function workMinutes(rec) {
    if (!rec.in) return null;
    const end = rec.out ? new Date(rec.out) : new Date();
    let ms = end - new Date(rec.in);
    ms -= breakMinutes(rec) * 60000;
    for (const l of (rec.leaves || [])) {
      const lEnd = l.end ? new Date(l.end) : new Date();
      ms -= (lEnd - new Date(l.start));
    }
    return Math.max(0, Math.round(ms / 60000));
  }
  function breakMinutes(rec) {
    const mode = recBreakMode(rec);
    if (mode === 'fixed') return recBreakFixedMinutes(rec);
    if (mode === 'manual') return rec.manualBreakMinutes != null ? rec.manualBreakMinutes : 0;
    let ms = 0;
    for (const b of rec.breaks) {
      const bEnd = b.end ? new Date(b.end) : new Date();
      ms += (bEnd - new Date(b.start));
    }
    return Math.round(ms / 60000);
  }
  function awayMinutes(rec) {
    let ms = 0;
    for (const l of (rec.leaves || [])) {
      const lEnd = l.end ? new Date(l.end) : new Date();
      ms += (lEnd - new Date(l.start));
    }
    return Math.round(ms / 60000);
  }
  function hm(min) {
    if (min === null) return '—';
    return `${Math.floor(min / 60)}:${String(min % 60).padStart(2, '0')}`;
  }

  // ── 給与計算 ──
  // 個人固定の基本日給（シフトに関わらず一定）。未設定なら会社共通の設定値を使用
  function recDailyWage(rec) {
    if (rec.dailyWage != null) return rec.dailyWage;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.dailyWage != null) ? s.dailyWage : null;
  }
  // シフト日給。shiftWage()は時給制・月給制のスタッフでは使われない（payParts側で分岐済み）ため、
  // ここでのshiftType==='part'は「正社員・正社員(基本給のみ)がパート枠のシフトに入った」ケースを指し、
  // 日給0円ではなく通常通りの日給（個人設定の日給優先）を支給する
  function shiftWage(rec) {
    if (!rec.shiftType) return 0;
    const override = recDailyWage(rec);
    let w = override != null ? override : (rec.shiftType === 'late' ? (settings.lateWage + settings.lateBonus) : settings.normalWage);
    if (rec.phoneDuty) w += settings.phoneAllowance;
    return w;
  }
  // 歩合給＝売上税抜 × 歩合率。手修正額が入っている日はその金額を優先する。
  // 乗合分を歩合から除外する設定のスタッフ（commissionExcludesSharedRide）は、
  // その日の乗合分の売上（税込→税抜換算）を計算基礎から差し引く（売上合計自体は変えない）
  function commissionBase(rec) {
    let base = Math.max(0, rec.sales);
    const s = staff.find(x => x.id === rec.staffId);
    if (s && s.commissionExcludesSharedRide && rec.sharedRideSalesGross) {
      base = Math.max(0, base - taxExcluded(rec.sharedRideSalesGross));
    }
    return base;
  }
  function commissionPay(rec) {
    if (rec.commissionOverride != null) return rec.commissionOverride;
    if (rec.sales == null) return 0;
    return commissionBase(rec) * (settings.commissionRate / 100);
  }
  // 区分ごとの内訳。base＝基本給（正社員：シフト日給＋電話番手当／パート：時給×実働＋電話番手当）
  // extra＝歩合・手当（正社員：歩合給／パート：残業・深夜割増）＋日額交通費（daily指定のスタッフのみ）。
  // 月額交通費（既定）は日々の内訳には含めない（monthlyCommuteで月に一度だけ加算）
  function payParts(rec) {
    const dailyCommute = (rec.in && recCommuteType(rec) === 'daily') ? recCommute(rec) : 0;
    if (isHourlyType(recEmpType(rec))) {
      const min = workMinutes(rec) || 0;
      const hw = recHourlyWage(rec);
      // パート・時給制でも電話番チェック欄が有効な人（phoneDutyEnabled）は、担当した日に手当を加算する
      const phoneAllowance = rec.phoneDuty ? settings.phoneAllowance : 0;
      const base = Math.round(hw * min / 60) + phoneAllowance;
      const ot = Math.round(Math.max(0, min / 60 - 8) * hw * OT_RATE);
      const night = Math.round(nightMinutes(rec) / 60 * hw * NIGHT_RATE);
      return { base, extra: ot + night + dailyCommute, ot, night };
    }
    const commission = hasCommission(recEmpType(rec)) ? commissionPay(rec) : 0;
    return { base: shiftWage(rec), extra: commission + dailyCommute, ot: 0, night: 0 };
  }
  // 交通費(月額)は出勤日数に関わらず、その月に打刻があれば一度だけ加算。日額指定のスタッフは既にpayParts側で日々加算済みなので0を返す
  function monthlyCommute(recsInMonth) {
    const rec = recsInMonth.find(r => r.commute != null) || recsInMonth[0];
    if (!rec || recCommuteType(rec) === 'daily') return 0;
    return recCommute(rec);
  }
  // 管理者手当（運行管理者補助者手当＋整備管理者(補助者)手当を合算した月額）。出勤日数に関わらずその月に打刻があれば一度だけ加算
  function recManagerAllowance(rec) {
    if (rec.managerAllowance != null) return rec.managerAllowance;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.managerAllowance != null) ? s.managerAllowance : 0;
  }
  function monthlyManagerAllowance(recsInMonth) {
    const rec = recsInMonth.find(r => r.managerAllowance != null) || recsInMonth[0];
    if (!rec) return 0;
    return recManagerAllowance(rec);
  }
  // 住宅手当（月額）。管理者手当とは別枠で、同様に出勤日数に関わらずその月に打刻があれば一度だけ加算
  function recHousingAllowance(rec) {
    if (rec.housingAllowance != null) return rec.housingAllowance;
    const s = staff.find(x => x.id === rec.staffId);
    return (s && s.housingAllowance != null) ? s.housingAllowance : 0;
  }
  function monthlyHousingAllowance(recsInMonth) {
    const rec = recsInMonth.find(r => r.housingAllowance != null) || recsInMonth[0];
    if (!rec) return 0;
    return recHousingAllowance(rec);
  }
  function totalPay(rec) {
    const p = payParts(rec);
    return p.base + p.extra;
  }
  function hourlyRate(rec) {
    if (!rec.out) return null;
    if (isMonthlyType(recEmpType(rec))) return null; // 月給制は時給換算・最低賃金判定の対象外
    const min = workMinutes(rec);
    if (!min || min <= 0) return null;
    return totalPay(rec) / (min / 60);
  }
  function isBelowMinWage(rec) {
    const rate = hourlyRate(rec);
    return rate !== null && rate < settings.minWage;
  }
  function mask(text) {
    return isAdmin() ? text : '••••';
  }

  // ── 本日の状況 ──
  function renderToday() {
    const board = $('todayBoard');
    board.innerHTML = '';
    // スタッフごとに1件にまとめる。前日付けのまま退勤していない記録（日をまたぐ遅番等）があればそちらを優先する
    const byStaff = {};
    for (const r of todayLog) {
      const cur = byStaff[r.staffId];
      if (!cur || (!r.out && cur.out)) byStaff[r.staffId] = r;
    }
    const recs = Object.values(byStaff);
    $('todayEmpty').hidden = recs.length > 0;
    for (const rec of recs) {
      const s = staff.find(x => x.id === rec.staffId);
      const st = statusOf(rec);
      const div = document.createElement('div');
      div.className = `kt-today-card kt-today-card--${st}`;
      div.innerHTML = `
        <p class="kt-today-card__name">${s ? s.name : '（削除済み）'}</p>
        <p class="kt-today-card__status">${STATUS_LABEL[st]}${rec.shiftType ? '・' + (rec.shiftType === 'part' ? EMP_LABEL[recEmpType(rec)] : SHIFT_LABEL[rec.shiftType]) : ''}</p>
        <p class="kt-today-card__times">出勤 ${rec.in ? timeStr(rec.in) : '—'} ／ 退勤 ${rec.out ? timeStr(rec.out) : '—'}</p>
      `;
      board.appendChild(div);
    }
  }

  // ── 履歴 ──
  async function editManualBreak(staffId, date, currentMinutes) {
    const s = staff.find(x => x.id === staffId);
    const input = prompt(`${s ? s.name : ''}さん・${date.slice(5).replace('-', '/')} の休憩時間（分）を入力してください`, currentMinutes != null ? String(currentMinutes) : '0');
    if (input === null) return;
    const minutes = parseInt(input, 10);
    if (isNaN(minutes) || minutes < 0) { alert('休憩時間は0以上の数字で入力してください。'); return; }
    try {
      await upsertAttendance({ staffId, date, manualBreakMinutes: minutes });
      await refreshData();
      renderHist(); renderWage();
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    }
  }
  const HIST_COLSPAN = 16;
  const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
  let histOpenDates = null; // 開いている日付のSet。月を切り替えたら最新の日付だけ開いた状態にリセットする
  function toggleHistDate(date) {
    if (histOpenDates.has(date)) histOpenDates.delete(date);
    else histOpenDates.add(date);
    renderHist();
  }
  function renderHist() {
    const month = currentMonth();
    const body = $('histBody');
    body.innerHTML = '';
    const recs = log.filter(r => r.date.startsWith(month)).sort((a, b) => b.date.localeCompare(a.date));
    $('histEmpty').hidden = recs.length > 0;
    $('histTable').style.display = recs.length ? '' : 'none';

    const datesInView = [...new Set(recs.map(r => r.date))];
    if (!histOpenDates || !datesInView.some(d => histOpenDates.has(d))) {
      // 初回描画・月の切り替え時は、一番新しい日付だけ開いた状態にする
      histOpenDates = new Set(datesInView.length ? [datesInView[0]] : []);
    }

    let prevDate = null;
    for (const rec of recs) {
      if (rec.date !== prevDate) {
        prevDate = rec.date;
        const isOpen = histOpenDates.has(rec.date);
        const d = new Date(rec.date);
        const headerTr = document.createElement('tr');
        headerTr.className = 'kt-hist-daterow';
        headerTr.innerHTML = `<td colspan="${HIST_COLSPAN}"><span class="kt-hist-daterow__label"><span class="kt-hist-daterow__toggle">${isOpen ? '▼' : '▶'}</span> ${rec.date.slice(5).replace('-', '/')}（${WEEKDAYS[d.getDay()]}）</span></td>`;
        headerTr.onclick = () => toggleHistDate(rec.date);
        body.appendChild(headerTr);
      }
      if (!histOpenDates.has(rec.date)) continue;
      const s = staff.find(x => x.id === rec.staffId);
      const w = rec.out ? workMinutes(rec) : null;
      const belowMin = isAdmin() && isBelowMinWage(rec);
      const rate = hourlyRate(rec);
      const isSimple = usesSimplePunch(recEmpType(rec));
      const showsSales = hasCommission(recEmpType(rec));
      const p = payParts(rec);
      const kubun = isSimple
        ? EMP_LABEL[recEmpType(rec)]
        : (rec.shiftType ? SHIFT_LABEL[rec.shiftType] + (rec.phoneDuty ? '＋電話番' : '') : '—');
      const tr = document.createElement('tr');
      if (belowMin) tr.className = 'kt-table__row--warn';
      tr.innerHTML = `
        <td>${rec.date.slice(5).replace('-', '/')}</td>
        <td>${s ? s.name : '（削除済み）'}</td>
        <td>${kubun}</td>
        <td>${rec.in ? timeStr(rec.in) : '—'}</td>
        <td>${rec.out ? timeStr(rec.out) : '—'}</td>
        <td>${hm(breakMinutes(rec))}</td>
        <td>${hm(awayMinutes(rec))}</td>
        <td class="kt-table__work">${rec.out ? hm(w) : '勤務中'}</td>
        <td>${showsSales ? mask(rec.salesGross != null ? yen(rec.salesGross) + '円' : (rec.sales != null ? yen(rec.sales) + '円' : '—')) : '—'}</td>
        <td>${showsSales ? mask(rec.uncollected ? yen(rec.uncollected) + '円' : '—') : '—'}</td>
        <td>${mask(rec.out || rec.shiftType ? yen(p.base) + '円' : '—')}</td>
        <td>${mask(rec.out ? yen(p.extra) + '円' : '—')}</td>
        <td class="kt-table__total">${rec.out ? mask(yen(totalPay(rec)) + '円') : '—'}</td>
        <td>${mask(rate !== null ? yen(rate) + '円' + (belowMin ? ' ⚠️最低賃金未満' : '') : '—')}</td>
        <td></td>
      `;
      if (rec.out && showsSales) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'kt-btn kt-btn--ghost';
        btn.textContent = rec.sales != null ? '売上を修正' : '売上を入力';
        btn.onclick = () => openSalesModal(rec.staffId, rec.date);
        tr.lastElementChild.appendChild(btn);
      }
      if (recBreakMode(rec) === 'manual') {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'kt-btn kt-btn--ghost';
        btn.textContent = rec.manualBreakMinutes != null ? '休憩を修正' : '休憩を入力';
        btn.onclick = () => editManualBreak(rec.staffId, rec.date, rec.manualBreakMinutes);
        tr.lastElementChild.appendChild(btn);
      }
      // 元帳から取り込んだ運行実績がある行は、クリックで詳細を開けるようにする
      if (hasOperationDetail(rec)) {
        tr.classList.add('kt-hist-row--hasdetail');
        tr.title = 'クリックで運行実績を表示';
        tr.onclick = (e) => {
          if (e.target.closest('button')) return; // 操作ボタンのクリックは無視
          toggleHistDetail(rec.staffId + '|' + rec.date);
        };
      }
      body.appendChild(tr);

      if (hasOperationDetail(rec) && histOpenDetails.has(rec.staffId + '|' + rec.date)) {
        const detailTr = document.createElement('tr');
        detailTr.className = 'kt-hist-detailrow';
        detailTr.innerHTML = `<td colspan="${HIST_COLSPAN}"><span class="kt-hist-detailrow__inner">${operationDetailHtml(rec)}</span></td>`;
        body.appendChild(detailTr);
      }
    }
  }

  // ── 運行実績の詳細（元帳から取り込んだ項目。給与計算には使わない） ──
  let histOpenDetails = new Set();
  function toggleHistDetail(key) {
    if (histOpenDetails.has(key)) histOpenDetails.delete(key);
    else histOpenDetails.add(key);
    renderHist();
  }
  function hasOperationDetail(rec) {
    return rec.distanceKm != null || rec.actualDistanceKm != null
      || rec.transportCount != null || rec.transportPersons != null
      || rec.fuelLiters != null || rec.fuelAmount != null
      || rec.disabilityCount != null || rec.disabilityDiscount != null
      || !!rec.sharedRideSalesGross;
  }
  function operationDetailHtml(rec) {
    const items = [
      ['走行距離', rec.distanceKm != null ? `${yen(rec.distanceKm)}km` : null],
      ['実車距離', rec.actualDistanceKm != null ? `${yen(rec.actualDistanceKm)}km` : null],
      ['実車率', (rec.distanceKm && rec.actualDistanceKm) ? `${Math.round(rec.actualDistanceKm / rec.distanceKm * 100)}%` : null],
      ['輸送回数', rec.transportCount != null ? `${yen(rec.transportCount)}回` : null],
      ['輸送人数', rec.transportPersons != null ? `${yen(rec.transportPersons)}人` : null],
      ['給油量', rec.fuelLiters != null ? `${rec.fuelLiters}L` : null],
      ['給油金額', rec.fuelAmount != null ? `${yen(rec.fuelAmount)}円` : null],
      ['障がい回数', rec.disabilityCount != null ? `${yen(rec.disabilityCount)}回` : null],
      ['身障者割引', rec.disabilityDiscount != null ? `${yen(rec.disabilityDiscount)}円` : null],
      ['乗合分の売上（税込）', rec.sharedRideSalesGross ? `${yen(rec.sharedRideSalesGross)}円` : null],
    ].filter(([, v]) => v !== null);
    return items.map(([k, v]) => `<span class="kt-hist-detailrow__item"><em>${k}</em>${v}</span>`).join('');
  }

  // ── 月次給与サマリー ──
  function renderWage() {
    const month = currentMonth();
    const body = $('wageBody');
    body.innerHTML = '';
    const recs = log.filter(r => r.date.startsWith(month) && r.out);
    const totals = {};
    for (const rec of recs) {
      if (!totals[rec.staffId]) totals[rec.staffId] = { days: 0, minutes: 0, wage: 0, sales: 0, commission: 0, empType: recEmpType(rec), monthlyWage: 0 };
      const t = totals[rec.staffId];
      const p = payParts(rec);
      t.days += 1;
      t.minutes += workMinutes(rec);
      t.wage += p.base;
      t.sales += (rec.sales || 0);
      t.commission += p.extra;
      if (isMonthlyType(t.empType)) t.monthlyWage = recMonthlyWage(rec);
    }
    const ids = Object.keys(totals);
    $('wageEmpty').hidden = ids.length > 0;
    $('wageTable').style.display = ids.length ? '' : 'none';
    for (const id of ids) {
      const s = staff.find(x => x.id === id);
      const t = totals[id];
      const monthRecsForStaff = log.filter(r => r.date.startsWith(month) && r.staffId === id);
      const commute = monthlyCommute(monthRecsForStaff);
      const managerAllowance = monthlyManagerAllowance(monthRecsForStaff);
      const housingAllowance = monthlyHousingAllowance(monthRecsForStaff);
      const baseDisplay = isMonthlyType(t.empType) ? t.monthlyWage : t.wage;
      const total = baseDisplay + t.commission + commute + managerAllowance + housingAllowance;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${s ? s.name : '（削除済み）'}</td>
        <td>${EMP_LABEL[t.empType]}</td>
        <td>${t.days}日</td>
        <td>${hm(t.minutes)}</td>
        <td>${mask(yen(baseDisplay) + '円')}</td>
        <td>${hasCommission(t.empType) ? mask(yen(t.sales) + '円') : '—'}</td>
        <td>${mask(yen(t.commission) + '円')}</td>
        <td>${mask(yen(commute) + '円')}</td>
        <td>${managerAllowance ? mask(yen(managerAllowance) + '円') : '—'}</td>
        <td>${housingAllowance ? mask(yen(housingAllowance) + '円') : '—'}</td>
        <td class="kt-table__total">${mask(yen(total) + '円')}</td>
      `;
      body.appendChild(tr);
    }
  }

  $('monthPick').onchange = async () => {
    try {
      log = await fetchMonth(currentMonth());
    } catch (e) {
      alert('データの取得に失敗しました。通信状況を確認してください。');
    }
    await refreshAndRenderExportStatus();
    renderHist(); renderWage();
  };

  // ── 元帳（スプレッドシート）から売上を取り込む ──
  // 元帳タブの列構成（0始まり）: [0]日付 [5]ドライバー名 [10]未収入金 [12]売上合計
  function normalizeName(s) {
    return (s || '').replace(/[ 　]/g, '');
  }
  function parseYen(s) {
    if (!s) return 0;
    const n = parseFloat(String(s).replace(/,/g, ''));
    return isNaN(n) ? 0 : n;
  }
  function parseSheetUrl(url) {
    const idMatch = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
    const gidMatch = url.match(/[?&#]gid=(\d+)/);
    if (!idMatch) return null;
    return { id: idMatch[1], gid: gidMatch ? gidMatch[1] : '0' };
  }
  // ダブルクォート内の改行・カンマに対応した簡易CSVパーサ
  function parseImportCsv(text) {
    const rows = [];
    let row = [];
    let field = '';
    let inQuotes = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inQuotes) {
        if (c === '"') {
          if (text[i + 1] === '"') { field += '"'; i++; }
          else inQuotes = false;
        } else field += c;
      } else {
        if (c === '"') inQuotes = true;
        else if (c === ',') { row.push(field); field = ''; }
        else if (c === '\r') { /* skip */ }
        else if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
        else field += c;
      }
    }
    if (field.length || row.length) { row.push(field); rows.push(row); }
    return rows;
  }
  const IMPORT_STATUS_LABEL = {
    new: '✅ そのまま取り込みOK',
    diff: '⚠️ すでに入力済み・金額が違います',
    same: '✅ 反映済み（同じ金額）',
    notfound: '❌ スタッフが見つかりません',
    norecord: '❌ 出勤の打刻がありません',
  };
  function importStatusBadgeClass(status) {
    if (status === 'new' || status === 'same') return 'kt-exportstatus__item kt-exportstatus__item--done';
    if (status === 'diff') return 'kt-exportstatus__item kt-exportstatus__item--pending';
    return 'kt-openwarn__item';
  }
  let importRows = [];
  async function fetchImportPreview() {
    const url = $('importSheetUrl').value.trim();
    const month = $('importMonth').value;
    if (!url) { alert('スプレッドシートのURLを入力してください。'); return; }
    if (!month) { alert('対象月を選択してください。'); return; }
    const parsed = parseSheetUrl(url);
    if (!parsed) { alert('URLからスプレッドシートを特定できませんでした。URLを確認してください。'); return; }

    $('importFetchBtn').disabled = true;
    try {
      const csvUrl = `https://docs.google.com/spreadsheets/d/${parsed.id}/export?format=csv&gid=${parsed.gid}`;
      const res = await fetch(csvUrl);
      if (!res.ok) throw new Error('fetch failed');
      const text = await res.text();
      const rows = parseImportCsv(text);

      // 日付・ドライバーごとに集計（同じ日に複数車両分ある場合は合算）。
      // 元帳の名前で見つかったスタッフに salesAttributedTo（売上の付け替え先）が設定されている場合は、
      // 本人ではなく付け替え先のスタッフの売上として集計する（本人の打刻・勤務履歴には影響しない）
      const agg = {};
      for (const r of rows) {
        const day = parseInt(r[0], 10);
        const rawName = (r[5] || '').trim();
        const name = normalizeName(rawName);
        if (!day || day < 1 || day > 31 || !name) continue;
        const sales = parseYen(r[12]);
        const uncollected = parseYen(r[10]);
        if (!sales) continue;

        const sourceStaff = staff.find(s => normalizeName(s.name) === name);
        const targetStaff = (sourceStaff && sourceStaff.salesAttributedTo)
          ? (staff.find(s => s.id === sourceStaff.salesAttributedTo) || sourceStaff)
          : sourceStaff;
        const key = day + '|' + (targetStaff ? targetStaff.id : ('name:' + name));
        if (!agg[key]) {
          agg[key] = {
            day, targetStaffId: targetStaff ? targetStaff.id : null, targetName: targetStaff ? targetStaff.name : null,
            rawName, sourceNames: new Set(), sales: 0, uncollected: 0, sharedRideSalesGross: 0,
            disabilityCount: 0, disabilityDiscount: 0, transportCount: 0, transportPersons: 0,
            distanceKm: 0, actualDistanceKm: 0, fuelLiters: 0, fuelAmount: 0,
          };
        }
        agg[key].sourceNames.add(rawName);
        agg[key].sales += sales;
        agg[key].uncollected += uncollected;
        // 乗合（[2]列「乗用/乗合」が「乗合」の行）の売上だけを別集計しておく。
        // 歩合から乗合分を除外する設定のスタッフだけ、この金額を計算基礎から差し引く
        if ((r[2] || '').trim() === '乗合') agg[key].sharedRideSalesGross += sales;
        // 運行実績（同じ日に複数車両分あれば合算）
        agg[key].disabilityCount += parseYen(r[14]);
        agg[key].disabilityDiscount += parseYen(r[15]);
        agg[key].transportCount += parseYen(r[16]);
        agg[key].transportPersons += parseYen(r[17]);
        agg[key].distanceKm += parseYen(r[18]);
        agg[key].actualDistanceKm += parseYen(r[19]);
        agg[key].fuelLiters += parseYen(r[22]);
        agg[key].fuelAmount += parseYen(r[23]);
      }

      const monthRecs = await fetchMonth(month);
      const results = [];
      for (const key of Object.keys(agg).sort((a, b) => agg[a].day - agg[b].day)) {
        const item = agg[key];
        const date = `${month}-${String(item.day).padStart(2, '0')}`;
        let status, applyDefault = false, staffId = item.targetStaffId, existingSales = null;
        if (!staffId) {
          status = 'notfound';
        } else {
          const existingRec = monthRecs.find(r => r.staffId === staffId && r.date === date && r.out);
          if (!existingRec) {
            status = 'norecord';
          } else if (existingRec.salesGross == null) {
            status = 'new';
            applyDefault = true;
          } else {
            // 売上金額が同じでも、乗合分・運行実績など後から追加した項目がまだ
            // 記録されていない（元帳側にはあるのにnullのまま）場合は「反映済み」扱いにしない。
            // そうしないと、以前一度取り込んだだけの日は二度と再取り込みされなくなってしまう
            const sameOr0 = (a, b) => (a || 0) === (b || 0);
            const fieldsMatch = existingRec.salesGross === item.sales
              && sameOr0(existingRec.sharedRideSalesGross, item.sharedRideSalesGross)
              && sameOr0(existingRec.distanceKm, item.distanceKm)
              && sameOr0(existingRec.actualDistanceKm, item.actualDistanceKm)
              && sameOr0(existingRec.transportCount, item.transportCount)
              && sameOr0(existingRec.transportPersons, item.transportPersons)
              && sameOr0(existingRec.fuelLiters, item.fuelLiters)
              && sameOr0(existingRec.fuelAmount, item.fuelAmount)
              && sameOr0(existingRec.disabilityCount, item.disabilityCount)
              && sameOr0(existingRec.disabilityDiscount, item.disabilityDiscount);
            if (fieldsMatch) {
              status = 'same';
            } else {
              status = 'diff';
              existingSales = existingRec.salesGross;
            }
          }
        }
        // 売上の付け替えで複数の元帳名が1人にまとまった場合、プレビューで分かるようにしておく
        const mergedNames = [...item.sourceNames].filter(n => normalizeName(n) !== normalizeName(item.targetName || ''));
        results.push({
          date, staffId, staffName: item.targetName, sheetName: item.rawName, mergedFromNames: mergedNames,
          sales: item.sales, uncollected: item.uncollected, status, applyDefault, existingSales,
          sharedRideSalesGross: item.sharedRideSalesGross,
          disabilityCount: item.disabilityCount, disabilityDiscount: item.disabilityDiscount,
          transportCount: item.transportCount, transportPersons: item.transportPersons,
          distanceKm: item.distanceKm, actualDistanceKm: item.actualDistanceKm,
          fuelLiters: item.fuelLiters, fuelAmount: item.fuelAmount,
        });
      }
      importRows = results;
      renderImportPreview();
    } catch (e) {
      alert('取り込みに失敗しました。URLが正しいか、スプレッドシートの共有設定（リンクを知っている全員が閲覧可）を確認してください。');
    } finally {
      $('importFetchBtn').disabled = false;
    }
  }
  function renderImportPreview() {
    const body = $('importPreviewBody');
    body.innerHTML = '';
    for (const row of importRows) {
      const canCheck = row.status === 'new' || row.status === 'diff';
      const checkboxHtml = canCheck
        ? `<input type="checkbox" class="importRowCheck" data-key="${row.date}|${row.staffId}" ${row.applyDefault ? 'checked' : ''} />`
        : '—';
      const sharedNote = row.sharedRideSalesGross ? `（うち乗合：${yen(row.sharedRideSalesGross)}円）` : '';
      const salesText = (row.status === 'diff'
        ? `${yen(row.sales)}円（既存：${yen(row.existingSales)}円）`
        : `${yen(row.sales)}円`) + sharedNote;
      const mergedNote = row.mergedFromNames && row.mergedFromNames.length
        ? `<br><small>（${row.mergedFromNames.join('・')}分の売上を含む）</small>` : '';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${checkboxHtml}</td>
        <td>${row.date.slice(5).replace('-', '/')}</td>
        <td>${row.staffName || row.sheetName}${mergedNote}</td>
        <td><span class="${importStatusBadgeClass(row.status)}">${IMPORT_STATUS_LABEL[row.status]}</span></td>
        <td>${salesText}</td>
        <td>${yen(row.uncollected)}円</td>
      `;
      body.appendChild(tr);
    }
    $('importPreviewWrap').hidden = importRows.length === 0;
    const hasApplyable = importRows.some(r => r.status === 'new' || r.status === 'diff');
    $('importApplyBtn').hidden = !hasApplyable;
    $('importApplyAllBtn').hidden = !hasApplyable;
  }
  $('importFetchBtn').onclick = () => fetchImportPreview();
  async function applyImportRows(rowsToApply) {
    if (!rowsToApply.length) { alert('反映する行がありません。'); return; }
    $('importApplyBtn').disabled = true;
    $('importApplyAllBtn').disabled = true;
    let okCount = 0, ngCount = 0;
    for (const row of rowsToApply) {
      try {
        await upsertAttendance({
          staffId: row.staffId,
          date: row.date,
          salesGross: row.sales,
          sales: taxExcluded(row.sales),
          uncollected: row.uncollected,
          // 乗合分の売上（歩合から除外する設定のスタッフのみ計算で使う。0はデータ無しとみなしてnull）
          sharedRideSalesGross: row.sharedRideSalesGross || null,
          // 運行実績（0はデータ無しとみなしてnullで保存する）
          distanceKm: row.distanceKm || null,
          actualDistanceKm: row.actualDistanceKm || null,
          transportCount: row.transportCount || null,
          transportPersons: row.transportPersons || null,
          fuelLiters: row.fuelLiters || null,
          fuelAmount: row.fuelAmount || null,
          disabilityCount: row.disabilityCount || null,
          disabilityDiscount: row.disabilityDiscount || null,
        });
        okCount++;
      } catch (e) {
        ngCount++;
      }
    }
    await refreshData();
    renderHist(); renderWage();
    alert(`${okCount}件反映しました。${ngCount ? ngCount + '件は失敗しました。' : ''}`);
    importRows = [];
    $('importPreviewWrap').hidden = true;
    $('importApplyBtn').hidden = true;
    $('importApplyAllBtn').hidden = true;
    $('importApplyBtn').disabled = false;
    $('importApplyAllBtn').disabled = false;
  }
  $('importApplyBtn').onclick = () => {
    const checks = document.querySelectorAll('.importRowCheck:checked');
    if (!checks.length) { alert('反映する行を選択してください。'); return; }
    const rows = [...checks].map(cb => {
      const idx = cb.dataset.key.indexOf('|');
      const date = cb.dataset.key.slice(0, idx);
      const staffId = cb.dataset.key.slice(idx + 1);
      return importRows.find(r => r.date === date && r.staffId === staffId);
    }).filter(Boolean);
    return applyImportRows(rows);
  };
  $('importApplyAllBtn').onclick = () => {
    const rows = importRows.filter(r => r.status === 'new' || r.status === 'diff');
    if (!confirm(`チェックの有無に関わらず、対象の${rows.length}件をすべて反映します。よろしいですか？`)) return;
    return applyImportRows(rows);
  };

  // ── CSV出力 ──
  $('csvBtn').onclick = async () => {
    if (!(await requireAdmin())) return;
    renderAdminBar();
    const month = currentMonth();
    const recs = log.filter(r => r.date.startsWith(month)).sort((a, b) => a.date.localeCompare(b.date));
    if (!recs.length) { alert('この月の記録がありません'); return; }
    let csv = `﻿日付,名前,区分,電話番,出勤,退勤,休憩(分),時間内外出(分),実働(分),実働(時:分),売上税込(円),売上税抜(円),未収(円),基本給(円),歩合・手当(円),合計支給額(円),時給換算(円),最低賃金判定\n`;
    for (const rec of recs) {
      csv += excelRowFromRec(rec).join(',') + '\n';
    }

    csv += `\n設定：普通番日給${settings.normalWage}円／遅番日給${settings.lateWage + settings.lateBonus}円／電話番手当${settings.phoneAllowance}円／歩合率${settings.commissionRate}%／最低賃金${settings.minWage}円\n`;
    csv += `正社員：総支給額＝シフト日給＋電話番手当＋歩合給（売上税抜×歩合率）＋交通費(月額または日額・スタッフごとに設定)\n`;
    csv += `時給制（パート・正社員(時給)）：時間給×実働＋残業割増(8時間超×${OT_RATE * 100}%)＋深夜割増(${NIGHT_START_HOUR}時以降×${NIGHT_RATE * 100}%)＋交通費(月額または日額・スタッフごとに設定)\n`;
    csv += `月給制（正社員(月給)）：総支給額＝月給（固定）＋交通費(月額または日額・スタッフごとに設定)\n`;
    csv += `正社員（基本給のみ）：総支給額＝シフト日給＋電話番手当＋交通費(月額または日額・スタッフごとに設定)（歩合給なし）\n`;
    csv += `※このCSVの日ごとの基本給・歩合手当には交通費を含みません（交通費は月次サマリーでのみ加算）\n`;
    csv += '\n月次サマリー\n名前,区分,出勤日数,実働合計(分),実働合計(時:分),基本給合計(円),売上合計(円),歩合・手当合計(円),交通費(円),管理者手当(円),住宅手当(円),総支給額(円)\n';
    const totals = {};
    for (const rec of recs) {
      if (!rec.out) continue;
      if (!totals[rec.staffId]) totals[rec.staffId] = { days: 0, minutes: 0, wage: 0, sales: 0, commission: 0, empType: recEmpType(rec), monthlyWage: 0 };
      const t = totals[rec.staffId];
      const p = payParts(rec);
      t.days += 1;
      t.minutes += workMinutes(rec);
      t.wage += p.base;
      t.sales += (rec.sales || 0);
      t.commission += p.extra;
      if (isMonthlyType(t.empType)) t.monthlyWage = recMonthlyWage(rec);
    }
    for (const id of Object.keys(totals)) {
      const s = staff.find(x => x.id === id);
      const t = totals[id];
      const commute = monthlyCommute(recs.filter(r => r.staffId === id));
      const managerAllowance = monthlyManagerAllowance(recs.filter(r => r.staffId === id));
      const housingAllowance = monthlyHousingAllowance(recs.filter(r => r.staffId === id));
      const baseDisplay = isMonthlyType(t.empType) ? t.monthlyWage : t.wage;
      csv += [
        s ? s.name : '削除済み',
        EMP_LABEL[t.empType],
        t.days,
        t.minutes,
        hm(t.minutes),
        Math.round(baseDisplay),
        Math.round(t.sales),
        Math.round(t.commission),
        Math.round(commute),
        Math.round(managerAllowance),
        Math.round(housingAllowance),
        Math.round(baseDisplay + t.commission + commute + managerAllowance + housingAllowance),
      ].join(',') + '\n';
    }

    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `勤怠給与_${month}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);

    try { await recordExport(month, 'csv'); await refreshAndRenderExportStatus(); } catch { /* 出力自体は完了しているので記録失敗は無視 */ }
  };

  // ── 打刻のみ出力（Excel）──
  // 給与計算（歩合給・支給額など）は含めず、出退勤の時刻・実働時間だけを出力する。
  // 給与計算まわりの検証が追いつかない間も、打刻の記録だけは確実に確認・保管できるようにするための安全弁
  const TIME_ONLY_HEADERS = ['日付', '名前', '区分', '電話番', '出勤', '退勤', '休憩(時間)', '時間内外出(時間)', '実働(時間)'];
  const TIME_ONLY_WIDTHS = [10, 12, 16, 8, 8, 8, 10, 12, 10];
  // 分を時間（小数・小数第2位まで）に変換する
  function minutesToHours(min) {
    return Math.round((min || 0) / 60 * 100) / 100;
  }
  function timeOnlyRowFromRec(rec) {
    const s = staff.find(x => x.id === rec.staffId);
    const isSimple = usesSimplePunch(recEmpType(rec));
    const w = rec.out ? workMinutes(rec) : '';
    return [
      rec.date,
      s ? s.name : '削除済み',
      isSimple ? EMP_LABEL[recEmpType(rec)] : (rec.shiftType ? SHIFT_LABEL[rec.shiftType] : ''),
      rec.phoneDuty ? '有' : '',
      rec.in ? timeStr(rec.in) : '',
      rec.out ? timeStr(rec.out) : '',
      minutesToHours(breakMinutes(rec)),
      minutesToHours(awayMinutes(rec)),
      w !== '' ? minutesToHours(w) : '',
    ];
  }
  $('timeOnlyBtn').onclick = async () => {
    if (!(await requireAdmin())) return;
    renderAdminBar();
    const month = currentMonth();
    const monthRecs = log.filter(r => r.date.startsWith(month));
    if (!monthRecs.length) { alert('この月の記録がありません'); return; }

    // スタッフごとにまとめ、一覧の表示順→日付順に並べる（印刷したとき1人ずつまとまって見やすいように）
    const byStaff = {};
    for (const rec of monthRecs) (byStaff[rec.staffId] = byStaff[rec.staffId] || []).push(rec);
    const staffIds = Object.keys(byStaff).sort((a, b) => {
      const sa = staff.find(x => x.id === a), sb = staff.find(x => x.id === b);
      if (sa && sb) return sa.displayOrder - sb.displayOrder;
      if (sa) return -1;
      if (sb) return 1;
      return a.localeCompare(b);
    });
    for (const id of staffIds) byStaff[id].sort((a, b) => a.date.localeCompare(b.date));

    const COL_COUNT = TIME_ONLY_HEADERS.length;
    const THIN = { style: 'thin', color: { argb: 'FFB7B7B7' } };

    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet(month);
    // A4・横向き・幅を1ページに収め、見出し2行（タイトル・列名）を全ページで繰り返す
    ws.pageSetup = {
      paperSize: 9,
      orientation: 'landscape',
      fitToPage: true,
      fitToWidth: 1,
      fitToHeight: 0,
      margins: { left: 0.4, right: 0.4, top: 0.5, bottom: 0.5, header: 0.2, footer: 0.2 },
      printTitlesRow: '1:2',
    };
    ws.headerFooter = { oddFooter: '&Pページ / &N ページ' };

    // タイトル行
    ws.mergeCells(1, 1, 1, COL_COUNT);
    const titleCell = ws.getCell(1, 1);
    titleCell.value = `${month.replace('-', '年')}月　打刻のみ（勤怠記録）`;
    titleCell.font = { name: '游ゴシック', size: 13, bold: true };
    titleCell.alignment = { horizontal: 'left', vertical: 'middle' };
    ws.getRow(1).height = 24;

    // 列見出し行
    TIME_ONLY_HEADERS.forEach((h, i) => {
      const col = i + 1;
      const cell = ws.getCell(2, col);
      cell.value = h;
      cell.font = { name: '游ゴシック', size: 10, bold: true };
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD9E1F2' } };
      cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
      cell.border = { top: THIN, left: THIN, right: THIN, bottom: { style: 'medium', color: { argb: 'FF4472C4' } } };
      ws.getColumn(col).width = TIME_ONLY_WIDTHS[i];
      if (h.includes('(時間)')) ws.getColumn(col).numFmt = '0.00';
    });
    ws.getRow(2).height = 22;
    ws.views = [{ state: 'frozen', ySplit: 2 }];

    let row = 3;
    staffIds.forEach((id, idx) => {
      const s = staff.find(x => x.id === id);
      // スタッフ名の見出し行（結合セル）。印刷時、ここで人ごとの区切りが一目でわかるようにする
      ws.mergeCells(row, 1, row, COL_COUNT);
      const nameCell = ws.getCell(row, 1);
      nameCell.value = s ? `${s.name}（${EMP_LABEL[staffType(s)]}）` : '（削除済みスタッフ）';
      nameCell.font = { name: '游ゴシック', size: 11, bold: true, color: { argb: 'FF1F3864' } };
      nameCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFEDF1F8' } };
      nameCell.alignment = { horizontal: 'left', vertical: 'middle' };
      nameCell.border = { top: THIN, bottom: THIN, left: THIN, right: THIN };
      ws.getRow(row).height = 20;
      row++;

      for (const rec of byStaff[id]) {
        timeOnlyRowFromRec(rec).forEach((v, ci) => {
          const cell = ws.getCell(row, ci + 1);
          cell.value = v;
          cell.font = { name: '游ゴシック', size: 10 };
          cell.border = { top: THIN, bottom: THIN, left: THIN, right: THIN };
          cell.alignment = { horizontal: ci <= 1 ? 'left' : 'center', vertical: 'middle' };
        });
        row++;
      }
      // 次の人は新しいページから印刷されるようにする（最後の人の後ろには不要）
      if (idx < staffIds.length - 1) ws.getRow(row - 1).addPageBreak();
    });

    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `打刻のみ_${month}.xlsx`;
    a.click();
    URL.revokeObjectURL(a.href);
  };

  // ── 給与計算Excel出力（タイムカード形式：スタッフ別シート＋数式で自動計算） ──
  // 見た目は手作業タイムカード（新新タイムカードR8.6月分.xlsx）に寄せている。ExcelJSはSheetJS無料版と違い
  // フォント・塗りつぶし・罫線を書き出せるため採用（Excel自動保存の追記機能は引き続きSheetJSを使用）。
  const TC_TABLE_START = 11; // 日別テーブルの先頭行（1始まり）
  const TC_FONT = '游ゴシック';
  const TC_THIN = { style: 'thin', color: { argb: 'FFB7B7B7' } };
  const TC_BOX = { top: TC_THIN, bottom: TC_THIN, left: TC_THIN, right: TC_THIN };
  const TC_FILL_TITLE = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFF2CC' } };
  const TC_FILL_HEADER = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD9E1F2' } };
  const TC_FILL_HILITE = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE2EFDA' } };
  const TC_CENTER = { horizontal: 'center', vertical: 'middle' };

  // 値のみのセル（罫線なし・小さめラベル用）。空値は何もしない（数式で上書きされないよう）
  function tcVal(ws, addr, value, numFmt) {
    if (value === null || value === undefined || value === '') return ws.getCell(addr);
    const cell = ws.getCell(addr);
    cell.value = value;
    cell.font = { name: TC_FONT, size: 10 };
    if (numFmt) cell.numFmt = numFmt;
    return cell;
  }
  // 数式セル
  function tcFormula(ws, addr, f, numFmt) {
    const cell = ws.getCell(addr);
    cell.value = { formula: f };
    cell.font = { name: TC_FONT, size: 10 };
    if (numFmt) cell.numFmt = numFmt;
    return cell;
  }
  // タイトル帯（結合セル・太字・塗りつぶし・罫線）
  function tcTitle(ws, range, text, size) {
    ws.mergeCells(range);
    const cell = ws.getCell(range.split(':')[0]);
    cell.value = text;
    cell.font = { name: TC_FONT, size: size || 14, bold: true };
    cell.fill = TC_FILL_TITLE;
    cell.border = TC_BOX;
    cell.alignment = TC_CENTER;
    return cell;
  }
  // 見出し行（太字・塗りつぶし・罫線・中央揃え）。startCol/endColは1始まりの列番号
  function tcHeaderRow(ws, row, headers, startCol) {
    headers.forEach((h, i) => {
      const cell = ws.getCell(row, startCol + i);
      cell.value = h;
      cell.font = { name: TC_FONT, size: 9, bold: true };
      cell.fill = TC_FILL_HEADER;
      cell.border = TC_BOX;
      cell.alignment = TC_CENTER;
    });
  }
  // 日別テーブルの1行に罫線＋フォントを適用（値・数式のセットは別途）。hiliteColは実働時間などの強調列番号
  function tcRowStyle(ws, row, colCount, hiliteCol) {
    for (let c = 1; c <= colCount; c++) {
      const cell = ws.getCell(row, c);
      cell.border = TC_BOX;
      if (!cell.font) cell.font = { name: TC_FONT, size: 10 };
      if (hiliteCol && c === hiliteCol) cell.fill = TC_FILL_HILITE;
    }
  }
  function tcCols(ws, widths) {
    widths.forEach((w, i) => { ws.getColumn(i + 1).width = w; });
  }
  function tcSheetName(name, used) {
    let base = name.replace(/[:\\\/?*\[\]]/g, '・').slice(0, 25) || 'スタッフ';
    let candidate = base;
    let n = 2;
    while (used.has(candidate)) candidate = `${base}(${n++})`;
    used.add(candidate);
    return candidate;
  }
  function tcQuote(sheetName) {
    return `'${sheetName.replace(/'/g, "''")}'`;
  }
  function tcTimeSerial(iso) {
    const d = new Date(iso);
    return (d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds()) / 86400;
  }

  function buildStaffSheet(wb, sheetName, name, recsByDay, year, monthNum, daysInMonth, dailyWageOverride, commute, commuteType, managerAllowance, housingAllowance, excludeSharedRide) {
    const ws = wb.addWorksheet(sheetName);
    const endRow = TC_TABLE_START + daysInMonth - 1;
    const headers = ['日', '曜日', 'シフト', '電話番', '出勤', '退勤', '休憩(分)', '外出(分)', '実働(時間)', '売上税抜(円)', 'シフト日給(円)', '歩合給(円)', '日合計(円)', '時給換算(円)', '最低賃金判定'];
    const isDailyCommute = commuteType === 'daily';

    tcTitle(ws, 'A1:D1', `${year}年${monthNum}月 勤務表`);
    tcVal(ws, 'F1', '氏名');
    tcTitle(ws, 'G1:J1', name, 12);
    tcVal(ws, 'A2', isDailyCommute ? '交通費（日額・円）' : '交通費（月額・円）');
    tcVal(ws, 'B2', commute || 0, '#,##0');
    if (dailyWageOverride != null) {
      tcVal(ws, 'C3', '基本日給（固定・円）');
      tcVal(ws, 'D3', dailyWageOverride, '#,##0');
    }
    tcVal(ws, 'A3', '勤務日数');
    tcFormula(ws, 'B3', `COUNT(M${TC_TABLE_START}:M${endRow})`);
    tcVal(ws, 'A4', '実働合計（時間）');
    tcFormula(ws, 'B4', `SUM(I${TC_TABLE_START}:I${endRow})`, '0.00');
    tcVal(ws, 'A5', 'シフト日給合計（電話番手当込・円）');
    tcFormula(ws, 'B5', `SUM(K${TC_TABLE_START}:K${endRow})`, '#,##0');
    tcVal(ws, 'A6', '歩合給合計（円）');
    tcFormula(ws, 'B6', `SUM(L${TC_TABLE_START}:L${endRow})`, '#,##0');
    tcVal(ws, 'A7', '売上合計（税抜・円）');
    tcFormula(ws, 'B7', `SUM(J${TC_TABLE_START}:J${endRow})`, '#,##0');
    tcVal(ws, 'A8', '総支給額（円）');
    tcFormula(ws, 'B8', (isDailyCommute ? `SUM(M${TC_TABLE_START}:M${endRow})+$B$2*$B$3` : `SUM(M${TC_TABLE_START}:M${endRow})+$B$2`) + '+$B$9+$D$8', '#,##0');
    tcVal(ws, 'A9', '管理者手当（月額・円）');
    tcVal(ws, 'B9', managerAllowance || 0, '#,##0');
    tcVal(ws, 'C8', '住宅手当（月額・円）');
    tcVal(ws, 'D8', housingAllowance || 0, '#,##0');

    tcHeaderRow(ws, TC_TABLE_START - 1, headers, 1);

    const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
    for (let day = 1; day <= daysInMonth; day++) {
      const row = TC_TABLE_START + day - 1;
      const date = new Date(year, monthNum - 1, day);
      tcVal(ws, `A${row}`, day);
      tcVal(ws, `B${row}`, WEEKDAYS[date.getDay()]);
      const rec = recsByDay[day];
      if (rec) {
        tcVal(ws, `C${row}`, rec.shiftType ? SHIFT_LABEL[rec.shiftType] : '');
        tcVal(ws, `D${row}`, rec.phoneDuty ? '有' : '');
        if (rec.in) tcVal(ws, `E${row}`, tcTimeSerial(rec.in), 'h:mm');
        if (rec.out) tcVal(ws, `F${row}`, tcTimeSerial(rec.out), 'h:mm');
        tcVal(ws, `G${row}`, breakMinutes(rec));
        tcVal(ws, `H${row}`, awayMinutes(rec));
        if (rec.sales != null) tcVal(ws, `J${row}`, rec.sales, '#,##0');
      }
      tcFormula(ws, `I${row}`, `IF(OR($E${row}="",$F${row}=""),"",ROUND(($F${row}-$E${row}+IF($F${row}<$E${row},1,0))*24-IF($G${row}="",0,$G${row})/60-IF($H${row}="",0,$H${row})/60,2))`, '0.00');
      const dayWageFormula = dailyWageOverride != null
        ? `IF($C${row}="","",$D$3+IF($D${row}="有",設定!$B$5,0))`
        : `IF($C${row}="","",IF($C${row}="遅番",設定!$B$3+設定!$B$4,設定!$B$2)+IF($D${row}="有",設定!$B$5,0))`;
      tcFormula(ws, `K${row}`, dayWageFormula, '#,##0');
      // 歩合給を手修正した日、または乗合分を歩合から除外する設定で実際に乗合分がある日は、
      // 数式ではなくアプリと同じ計算結果（commissionPay）をそのまま書く
      if (rec && rec.commissionOverride != null) {
        tcVal(ws, `L${row}`, rec.commissionOverride, '#,##0');
      } else if (rec && excludeSharedRide && rec.sharedRideSalesGross) {
        tcVal(ws, `L${row}`, Math.round(commissionPay(rec)), '#,##0');
      } else {
        tcFormula(ws, `L${row}`, `IF($J${row}="","",ROUND(MAX(0,$J${row})*設定!$B$6/100,0))`, '#,##0');
      }
      tcFormula(ws, `M${row}`, `IF($K${row}="","",$K${row}+IF($L${row}="",0,$L${row}))`, '#,##0');
      tcFormula(ws, `N${row}`, `IF(OR($I${row}="",$I${row}=0,$M${row}=""),"",ROUND($M${row}/$I${row},0))`, '#,##0');
      tcFormula(ws, `O${row}`, `IF($N${row}="","",IF($N${row}<設定!$B$7,"最低賃金未満","OK"))`);
      tcRowStyle(ws, row, headers.length, 9);
    }

    tcCols(ws, [4, 5, 8, 7, 7, 7, 8, 8, 10, 12, 13, 11, 11, 12, 14]);
    return ws;
  }

  // パート（時給制）用シート。サマリーは正社員シートと同じ番地（B3〜B8）に置き、全体集計から共通参照する
  // 電話番チェックが有効な人（phoneDutyEnabled）は「有」の日に電話番手当を加算する（基本賃金合計に含めて集計）
  function buildPartSheet(wb, sheetName, name, recsByDay, year, monthNum, daysInMonth, hourlyWage, commute, commuteType, managerAllowance, housingAllowance) {
    const ws = wb.addWorksheet(sheetName);
    const endRow = TC_TABLE_START + daysInMonth - 1;
    const headers = ['日', '曜日', '電話番', '出勤', '退勤', '休憩(分)', '外出(分)', '実働(時:分)', '基本賃金(円)', '残業割増(円)', '深夜割増(円)', '電話番手当(円)', '日合計(円)', '時給換算(円)', '最低賃金判定'];
    const isDailyCommute = commuteType === 'daily';

    tcTitle(ws, 'A1:D1', `${year}年${monthNum}月 勤務表（時給制）`);
    tcVal(ws, 'F1', '氏名');
    tcTitle(ws, 'G1:J1', name, 12);
    tcVal(ws, 'A3', '勤務日数');
    tcFormula(ws, 'B3', `COUNT(M${TC_TABLE_START}:M${endRow})`);
    tcVal(ws, 'A4', '実働合計（時間）');
    tcFormula(ws, 'B4', `SUM(H${TC_TABLE_START}:H${endRow})*24`, '0.00');
    tcVal(ws, 'A5', '基本賃金合計（電話番手当込・円）');
    tcFormula(ws, 'B5', `SUM(I${TC_TABLE_START}:I${endRow})+SUM(L${TC_TABLE_START}:L${endRow})`, '#,##0');
    tcVal(ws, 'A6', '残業・深夜割増合計（円）');
    tcFormula(ws, 'B6', `SUM(J${TC_TABLE_START}:J${endRow})+SUM(K${TC_TABLE_START}:K${endRow})`, '#,##0');
    tcVal(ws, 'A7', '売上合計（時給制は対象外）');
    tcVal(ws, 'B7', 0);
    tcVal(ws, 'A8', '総支給額（円）');
    tcFormula(ws, 'B8', (isDailyCommute ? `SUM(M${TC_TABLE_START}:M${endRow})+$D$4*$B$3` : `SUM(M${TC_TABLE_START}:M${endRow})+$D$4`) + '+$B$9+$D$8', '#,##0');
    tcVal(ws, 'A9', '管理者手当（月額・円）');
    tcVal(ws, 'B9', managerAllowance || 0, '#,##0');
    tcVal(ws, 'C8', '住宅手当（月額・円）');
    tcVal(ws, 'D8', housingAllowance || 0, '#,##0');
    tcVal(ws, 'C3', '時間給（円）');
    tcVal(ws, 'D3', hourlyWage, '#,##0');
    tcVal(ws, 'C4', isDailyCommute ? '交通費（日額・円）' : '交通費（月額・円）');
    tcVal(ws, 'D4', commute, '#,##0');
    tcVal(ws, 'C5', '残業割増合計（円）');
    tcFormula(ws, 'D5', `SUM(J${TC_TABLE_START}:J${endRow})`, '#,##0');
    tcVal(ws, 'C6', '深夜割増合計（円）');
    tcFormula(ws, 'D6', `SUM(K${TC_TABLE_START}:K${endRow})`, '#,##0');
    tcVal(ws, 'C7', '実働合計（時:分）');
    tcFormula(ws, 'D7', `SUM(H${TC_TABLE_START}:H${endRow})`, '[h]:mm');

    tcHeaderRow(ws, TC_TABLE_START - 1, headers, 1);

    const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
    for (let day = 1; day <= daysInMonth; day++) {
      const row = TC_TABLE_START + day - 1;
      const date = new Date(year, monthNum - 1, day);
      tcVal(ws, `A${row}`, day);
      tcVal(ws, `B${row}`, WEEKDAYS[date.getDay()]);
      const rec = recsByDay[day];
      if (rec) {
        tcVal(ws, `C${row}`, rec.phoneDuty ? '有' : '');
        if (rec.in) tcVal(ws, `D${row}`, tcTimeSerial(rec.in), 'h:mm');
        if (rec.out) tcVal(ws, `E${row}`, tcTimeSerial(rec.out), 'h:mm');
        tcVal(ws, `F${row}`, breakMinutes(rec));
        tcVal(ws, `G${row}`, awayMinutes(rec));
      }
      // H＝実働時間（日の割合、[h]:mm表示で分単位まで表示。I/J/Nでは*24して時間換算する）
      tcFormula(ws, `H${row}`, `IF(OR($D${row}="",$E${row}=""),"",($E${row}-$D${row}+IF($E${row}<$D${row},1,0))-IF($F${row}="",0,$F${row})/1440-IF($G${row}="",0,$G${row})/1440)`, '[h]:mm');
      tcFormula(ws, `I${row}`, `IF($H${row}="","",ROUND($H${row}*24*$D$3,0))`, '#,##0');
      tcFormula(ws, `J${row}`, `IF($H${row}="","",ROUND(MAX(0,$H${row}*24-8)*$D$3*設定!$B$8/100,0))`, '#,##0');
      tcFormula(ws, `K${row}`, `IF($E${row}="","",ROUND(MAX(0,($E${row}-${NIGHT_START_HOUR}/24))*24*$D$3*設定!$B$8/100,0))`, '#,##0');
      tcFormula(ws, `L${row}`, `IF($C${row}="有",設定!$B$5,0)`, '#,##0');
      tcFormula(ws, `M${row}`, `IF($H${row}="","",$I${row}+$J${row}+$K${row}+$L${row})`, '#,##0');
      tcFormula(ws, `N${row}`, `IF(OR($H${row}="",$H${row}=0,$M${row}=""),"",ROUND($M${row}/($H${row}*24),0))`, '#,##0');
      tcFormula(ws, `O${row}`, `IF($N${row}="","",IF($N${row}<設定!$B$7,"最低賃金未満","OK"))`);
      tcRowStyle(ws, row, headers.length, 8);
    }

    tcCols(ws, [4, 5, 7, 7, 7, 8, 8, 10, 12, 11, 11, 11, 11, 12, 14]);
    return ws;
  }

  // 月給制（正社員(月給)）用シート。給与は固定額のため日別には計算せず、勤怠記録＋交通費のみ日別に集計する。
  // サマリーは他シートと同じ番地（B3〜B8）に置き、全体集計から共通参照する
  // hasCommissionFlag が true の人（正社員（月給＋歩合））は、月給に加えて歩合給も計算する。
  // その場合だけ売上税抜・歩合給の列を追加し、B6=歩合給合計・B7=売上合計（他シートと同じ意味に揃える）。
  // 交通費はB3〜B8のサマリー番地の外（A2/B2）に置く（buildStaffSheetと同じ配置）
  function buildMonthlySheet(wb, sheetName, name, recsByDay, year, monthNum, daysInMonth, monthlyWage, commute, commuteType, managerAllowance, housingAllowance, hasCommissionFlag, excludeSharedRide) {
    const ws = wb.addWorksheet(sheetName);
    const endRow = TC_TABLE_START + daysInMonth - 1;
    const headers = hasCommissionFlag
      ? ['日', '曜日', '出勤', '退勤', '休憩(分)', '外出(分)', '実働(時間)', '売上税抜(円)', '歩合給(円)']
      : ['日', '曜日', '出勤', '退勤', '休憩(分)', '外出(分)', '実働(時間)'];
    const isDailyCommute = commuteType === 'daily';

    tcTitle(ws, 'A1:D1', `${year}年${monthNum}月 勤務表（月給制${hasCommissionFlag ? '＋歩合' : ''}）`);
    tcVal(ws, 'F1', '氏名');
    tcTitle(ws, 'G1:J1', name, 12);
    tcVal(ws, 'A2', isDailyCommute ? '交通費（日額・円）' : '交通費（月額・円）');
    tcVal(ws, 'B2', commute || 0, '#,##0');
    tcVal(ws, 'A3', '勤務日数');
    tcFormula(ws, 'B3', `COUNT(G${TC_TABLE_START}:G${endRow})`);
    tcVal(ws, 'A4', '実働合計（時間）');
    tcFormula(ws, 'B4', `SUM(G${TC_TABLE_START}:G${endRow})`, '0.00');
    tcVal(ws, 'A5', '月給（円）');
    tcVal(ws, 'B5', monthlyWage, '#,##0');
    if (hasCommissionFlag) {
      tcVal(ws, 'A6', '歩合給合計（円）');
      tcFormula(ws, 'B6', `SUM(I${TC_TABLE_START}:I${endRow})`, '#,##0');
      tcVal(ws, 'A7', '売上合計（税抜・円）');
      tcFormula(ws, 'B7', `SUM(H${TC_TABLE_START}:H${endRow})`, '#,##0');
      tcVal(ws, 'A8', '総支給額（円）');
      tcFormula(ws, 'B8', (isDailyCommute ? '$B$5+$B$6+$B$2*$B$3' : '$B$5+$B$6+$B$2') + '+$B$9+$D$8', '#,##0');
    } else {
      tcVal(ws, 'A6', '歩合・手当合計（円・月給制は対象外）');
      tcVal(ws, 'B6', 0);
      tcVal(ws, 'A7', '売上合計（円・月給制は対象外）');
      tcVal(ws, 'B7', 0);
      tcVal(ws, 'A8', '総支給額（円）');
      tcFormula(ws, 'B8', (isDailyCommute ? '$B$5+$B$2*$B$3' : '$B$5+$B$2') + '+$B$9+$D$8', '#,##0');
    }
    tcVal(ws, 'A9', '管理者手当（月額・円）');
    tcVal(ws, 'B9', managerAllowance || 0, '#,##0');
    tcVal(ws, 'C8', '住宅手当（月額・円）');
    tcVal(ws, 'D8', housingAllowance || 0, '#,##0');

    tcHeaderRow(ws, TC_TABLE_START - 1, headers, 1);

    const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
    for (let day = 1; day <= daysInMonth; day++) {
      const row = TC_TABLE_START + day - 1;
      const date = new Date(year, monthNum - 1, day);
      tcVal(ws, `A${row}`, day);
      tcVal(ws, `B${row}`, WEEKDAYS[date.getDay()]);
      const rec = recsByDay[day];
      if (rec) {
        if (rec.in) tcVal(ws, `C${row}`, tcTimeSerial(rec.in), 'h:mm');
        if (rec.out) tcVal(ws, `D${row}`, tcTimeSerial(rec.out), 'h:mm');
        tcVal(ws, `E${row}`, breakMinutes(rec));
        tcVal(ws, `F${row}`, awayMinutes(rec));
        if (hasCommissionFlag && rec.sales != null) tcVal(ws, `H${row}`, rec.sales, '#,##0');
      }
      tcFormula(ws, `G${row}`, `IF(OR($C${row}="",$D${row}=""),"",ROUND(($D${row}-$C${row}+IF($D${row}<$C${row},1,0))*24-IF($E${row}="",0,$E${row})/60-IF($F${row}="",0,$F${row})/60,2))`, '0.00');
      if (hasCommissionFlag) {
        // 歩合給を手修正した日、または乗合分を歩合から除外する設定で実際に乗合分がある日は、
        // 数式ではなくアプリと同じ計算結果（commissionPay）をそのまま書く
        if (rec && rec.commissionOverride != null) {
          tcVal(ws, `I${row}`, rec.commissionOverride, '#,##0');
        } else if (rec && excludeSharedRide && rec.sharedRideSalesGross) {
          tcVal(ws, `I${row}`, Math.round(commissionPay(rec)), '#,##0');
        } else {
          tcFormula(ws, `I${row}`, `IF($H${row}="","",ROUND(MAX(0,$H${row})*設定!$B$6/100,0))`, '#,##0');
        }
      }
      tcRowStyle(ws, row, headers.length, 7);
    }

    tcCols(ws, hasCommissionFlag ? [4, 5, 7, 7, 8, 8, 10, 12, 11] : [4, 5, 7, 7, 8, 8, 10]);
    return ws;
  }

  $('timecardBtn').onclick = async () => {
    if (!(await requireAdmin())) return;
    renderAdminBar();
    const month = currentMonth(); // "YYYY-MM"
    const [year, monthNum] = month.split('-').map(Number);
    const daysInMonth = new Date(year, monthNum, 0).getDate();
    const monthRecs = log.filter(r => r.date.startsWith(month));
    if (!monthRecs.length) { alert('この月の記録がありません'); return; }

    const wb = new ExcelJS.Workbook();

    // 設定シート（各シートの数式がここを参照。値を変えると全シート再計算される）
    const wsSettings = wb.addWorksheet('設定');
    const settingRows = [
      ['項目', '数値', '備考'],
      ['普通番 基本日給（円）', settings.normalWage, '勤怠アプリ「給与設定」の値を出力時に転記'],
      ['遅番 基本日給（円）', settings.lateWage, ''],
      ['遅番 割増賃金（円）', settings.lateBonus, ''],
      ['電話番手当（円）', settings.phoneAllowance, ''],
      ['歩合率（％）', settings.commissionRate, '売上税抜に掛ける率'],
      ['最低賃金（円・確認用）', settings.minWage, '福島県の地域別最低賃金'],
      ['残業・深夜割増率（％）', OT_RATE * 100, `パート用：8時間超と${NIGHT_START_HOUR}時以降に時間給へ上乗せする率（法定25%）`],
    ];
    settingRows.forEach((cols, r) => {
      cols.forEach((v, c) => {
        const cell = wsSettings.getCell(r + 1, c + 1);
        cell.value = v;
        cell.font = { name: TC_FONT, size: 10, bold: r === 0 };
        cell.border = TC_BOX;
        if (r === 0) { cell.fill = TC_FILL_HEADER; cell.alignment = TC_CENTER; }
      });
    });
    tcCols(wsSettings, [24, 10, 40]);

    // スタッフごとに日別レコードを整理（1日1レコード）
    const usedNames = new Set(['設定', '全体集計', '使い方']);
    const byStaff = {};
    for (const rec of monthRecs) byStaff[rec.staffId] = byStaff[rec.staffId] || {};
    for (const rec of monthRecs) byStaff[rec.staffId][Number(rec.date.slice(8, 10))] = rec;

    // 区分と時給・月給・交通費は打刻時のスナップショット（rec）優先、無ければスタッフの現在値
    function targetOf(name, days, staffObj) {
      const recs = Object.values(days);
      const isPart = recs.some(r => isHourlyType(recEmpType(r)));
      const isMonthly = recs.some(r => isMonthlyType(recEmpType(r)));
      const isMonthlyCommission = recs.some(r => recEmpType(r) === 'monthly-commission');
      const src = recs.find(r => r.hourlyWage != null) || {};
      const monthlySrc = recs.find(r => r.monthlyWage != null) || {};
      const dailyWageSrc = recs.find(r => r.dailyWage != null);
      const commuteSrc = recs.find(r => r.commute != null) || {};
      const managerAllowanceSrc = recs.find(r => r.managerAllowance != null) || {};
      const housingAllowanceSrc = recs.find(r => r.housingAllowance != null) || {};
      return {
        name, days,
        isPart, isMonthly, isMonthlyCommission,
        hourlyWage: src.hourlyWage ?? (staffObj && staffObj.hourlyWage) ?? settings.minWage,
        monthlyWage: monthlySrc.monthlyWage ?? (staffObj && staffObj.monthlyWage) ?? 0,
        dailyWage: dailyWageSrc ? dailyWageSrc.dailyWage : ((staffObj && staffObj.dailyWage != null) ? staffObj.dailyWage : null),
        commute: commuteSrc.commute ?? (staffObj && staffObj.commuteAllowance) ?? 0,
        commuteType: commuteSrc.commuteType ?? (staffObj && staffObj.commuteType) ?? 'monthly',
        managerAllowance: managerAllowanceSrc.managerAllowance ?? (staffObj && staffObj.managerAllowance) ?? 0,
        housingAllowance: housingAllowanceSrc.housingAllowance ?? (staffObj && staffObj.housingAllowance) ?? 0,
        excludeSharedRide: !!(staffObj && staffObj.commissionExcludesSharedRide),
      };
    }
    const targets = staff.filter(s => byStaff[s.id]).map(s => targetOf(s.name, byStaff[s.id], s));
    const orphanIds = Object.keys(byStaff).filter(id => !staff.some(s => s.id === id));
    orphanIds.forEach((id, i) => targets.push(targetOf(`削除済みスタッフ${i + 1}`, byStaff[id], null)));

    // シート名を先に確定（全体集計の数式が参照するため）
    const staffSheets = targets.map(t => ({ target: t, sheetName: tcSheetName(t.name, usedNames), isPart: t.isPart || t.isMonthly }));

    // 全体集計シート（各スタッフシートのサマリーを参照。設定の直後＝2番目に配置）
    const wsAll = wb.addWorksheet('全体集計');
    tcTitle(wsAll, 'A1:C1', `${year}年${monthNum}月 給与集計`);
    tcHeaderRow(wsAll, 3, ['名前', '勤務日数', '実働合計(時間)', '基本給合計(円)', '歩合・手当合計(円)', '売上合計(円)', '総支給額(円)'], 1);
    staffSheets.forEach((s, i) => {
      const row = 4 + i;
      const q = tcQuote(s.sheetName);
      tcVal(wsAll, `A${row}`, s.target.name);
      tcFormula(wsAll, `B${row}`, `${q}!$B$3`);
      tcFormula(wsAll, `C${row}`, `${q}!$B$4`, '0.00');
      tcFormula(wsAll, `D${row}`, `${q}!$B$5`, '#,##0');
      tcFormula(wsAll, `E${row}`, `${q}!$B$6`, '#,##0');
      tcFormula(wsAll, `F${row}`, `${q}!$B$7`, '#,##0');
      tcFormula(wsAll, `G${row}`, `${q}!$B$8`, '#,##0');
      tcRowStyle(wsAll, row, 7);
    });
    const totalRow = 4 + staffSheets.length;
    tcVal(wsAll, `A${totalRow}`, '合計');
    for (const [i, col] of ['B', 'C', 'D', 'E', 'F', 'G'].entries()) {
      tcFormula(wsAll, `${col}${totalRow}`, `SUM(${col}4:${col}${totalRow - 1})`, col === 'C' ? '0.00' : '#,##0');
    }
    tcRowStyle(wsAll, totalRow, 7);
    wsAll.getRow(totalRow).font = { name: TC_FONT, size: 10, bold: true };
    tcCols(wsAll, [14, 9, 13, 16, 13, 13, 13]);

    // スタッフ別シート（設定・全体集計の後に追加）
    for (const s of staffSheets) {
      const t = s.target;
      if (t.isMonthly) buildMonthlySheet(wb, s.sheetName, t.name, t.days, year, monthNum, daysInMonth, t.monthlyWage, t.commute, t.commuteType, t.managerAllowance, t.housingAllowance, t.isMonthlyCommission, t.excludeSharedRide);
      else if (t.isPart) buildPartSheet(wb, s.sheetName, t.name, t.days, year, monthNum, daysInMonth, t.hourlyWage, t.commute, t.commuteType, t.managerAllowance, t.housingAllowance);
      else buildStaffSheet(wb, s.sheetName, t.name, t.days, year, monthNum, daysInMonth, t.dailyWage, t.commute, t.commuteType, t.managerAllowance, t.housingAllowance, t.excludeSharedRide);
    }

    // 使い方シート
    const usage = [
      ['【このファイルについて】'],
      ['勤怠アプリ（/kintai）の打刻データから自動生成した給与計算ブックです。'],
      [`対象月：${year}年${monthNum}月`],
      [''],
      ['【給与の計算式】（勤怠アプリと同じ）'],
      ['◎ 正社員：総支給額 ＝ シフト日給（普通番／遅番）＋ 電話番手当 ＋ 歩合給 ＋ 交通費（設定した場合）'],
      ['　　歩合給 ＝ 売上税抜 × 歩合率'],
      ['◎ 正社員（基本給のみ）：総支給額 ＝ シフト日給（普通番／遅番）＋ 電話番手当 ＋ 交通費（設定した場合）（歩合給はなし）'],
      ['◎ 時給制（パート・正社員(時給)）：総支給額 ＝ 時間給 × 実働時間 ＋ 残業割増（8時間超×25%）＋ 深夜割増（22時以降×25%）＋ 交通費'],
      ['　　時間給・交通費は各スタッフのシート右上（D3・D4）で変更できます。'],
      ['◎ 月給制（正社員(月給)）：総支給額 ＝ 月給（固定額）＋ 交通費'],
      ['　　月給・交通費は各スタッフのシート右上（D3・D4）で変更できます。実働時間は勤怠記録として参考表示のみで、金額には影響しません。'],
      [''],
      ['【交通費について】'],
      ['・交通費は「月額」（出勤日数に関わらず、その月に1日でも打刻があれば月額を1回だけ支給）が既定です。'],
      ['・スタッフによっては「日額」（出勤した日数分だけ加算）に設定している場合があります。各シートの交通費欄のラベルに「月額」か「日額」かが明記されています。'],
      [''],
      ['【シートの見方】'],
      ['・スタッフごとに1シート（正社員・パート・月給制で列構成が異なります）。出勤・退勤・休憩などは打刻データを転記済みです。'],
      ['・実働時間・日給・歩合給・日合計は数式です。時刻や売上を手で修正すると自動で再計算されます。'],
      ['・「設定」シートの数値（日給・歩合率など）を変更すると、全シートが再計算されます。'],
      ['・「全体集計」シートに全員の勤務日数・総支給額がまとまります。'],
      [''],
      ['【注意】'],
      ['・出力時点の打刻データのスナップショットです。以後の打刻は反映されないため、月末に再出力してください。'],
    ];
    const wsUsage = wb.addWorksheet('使い方');
    usage.forEach((cols, r) => {
      const cell = wsUsage.getCell(r + 1, 1);
      cell.value = cols[0];
      cell.font = { name: TC_FONT, size: 10 };
    });
    tcCols(wsUsage, [90]);

    const reiwa = year - 2018;
    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `タイムカードR${reiwa}.${monthNum}月分_給与計算.xlsx`;
    a.click();
    URL.revokeObjectURL(a.href);

    try { await recordExport(month, 'excel'); await refreshAndRenderExportStatus(); } catch { /* 出力自体は完了しているので記録失敗は無視 */ }
  };

  // ── 起動処理（Supabaseへのログイン→データ読み込み） ──
  async function boot() {
    const authResult = await initAuth();
    if (!authResult.ok) {
      alert(authResult.error || 'ログインできませんでした。ページを再読み込みしてもう一度お試しください。');
      return;
    }
    try {
      settings = await fetchSettings();
      staff = await fetchStaff();
      await refreshData();
    } catch (e) {
      /*
       * Supabase側の一時的な障害（2026-08-14〜の「401 errors due to JWT
       * rejections」で実際に発生）を、端末の設定・電波状況の問題と誤解しないよう
       * 分かる場合は専用の案内を出す
       */
      alert(isBackendOutage(e)
        ? 'データの読み込みに失敗しました。システム（Supabase）側で一時的な問題が'
          + '発生している可能性があります。端末の設定は関係ありません。'
          + '少し時間をおいてから、もう一度お試しください。'
        : 'データの読み込みに失敗しました。通信状況を確認してページを再読み込みしてください。');
      return;
    }
    await refreshAndRenderExportStatus();
    await refreshAndRenderOpenWarnings();
    renderAdminBar();
    renderStaff();
    renderPunch();
    renderToday();
    renderHist();
    renderWage();
  }
  boot();

  // ── 自動更新チェック（キオスク端末が開きっぱなしでも、アプリ更新時に安全なタイミングで自動リロードする） ──
  // 日をまたぐ打刻の不具合修正など、開きっぱなしの端末が古いコードのまま動き続けて
  // 同様の不具合を再発させることがあったため、新しいビルドを検知したら再読み込みする。
  const BUILD_CHECK_INTERVAL_MS = 10 * 60 * 1000; // 10分ごと
  let knownBuildId = null;
  async function fetchBuildId() {
    try {
      const res = await fetch(`/kintai-build.json?t=${Date.now()}`, { cache: 'no-store' });
      if (!res.ok) return null;
      const data = await res.json();
      return data.buildId || null;
    } catch {
      return null;
    }
  }
  async function checkForUpdate() {
    const latest = await fetchBuildId();
    if (!latest) return;
    if (knownBuildId === null) { knownBuildId = latest; return; }
    if (latest === knownBuildId) return;
    // 打刻の選択操作中は割り込まない。次回のチェックで再度試みる。
    if (selectedId !== null) return;
    location.reload();
  }
  setInterval(checkForUpdate, BUILD_CHECK_INTERVAL_MS);
  fetchBuildId().then(id => { if (id) knownBuildId = id; });
