---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="勤怠管理 – 富士タクシー（社内用）"
  description="富士タクシー社内用の勤怠管理アプリ。出勤・退勤の打刻、シフト日給・歩合給の給与計算、CSV出力ができます。"
  noindex
  hideFloatCta
  hideNav
  appIcon={{ key: 'kintai', name: '勤怠' }}
>

  <section class="page-hero bg-black">
    <div class="container">
      <p class="eyebrow">Staff Only</p>
      <h1 class="text-yellow">勤怠管理</h1>
      <p class="page-hero__lead">出勤・退勤をワンタップで記録。このページは社内用です。</p>
      <p class="kintai-clock" id="clock" aria-live="polite">--:--:--</p>
      <p class="kintai-date" id="today"></p>
    </div>
  </section>

  <section class="section bg-black" style="padding-top: 1rem;">
    <div class="container kintai-wrap">

      <!-- スタッフ選択 -->
      <div class="kt-panel">
        <div class="kt-panel__head">
          <h2 class="kt-title">スタッフ</h2>
          <button type="button" class="kt-btn kt-btn--ghost" id="addStaffBtn">＋ 追加</button>
        </div>
        <div class="kt-staff-list" id="staffList"></div>
        <p class="kt-empty" id="staffEmpty">「＋ 追加」からスタッフを登録してください。</p>
        <p class="kt-msg" id="staffMsg" aria-live="polite"></p>
      </div>

      <!-- 打刻パネル -->
      <div class="kt-panel kt-panel--punch" id="punchPanel" hidden>
        <p class="kt-selected">選択中：<strong id="selectedName"></strong></p>
        <p class="kt-status" id="statusLabel"></p>

        <!-- 出勤前：シフト選択（正社員） -->
        <div class="kt-shift-select" id="shiftSelect">
          <div id="phoneDutyBlock">
            <p class="kt-shift-select__label">① 電話番を担当する場合はチェック</p>
            <label class="kt-check">
              <input type="checkbox" id="phoneDutyCheck" />
              <span>電話番を担当する</span>
            </label>
            <p class="kt-shift-select__label">② シフトを選んで出勤</p>
          </div>
          <div class="kt-shift-grid" id="fulltimeShiftGrid">
            <button type="button" class="kt-shift-btn kt-shift-btn--normal" id="punchInNormal">
              <span class="kt-shift-btn__name">普通番で出勤</span>
            </button>
            <button type="button" class="kt-shift-btn kt-shift-btn--late" id="punchInLate">
              <span class="kt-shift-btn__name">遅番で出勤</span>
            </button>
          </div>
          <!-- 出勤前（パート）：シフトなしの単一出勤ボタン -->
          <div class="kt-shift-grid" id="partShiftGrid" hidden>
            <button type="button" class="kt-shift-btn kt-shift-btn--normal" id="punchInPart">
              <span class="kt-shift-btn__name">出勤</span>
            </button>
          </div>
        </div>

        <!-- 出勤後：通常の打刻グリッド -->
        <div class="kt-punch-grid" id="punchGrid" hidden>
          <button type="button" class="kt-punch kt-punch--out" id="punchOut">退勤</button>
          <button type="button" class="kt-punch kt-punch--break" id="punchBreakStart">休憩 開始</button>
          <button type="button" class="kt-punch kt-punch--break" id="punchBreakEnd">休憩 終了</button>
          <button type="button" class="kt-punch kt-punch--away" id="punchAwayStart">時間内退勤</button>
          <button type="button" class="kt-punch kt-punch--away" id="punchAwayEnd">時間内出勤</button>
        </div>

        <p class="kt-msg" id="punchMsg" aria-live="polite"></p>
        <button type="button" class="kt-btn kt-btn--ghost" id="undoBtn" hidden>操作を取り消す（押し間違えた場合）</button>
      </div>

      <!-- 売上入力モーダル（管理者専用・履歴から開く） -->
      <div class="kt-modal-overlay" id="salesModal" hidden>
        <div class="kt-modal" role="dialog" aria-modal="true" aria-labelledby="salesModalTitle">
          <h2 class="kt-title" id="salesModalTitle">売上の入力（管理者）</h2>
          <p class="kt-modal__staff" id="salesModalStaff"></p>

          <label class="kt-field kt-field--sales">
            <span>その日の売上合計（税込・円）</span>
            <input type="number" id="salesTotalInput" class="kt-input" min="0" inputmode="numeric" placeholder="例: 30000" />
          </label>
          <p class="kt-modal__taxnote" id="salesNetPreview">税抜：0円（歩合給の計算に使用）</p>

          <label class="kt-field">
            <span>未収（円・掛け／請求書払いなど当日未回収分）</span>
            <input type="number" id="salesUncollectedInput" class="kt-input" min="0" inputmode="numeric" placeholder="例: 0" />
          </label>

          <label class="kt-field" id="salesSharedRideBlock" hidden>
            <span>うち乗合分の売上（税込・円）※歩合給の計算から除外されます</span>
            <input type="number" id="salesSharedRideInput" class="kt-input" min="0" inputmode="numeric" placeholder="例: 5000" />
          </label>

          <div class="kt-modal__summary">
            <div class="kt-modal__summary-row">
              <span>歩合給（自動計算）</span>
              <strong id="salesCommissionAuto">0円</strong>
            </div>
            <label class="kt-field">
              <span>歩合給を手修正する場合（円）</span>
              <input type="number" id="salesCommissionOverride" class="kt-input" min="0" inputmode="numeric" placeholder="空欄なら自動計算を使用" />
            </label>
          </div>

          <div class="kt-modal__actions">
            <button type="button" class="kt-punch kt-punch--out" id="salesModalSubmit">保存する</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="salesModalCancel">キャンセル</button>
          </div>
        </div>
      </div>

      <!-- 打刻の手入力モーダル（管理者専用・電波障害等で打刻できなかった分をあとから入力） -->
      <div class="kt-modal-overlay" id="manualEntryModal" hidden>
        <div class="kt-modal" role="dialog" aria-modal="true" aria-labelledby="manualEntryModalTitle">
          <h2 class="kt-title" id="manualEntryModalTitle">打刻の手入力（管理者）</h2>
          <p class="kt-note">※ 電波障害などで打刻できなかった場合に、あとから出勤・退勤・休憩・時間内退勤の時刻を入力できます。既に記録がある日を選ぶと、その内容を修正できます。</p>

          <label class="kt-field">
            <span>スタッフ</span>
            <select id="manualEntryStaff" class="kt-input"></select>
          </label>
          <label class="kt-field">
            <span>日付</span>
            <input type="date" id="manualEntryDate" class="kt-input" />
          </label>
          <p class="kt-modal__taxnote" id="manualEntryExisting"></p>

          <label class="kt-inline-check">
            <input type="checkbox" id="manualEntryCommissionOnly" /><span>歩合給のみを記録する（出勤なし・売上をそのまま入力）</span>
          </label>
          <p class="kt-note">※ 取締役の売上を別のスタッフに付け替えた場合など、その日に本人の出勤打刻が無くても歩合だけ記録したい場合に使います。実働時間・基本給は発生しません。</p>

          <div id="manualEntryShiftFields">
            <p class="kt-shift-select__label">シフト区分</p>
            <div class="kt-settings-grid">
              <label class="kt-inline-check"><input type="radio" name="manualEntryShift" value="normal" checked /><span>普通番</span></label>
              <label class="kt-inline-check"><input type="radio" name="manualEntryShift" value="late" /><span>遅番</span></label>
              <label class="kt-inline-check"><input type="radio" name="manualEntryShift" value="part" /><span>パート</span></label>
            </div>
            <label class="kt-inline-check">
              <input type="checkbox" id="manualEntryPhoneDuty" /><span>電話番を担当</span>
            </label>

            <div class="kt-settings-grid">
              <label class="kt-field">
                <span>出勤時刻</span>
                <input type="time" id="manualEntryIn" class="kt-input" />
              </label>
              <label class="kt-field">
                <span>退勤時刻</span>
                <input type="time" id="manualEntryOut" class="kt-input" />
              </label>
              <label class="kt-field">
                <span>休憩開始（任意）</span>
                <input type="time" id="manualEntryBreakStart" class="kt-input" />
              </label>
              <label class="kt-field">
                <span>休憩終了（任意）</span>
                <input type="time" id="manualEntryBreakEnd" class="kt-input" />
              </label>
              <label class="kt-field">
                <span>時間内退勤時刻（任意）</span>
                <input type="time" id="manualEntryAwayStart" class="kt-input" />
              </label>
              <label class="kt-field">
                <span>時間内出勤時刻（任意）</span>
                <input type="time" id="manualEntryAwayEnd" class="kt-input" />
              </label>
            </div>
          </div>

          <label class="kt-field" id="manualEntrySalesBlock" hidden>
            <span>その日の売上合計（税込・円）</span>
            <input type="number" id="manualEntrySalesInput" class="kt-input" min="0" inputmode="numeric" placeholder="例: 7800" />
          </label>

          <div class="kt-modal__actions">
            <button type="button" class="kt-punch kt-punch--out" id="manualEntrySubmit">保存する</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="manualEntryCancel">キャンセル</button>
          </div>
        </div>
      </div>

      <!-- 本日の状況 -->
      <div class="kt-panel">
        <h2 class="kt-title">本日の状況</h2>
        <div class="kt-today" id="todayBoard"></div>
        <p class="kt-empty" id="todayEmpty">本日の打刻はまだありません。</p>
      </div>

      <!-- 管理者ロック -->
      <div class="kt-adminbar">
        <span class="kt-adminbar__label" id="adminState">🔒 売上・給与データは非表示中</span>
        <button type="button" class="kt-btn kt-btn--ghost" id="adminToggleBtn">管理者ロック解除</button>
      </div>

      <!-- 打刻漏れ警告（管理者のみ） -->
      <div class="kt-openwarn" id="openWarnBox" hidden>
        <p class="kt-openwarn__title">⚠️ 退勤の打刻漏れの可能性があります</p>
        <div class="kt-openwarn__list" id="openWarnList"></div>
      </div>

      <!-- 履歴（管理者のみ） -->
      <div class="kt-panel" id="histPanel" hidden>
        <div class="kt-panel__head">
          <h2 class="kt-title">勤務履歴（管理者）</h2>
          <div class="kt-panel__tools">
            <input type="month" id="monthPick" class="kt-input" />
            <button type="button" class="kt-btn" id="csvBtn">CSV出力</button>
            <button type="button" class="kt-btn" id="timecardBtn">給与計算Excel出力</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="timeOnlyBtn">打刻のみ出力（Excel）</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="manualEntryOpenBtn">📝 打刻を手入力で追加・修正</button>
          </div>
        </div>
        <div class="kt-exportstatus" id="exportStatus">
          <span class="kt-exportstatus__item" id="exportStatusCsv"></span>
          <span class="kt-exportstatus__item" id="exportStatusExcel"></span>
        </div>
        <p class="kt-note">※ CSV・給与計算Excelはブラウザの「ダウンロード」フォルダに保存されます（保存先を選ぶダイアログが出た場合はそちらで指定した場所）。出力状況は管理者・端末を問わず共通で表示されます。</p>
        <div class="kt-excelsync" id="excelSyncBox" hidden>
          <span class="kt-excelsync__label" id="excelSyncState">Excel自動保存：未設定</span>
          <div class="kt-excelsync__btns">
            <button type="button" class="kt-btn kt-btn--ghost" id="excelTemplateBtn">テンプレートをダウンロード</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelPickBtn">Excelファイルを選択</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelSyncNowBtn">未反映分を書き込む</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelRewriteAllBtn">全期間を書き直す</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelDisconnectBtn">接続を解除</button>
          </div>
          <p class="kt-note">※ 初めて自動保存を設定する場合は、まず「テンプレートをダウンロード」→ 保存した場所を「Excelファイルを選択」で選んでください。この接続はこの端末・このブラウザだけの設定です（他のパソコンや管理者には表示されません）。別の端末で自動保存を使う場合は、その端末でも同じ手順をやり直してください。<br />※ 給与の計算方法を変えたあとなど、すでに書き込み済みの行も今の金額に揃えたい場合は「全期間を書き直す」を押してください（同じ日・同じ人の行は上書きされるので、二重にはなりません）。</p>
        </div>

        <div class="kt-importsales">
          <p class="kt-title" style="font-size:1rem;">📥 元帳から売上を取り込む</p>
          <div class="kt-panel__tools">
            <input type="text" id="importSheetUrl" class="kt-input" placeholder="スプレッドシートのURLを貼り付け" style="min-width:280px;flex:1;" />
            <input type="month" id="importMonth" class="kt-input" />
            <button type="button" class="kt-btn kt-btn--ghost" id="importFetchBtn">取り込み内容を確認</button>
          </div>
          <p class="kt-note">※ 元帳タブ（例：2026.7月分）を開いた状態のURLを貼り付けてください。内容を確認してから反映するので、自動で上書きされることはありません。出勤の打刻が無い日は反映対象になりません。</p>
          <div class="kt-table-wrap" id="importPreviewWrap" hidden>
            <table class="kt-table" id="importPreviewTable">
              <thead>
                <tr><th>反映</th><th>日付</th><th>名前</th><th>状態</th><th>売上合計(円)</th><th>未収入金(円)</th></tr>
              </thead>
              <tbody id="importPreviewBody"></tbody>
            </table>
          </div>
          <button type="button" class="kt-btn" id="importApplyBtn" hidden>選択した内容を反映</button>
          <button type="button" class="kt-btn kt-btn--ghost" id="importApplyAllBtn" hidden>チェックに関わらず全て反映</button>
        </div>

        <p class="kt-note kt-note--scrollhint">← 表を横にスクロールすると他の項目も見られます →</p>
        <div class="kt-table-wrap">
          <table class="kt-table" id="histTable">
            <thead>
              <tr><th>日付</th><th>名前</th><th>区分</th><th>出勤</th><th>退勤</th><th>休憩</th><th>時間内外出</th><th>実働</th><th>売上(税込)</th><th>未収</th><th>基本給</th><th>歩合・手当</th><th>合計</th><th>時給換算</th><th>操作</th></tr>
            </thead>
            <tbody id="histBody"></tbody>
          </table>
        </div>
        <p class="kt-empty" id="histEmpty">この月の記録はありません。</p>
      </div>

      <!-- 月次給与サマリー（管理者のみ） -->
      <div class="kt-panel" id="wagePanel" hidden>
        <h2 class="kt-title">月次給与サマリー（管理者）</h2>
        <p class="kt-note kt-note--scrollhint">← 表を横にスクロールすると他の項目も見られます →</p>
        <div class="kt-table-wrap">
          <table class="kt-table" id="wageTable">
            <thead>
              <tr><th>名前</th><th>区分</th><th>出勤日数</th><th>実働合計</th><th>基本給合計</th><th>売上合計</th><th>歩合・手当合計</th><th>交通費(月額)</th><th>管理者手当</th><th>住宅手当</th><th>総支給額</th></tr>
            </thead>
            <tbody id="wageBody"></tbody>
          </table>
        </div>
        <p class="kt-empty" id="wageEmpty">この月の記録はありません。</p>
        <p class="kt-note" id="wageFormula">※ 正社員：総支給額 ＝ シフト日給 ＋ 電話番手当 ＋ 歩合給（売上税抜 × 歩合率）＋ 交通費（月額・設定した場合）<br />※ 正社員（基本給のみ）：総支給額 ＝ シフト日給 ＋ 電話番手当 ＋ 交通費（月額・設定した場合）｛歩合給なし｝<br />※ 時給制（パート・正社員(時給)）：総支給額 ＝ 時間給 × 実働時間 ＋ 残業割増（8時間超×25%）＋ 深夜割増（22時以降×25%）＋ 交通費（月額）<br />※ 月給制（正社員(月給)）：総支給額 ＝ 月給（固定）＋ 交通費（月額）<br />※ 交通費は出勤日数に関わらず、その月に打刻があれば月額を1回だけ加算します。<br />※ 勤務履歴の「時給換算」は 日ごとの基本給＋歩合・割増（交通費を含まない）÷ 実働時間 で算出し、最低賃金（設定値）を下回った日は赤色で警告表示します（月給制は対象外）。<br />※ 売上は税込で入力すると税抜が自動計算されます（歩合給の計算には税抜額を使用）。未収（掛け・請求書払いなど当日未回収分）は売上合計に含めて入力するため、歩合給の計算にも通常どおり反映されます（内訳を記録するための項目です）。</p>
      </div>

      <!-- 給与設定 -->
      <div class="kt-panel" id="settingsPanel" hidden>
        <h2 class="kt-title">給与設定（管理者）</h2>
        <div class="kt-settings-grid">
          <label class="kt-field">
            <span>普通番 基本日給（円）</span>
            <input type="number" id="setNormalWage" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>遅番 基本日給（円）</span>
            <input type="number" id="setLateWage" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>遅番 割増賃金（円）</span>
            <input type="number" id="setLateBonus" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>電話番手当（円）</span>
            <input type="number" id="setPhoneAllowance" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>歩合率（％）</span>
            <input type="number" id="setCommissionRate" class="kt-input" min="0" max="100" step="0.01" />
          </label>
          <label class="kt-field">
            <span>最低賃金（円・確認用）</span>
            <input type="number" id="setMinWage" class="kt-input" min="0" />
          </label>
        </div>
        <button type="button" class="kt-btn" id="saveSettingsBtn">設定を保存</button>
        <p class="kt-note">※ ここで設定した金額・歩合率が、すべてのスタッフの給与計算に使われます。</p>
      </div>
      <button type="button" class="kt-btn kt-btn--ghost" id="settingsToggleBtn" hidden>⚙ 給与設定を開く</button>
      <button type="button" class="kt-btn kt-btn--ghost" id="backupAllBtn" hidden>💾 全データバックアップを出力</button>
      <p class="kt-note" id="backupAllNote" hidden>※ スタッフ設定・給与設定・全期間の打刻・シフトデータをまとめてJSONファイルで保存します。誤操作や障害が起きた際の最後の砦として、月1回程度の実行をおすすめします。</p>
      <button type="button" class="kt-btn kt-btn--danger" id="clearLogBtn" hidden>🗑 全打刻データを削除</button>

      <p class="kt-note">※ データは全端末で共有されます。月末に「給与計算Excel出力」またはCSV出力で保管してください。</p>

    </div>
  </section>

</Layout>

<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>

<script>
  import {
    initAuth, isAdmin, isSuperAdmin, signInAdmin, signOutToKiosk,
    fetchStaff, insertStaff, updateStaff, deactivateStaff,
    fetchSettings, updateSettings as dbUpdateSettings,
    fetchMonth, fetchTodayOrOpen, fetchOpenAttendance, fetchAllAttendance, fetchOne, upsertAttendance, deleteAllAttendance, deleteAttendance,
    fetchExportLog, recordExport,
    fetchAllShifts, fetchAllShiftNotes,
    isBackendOutage,
  } from '../lib/kintai-db';

  // データはSupabaseが正。起動時にboot()でまとめて読み込む
  let staff = [];
  let settings = null;
  let log = [];       // 表示中の月（monthPick）の打刻データ
  let todayLog = [];  // 本日分の打刻データ（全スタッフ）
  let exportLog = []; // 表示中の月のCSV/給与計算Excel出力状況（全管理者・全端末で共有）
  let selectedId = null;

  // 直後の打刻取り消し（管理者パスワード不要・本人がその場で押し間違いに気づいた時用）。
  // 直前の1操作分だけを、操作前のスナップショットに戻す（時刻を自由に書き換えられるものではない）。
  // 共有端末で他のスタッフが間に打刻しても消えないよう、スタッフIDごとに直前操作を保持する
  const UNDO_WINDOW_MS = 30000;
  const lastActions = new Map(); // staffId -> { date, before, expiresAt, timer }
  function armUndo(staffId, date, before) {
    const existing = lastActions.get(staffId);
    if (existing && existing.timer) clearTimeout(existing.timer);
    const timer = setTimeout(() => {
      lastActions.delete(staffId);
      if (selectedId === staffId) renderPunch();
    }, UNDO_WINDOW_MS);
    lastActions.set(staffId, { date, before, expiresAt: Date.now() + UNDO_WINDOW_MS, timer });
  }
  function clearUndo(staffId) {
    const existing = lastActions.get(staffId);
    if (existing && existing.timer) clearTimeout(existing.timer);
    lastActions.delete(staffId);
  }
  async function undoLastAction() {
    const action = lastActions.get(selectedId);
    if (!action) return;
    const staffId = selectedId;
    const { date, before } = action;
    $('undoBtn').disabled = true;
    try {
      if (before === null) {
        const rec = todayRec(staffId);
        if (rec) await deleteAttendance(rec.id);
      } else {
        await upsertAttendance({
          staffId, date,
          in: before.in, out: before.out, shiftType: before.shiftType, phoneDuty: before.phoneDuty,
          breaks: before.breaks, leaves: before.leaves, empType: before.empType,
          hourlyWage: before.hourlyWage, monthlyWage: before.monthlyWage, dailyWage: before.dailyWage,
          commute: before.commute, commuteType: before.commuteType,
          salesGross: before.salesGross, sales: before.sales, uncollected: before.uncollected,
          commissionOverride: before.commissionOverride, sharedRideSalesGross: before.sharedRideSalesGross,
        });
      }
      clearUndo(staffId);
      await refreshData();
      $('punchMsg').textContent = '↩️ 直前の操作を取り消しました。';
      renderPunch(); renderToday(); renderHist(); renderWage();
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    } finally {
      $('undoBtn').disabled = false;
    }
  }

  const $ = (id) => document.getElementById(id);
  $('monthPick').value = dateKey().slice(0, 7);
  $('importMonth').value = dateKey().slice(0, 7);

  // ── 時計 ──
  function tick() {
    const now = new Date();
    $('clock').textContent = now.toLocaleTimeString('ja-JP');
    $('today').textContent = now.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
  }
  tick();
  setInterval(tick, 1000);

  function currentMonth() {
    return $('monthPick').value || dateKey().slice(0, 7);
  }

  /** 本日分（todayLog）と表示中の月（log）をSupabaseから再取得する。
   * todayLogには、日をまたぐ遅番など前日付けのまま退勤していないレコードも含む */
  async function refreshData() {
    const [t, m] = await Promise.all([
      fetchTodayOrOpen(dateKey(), yesterdayKey()),
      fetchMonth(currentMonth()),
    ]);
    todayLog = t;
    log = m;
  }
  const SAVE_FAIL_MSG = '通信エラーで保存できませんでした。電波状況を確認してもう一度お試しください。';

  function dateKey(d) {
    const dt = d ? new Date(d) : new Date();
    return `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-${String(dt.getDate()).padStart(2,'0')}`;
  }
  function yesterdayKey() {
    const dt = new Date();
    dt.setDate(dt.getDate() - 1);
    return dateKey(dt);
  }
  function timeStr(iso) {
    return new Date(iso).toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
  }
  function yen(n) {
    return Math.round(n).toLocaleString('ja-JP');
  }

  // ── Excel自動保存（ファイルシステムアクセスAPI） ──
  // 旧構成（全期間を1タブにまとめていた頃）のタブ名。初回書き込み時に月ごとのタブへ移行する
  const EXCEL_SHEET_NAME = 'CSV貼り付け';
  const EXCEL_OPS_SHEET_NAME = '運行実績';
  const OPS_HEADERS = ['日付', '名前', '走行距離(km)', '実車距離(km)', '実車率(%)', '輸送回数', '輸送人数', '給油量(L)', '給油金額(円)', '障がい回数', '身障者割引(円)'];
  const OPS_WIDTHS = [10, 12, 12, 12, 10, 10, 10, 10, 12, 11, 13];
  const PAYROLL_FIXED_HEADERS = ['日付', '名前', '区分', '電話番', '出勤', '退勤', '休憩(分)', '時間内外出(分)', '実働(分)', '実働(時:分)', '売上税込(円)', '売上税抜(円)', '未収(円)', '基本給(円)', '歩合・手当(円)', '合計支給額(円)', '時給換算(円)', '最低賃金判定'];
  const PAYROLL_FIXED_WIDTHS = [10, 12, 16, 8, 8, 8, 9, 13, 9, 11, 12, 12, 10, 10, 12, 13, 11, 14];
  const PAYROLL_MONEY_HEADERS = new Set(['売上税込(円)', '売上税抜(円)', '未収(円)', '基本給(円)', '歩合・手当(円)', '合計支給額(円)', '時給換算(円)']);
  function payrollHeaders() {
    return [...PAYROLL_FIXED_HEADERS];
  }
  // 月ごとのタブ名。給与は「2026-08」、運行実績は「2026-08 運行」
  const OPS_SHEET_SUFFIX = ' 運行';
  const SUMMARY_STAFF_SHEET = '集計_スタッフ別';
  const SUMMARY_TOTAL_SHEET = '集計_全体';
  function monthOfDate(dateStr) { return String(dateStr).slice(0, 7); }
  function opsSheetNameOf(month) { return month + OPS_SHEET_SUFFIX; }
  function isMonthSheetName(name) { return /^\d{4}-\d{2}$/.test(name); }
  function isOpsMonthSheetName(name) { return new RegExp('^\\d{4}-\\d{2}' + OPS_SHEET_SUFFIX + '$').test(name); }
  // 運行実績タブ用の1行分。運行実績が1つも無いレコードはnullを返す（書き出さない）
  function opsRowFromRec(rec) {
    if (!hasOperationDetail(rec)) return null;
    const s = staff.find(x => x.id === rec.staffId);
    const rate = (rec.distanceKm && rec.actualDistanceKm)
      ? Math.round(rec.actualDistanceKm / rec.distanceKm * 100) : '';
    return [
      rec.date,
      s ? s.name : '削除済み',
      rec.distanceKm != null ? rec.distanceKm : '',
      rec.actualDistanceKm != null ? rec.actualDistanceKm : '',
      rate,
      rec.transportCount != null ? rec.transportCount : '',
      rec.transportPersons != null ? rec.transportPersons : '',
      rec.fuelLiters != null ? rec.fuelLiters : '',
      rec.fuelAmount != null ? rec.fuelAmount : '',
      rec.disabilityCount != null ? rec.disabilityCount : '',
      rec.disabilityDiscount != null ? rec.disabilityDiscount : '',
    ];
  }
  const EXCEL_SUPPORTED = typeof window.showOpenFilePicker === 'function';
  const IDB_NAME = 'fuji-kintai-db';
  const IDB_STORE = 'handles';
  const IDB_KEY = 'excelFile';

  function idbOpen() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = () => { req.result.createObjectStore(IDB_STORE); };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }
  async function idbSet(key, value) {
    const db = await idbOpen();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, 'readwrite');
      tx.objectStore(IDB_STORE).put(value, key);
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }
  async function idbGet(key) {
    const db = await idbOpen();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, 'readonly');
      const req = tx.objectStore(IDB_STORE).get(key);
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }
  async function idbDelete(key) {
    const db = await idbOpen();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, 'readwrite');
      tx.objectStore(IDB_STORE).delete(key);
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  async function pickExcelFile() {
    if (!EXCEL_SUPPORTED) {
      alert('お使いのブラウザはこの機能に対応していません。Google ChromeまたはMicrosoft Edgeでお試しください。');
      return;
    }
    try {
      const [handle] = await window.showOpenFilePicker({
        types: [{ description: 'Excelファイル', accept: { 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': ['.xlsx'] } }],
        excludeAcceptAllOption: false,
      });
      await idbSet(IDB_KEY, handle);
      $('excelSyncState').textContent = `📄 ${handle.name} に接続済み`;
      renderExcelSyncBox();
    } catch (e) {
      if (e.name !== 'AbortError') alert('ファイルの選択に失敗しました：' + e.message);
    }
  }

  async function getExcelHandle() {
    try { return await idbGet(IDB_KEY); } catch { return undefined; }
  }

  async function ensureExcelPermission(handle) {
    const opts = { mode: 'readwrite' };
    if ((await handle.queryPermission(opts)) === 'granted') return true;
    if ((await handle.requestPermission(opts)) === 'granted') return true;
    return false;
  }

  function excelRowFromRec(rec) {
    const s = staff.find(x => x.id === rec.staffId);
    const w = rec.out ? workMinutes(rec) : '';
    const rate = hourlyRate(rec);
    const p = payParts(rec);
    const isSimple = usesSimplePunch(recEmpType(rec));
    const showsSales = hasCommission(recEmpType(rec));
    return [
      rec.date,
      s ? s.name : '削除済み',
      isSimple ? EMP_LABEL[recEmpType(rec)] : (rec.shiftType ? SHIFT_LABEL[rec.shiftType] : ''),
      rec.phoneDuty ? '有' : '',
      rec.in ? timeStr(rec.in) : '',
      rec.out ? timeStr(rec.out) : '',
      breakMinutes(rec),
      awayMinutes(rec),
      w,
      rec.out ? hm(w) : '',
      showsSales && rec.salesGross != null ? rec.salesGross : '',
      showsSales && rec.sales != null ? rec.sales : '',
      showsSales && rec.uncollected ? rec.uncollected : '',
      rec.out || rec.shiftType ? Math.round(p.base) : '',
      rec.out ? Math.round(p.extra) : '',
      rec.out ? Math.round(totalPay(rec)) : '',
      rate !== null ? Math.round(rate) : '',
      rate !== null ? (isBelowMinWage(rec) ? '最低賃金未満' : 'OK') : '',
    ];
  }

  // 見出し行（1行目）を除いた、A列に値が入っている最後の行の次（1始まりの行番号）を返す
  function nextEmptyRowIndex(ws) {
    let lastFilled = 1;
    for (let r = 2; r <= ws.rowCount; r++) {
      const v = ws.getCell(r, 1).value;
      if (v !== null && v !== undefined && v !== '') lastFilled = r;
    }
    return lastFilled + 1;
  }

  // 列幅・見出しの書式・ウィンドウ枠の固定などを壊さずに読み書きするため、
  // 自動保存の書き込みはExcelJS（読み込み時の書式を保持できる）で行う
  // recs＝給与関連タブに書き出す打刻（未反映のみ）、opsRecs＝運行実績タブに書き出す対象
  // （給与タブは反映済みでも、後から元帳取り込みで運行実績だけ追加された打刻も含む）
  // 月ごとのタブへ行を振り分けて書き込む。タブが無ければ見出し付きで作る。
  // 打刻は「日付＋名前」で一意なので、既に同じ行があれば上書きし、無ければ追記する。
  // これにより、別端末から同じファイルに書いた場合などでも行が二重にならず、
  // あとから売上を入力した場合もExcel側が最新の内容に更新される
  function appendRowsByMonth(wb, rows, buildHeader, sheetNameOf) {
    const byMonth = {};
    for (const row of rows) {
      const m = monthOfDate(row[0]);
      if (!/^\d{4}-\d{2}$/.test(m)) continue;
      (byMonth[m] = byMonth[m] || []).push(row);
    }
    let written = 0;
    for (const m of Object.keys(byMonth).sort()) {
      const name = sheetNameOf(m);
      let ws = wb.getWorksheet(name);
      if (!ws) { ws = wb.addWorksheet(name); buildHeader(ws); }
      // 既存行の「日付|名前」→行番号
      const rowOf = new Map();
      for (let r = 2; r <= ws.rowCount; r++) {
        const d = cellText(ws, r, 1);
        if (!d) continue;
        rowOf.set(d + '|' + cellText(ws, r, 2), r);
      }
      let next = nextEmptyRowIndex(ws);
      for (const vals of byMonth[m]) {
        const key = String(vals[0]) + '|' + String(vals[1]);
        let target = rowOf.get(key);
        if (target === undefined) { target = next++; rowOf.set(key, target); }
        vals.forEach((v, ci) => { ws.getCell(target, ci + 1).value = v; });
        written += 1;
      }
    }
    return written;
  }

  // シートの1行目を見出しとして読み、データ行を「見出し名 → 値」の形で取り出す。
  // 見出し名で対応づけるので、列の増減があった古いファイルでもずれない
  const SHEET_SCAN_COLS = 60;
  function readSheetRows(ws) {
    const head = [];
    for (let c = 1; c <= SHEET_SCAN_COLS; c++) head.push(cellText(ws, 1, c));
    while (head.length && head[head.length - 1] === '') head.pop();
    const rows = [];
    for (let r = 2; r <= ws.rowCount; r++) {
      if (!cellText(ws, r, 1)) continue;
      const obj = {};
      head.forEach((h, i) => { if (h) obj[h] = ws.getCell(r, i + 1).value; });
      rows.push(obj);
    }
    return { head, rows };
  }
  function rowsToArrays(rows, headers) {
    return rows.map(obj => headers.map(h => {
      const v = obj[h];
      return (v === undefined || v === null) ? '' : v;
    }));
  }

  // 月ごとのタブの見出しが今の構成と違う場合（手数料の列があった頃のファイルなど）、
  // 見出し名で対応づけてタブを作り直す。列がずれたまま追記されるのを防ぐ
  function ensureSheetSchema(wb, name, headers, buildHeader) {
    const ws = wb.getWorksheet(name);
    if (!ws) return false;
    const { head, rows } = readSheetRows(ws);
    if (head.length === headers.length && head.every((h, i) => h === headers[i])) return false;
    const arrays = rowsToArrays(rows, headers);
    wb.removeWorksheet(ws.id);
    const fresh = wb.addWorksheet(name);
    buildHeader(fresh);
    arrays.forEach((vals, i) => {
      vals.forEach((v, ci) => { fresh.getCell(i + 2, ci + 1).value = v; });
    });
    return true;
  }

  // 旧構成（全期間を1タブにまとめていた頃）のデータを月ごとのタブへ移す。
  // 元のタブは消さずに「_移行前」を付けて残し、取り違えや消失を防ぐ
  function migrateLegacySheet(wb, legacyName, headers, buildHeader, sheetNameOf) {
    const ws = wb.getWorksheet(legacyName);
    if (!ws) return 0;
    const { rows } = readSheetRows(ws);
    const moved = appendRowsByMonth(wb, rowsToArrays(rows, headers), buildHeader, sheetNameOf);
    const backupName = legacyName + '_移行前';
    if (!wb.getWorksheet(backupName)) ws.name = backupName;
    return moved;
  }

  function cellNum(ws, r, c) {
    const v = ws.getCell(r, c).value;
    if (typeof v === 'number') return v;
    if (typeof v === 'string' && v.trim() !== '') {
      const n = parseFloat(v.replace(/,/g, ''));
      return isNaN(n) ? 0 : n;
    }
    if (v && typeof v === 'object' && typeof v.result === 'number') return v.result;
    return 0;
  }
  function cellText(ws, r, c) {
    const v = ws.getCell(r, c).value;
    if (v === null || v === undefined) return '';
    if (typeof v === 'object' && v.result !== undefined) return String(v.result);
    return String(v);
  }

  // 集計タブ（スタッフ別・全体）を、ファイル内の月ごとタブの中身から作り直す
  const SUMMARY_STAFF_HEADERS = ['月', '名前', '出勤日数', '実働合計(時間)', '売上合計(円)', '基本給合計(円)', '歩合・手当合計(円)', '総支給額(円)', '走行距離(km)', '実車距離(km)', '実車率(%)', '輸送回数', '輸送人数', '給油量(L)', '給油金額(円)'];
  const SUMMARY_TOTAL_HEADERS = ['月', '延べ出勤日数', '実働合計(時間)', '売上合計(円)', '人件費合計(円)', '走行距離(km)', '実車距離(km)', '実車率(%)', '輸送回数', '輸送人数', '給油量(L)', '給油金額(円)'];
  function rebuildSummarySheets(wb) {
    // key: '月|名前'
    const byStaff = {};
    const pick = (m, name) => {
      const k = m + '|' + name;
      if (!byStaff[k]) {
        byStaff[k] = { month: m, name, days: 0, workMin: 0, sales: 0, base: 0, extra: 0, total: 0,
          dist: 0, actualDist: 0, tCount: 0, tPersons: 0, fuelL: 0, fuelYen: 0 };
      }
      return byStaff[k];
    };
    for (const ws of wb.worksheets) {
      if (isMonthSheetName(ws.name)) {
        for (let r = 2; r <= ws.rowCount; r++) {
          const d = cellText(ws, r, 1);
          if (!d) continue;
          const t = pick(ws.name, cellText(ws, r, 2));
          t.days += 1;
          t.workMin += cellNum(ws, r, 9);   // 実働(分)
          t.sales += cellNum(ws, r, 11);    // 売上税込
          t.base += cellNum(ws, r, 14);     // 基本給
          t.extra += cellNum(ws, r, 15);    // 歩合・手当
          t.total += cellNum(ws, r, 16);    // 合計支給額
        }
      } else if (isOpsMonthSheetName(ws.name)) {
        const m = ws.name.slice(0, 7);
        for (let r = 2; r <= ws.rowCount; r++) {
          const d = cellText(ws, r, 1);
          if (!d) continue;
          const t = pick(m, cellText(ws, r, 2));
          t.dist += cellNum(ws, r, 3);
          t.actualDist += cellNum(ws, r, 4);
          t.tCount += cellNum(ws, r, 6);
          t.tPersons += cellNum(ws, r, 7);
          t.fuelL += cellNum(ws, r, 8);
          t.fuelYen += cellNum(ws, r, 9);
        }
      }
    }

    const rate = (actual, dist) => (dist > 0 ? Math.round(actual / dist * 100) : '');
    const hours = (min) => (min > 0 ? Math.round(min / 60 * 100) / 100 : 0);
    const entries = Object.values(byStaff).sort((a, b) => b.month.localeCompare(a.month) || a.name.localeCompare(b.name));

    const wsStaff = resetSummarySheet(wb, SUMMARY_STAFF_SHEET, SUMMARY_STAFF_HEADERS, 'FFFFF2CC');
    entries.forEach((t, i) => {
      const row = [t.month, t.name, t.days, hours(t.workMin), t.sales, t.base, t.extra, t.total,
        t.dist, t.actualDist, rate(t.actualDist, t.dist), t.tCount, t.tPersons,
        Math.round(t.fuelL * 100) / 100, t.fuelYen];
      row.forEach((v, ci) => { wsStaff.getCell(i + 2, ci + 1).value = v; });
    });

    // 会社全体（月ごとにスタッフ分を合算）
    const byMonth = {};
    for (const t of entries) {
      const m = byMonth[t.month] = byMonth[t.month] || { days: 0, workMin: 0, sales: 0, total: 0,
        dist: 0, actualDist: 0, tCount: 0, tPersons: 0, fuelL: 0, fuelYen: 0 };
      m.days += t.days; m.workMin += t.workMin; m.sales += t.sales; m.total += t.total;
      m.dist += t.dist; m.actualDist += t.actualDist; m.tCount += t.tCount;
      m.tPersons += t.tPersons; m.fuelL += t.fuelL; m.fuelYen += t.fuelYen;
    }
    const wsTotal = resetSummarySheet(wb, SUMMARY_TOTAL_SHEET, SUMMARY_TOTAL_HEADERS, 'FFE2EFDA');
    Object.keys(byMonth).sort((a, b) => b.localeCompare(a)).forEach((m, i) => {
      const t = byMonth[m];
      const row = [m, t.days, hours(t.workMin), t.sales, t.total, t.dist, t.actualDist,
        rate(t.actualDist, t.dist), t.tCount, t.tPersons, Math.round(t.fuelL * 100) / 100, t.fuelYen];
      row.forEach((v, ci) => { wsTotal.getCell(i + 2, ci + 1).value = v; });
    });
  }
  // 集計タブは毎回作り直す（消してから作ることで、前回より件数が減った場合の残骸を防ぐ）
  function resetSummarySheet(wb, name, headers, headerColor) {
    const existing = wb.getWorksheet(name);
    if (existing) wb.removeWorksheet(existing.id);
    const ws = wb.addWorksheet(name);
    headers.forEach((h, i) => {
      const col = i + 1;
      const cell = ws.getCell(1, col);
      cell.value = h;
      cell.font = { name: '游ゴシック', size: 10, bold: true };
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: headerColor } };
      cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
      cell.border = { bottom: { style: 'thin', color: { argb: 'FFB7B7B7' } } };
      ws.getColumn(col).width = Math.min(18, Math.max(10, Math.ceil(h.length * 1.5) + 2));
      if (h.includes('(円)')) ws.getColumn(col).numFmt = '#,##0';
    });
    ws.getRow(1).height = 22;
    ws.views = [{ state: 'frozen', ySplit: 1 }];
    return ws;
  }

  async function appendRecordsToExcel(recs, opsRecs) {
    const handle = await getExcelHandle();
    if (!handle) return { ok: false, reason: 'no-handle' };
    if (!(await ensureExcelPermission(handle))) return { ok: false, reason: 'no-permission' };

    const file = await handle.getFile();
    const buf = await file.arrayBuffer();
    const wb = new ExcelJS.Workbook();
    await wb.xlsx.load(buf);
    // 勤怠用のファイルかどうかの確認（旧タブ・月タブ・使い方タブのいずれかがあればOK）
    const looksValid = wb.worksheets.some(w =>
      w.name === EXCEL_SHEET_NAME || w.name === EXCEL_OPS_SHEET_NAME
      || isMonthSheetName(w.name) || isOpsMonthSheetName(w.name) || w.name === '使い方');
    if (!looksValid) return { ok: false, reason: 'no-sheet' };

    // 旧構成のファイルは、はじめに月ごとのタブへ移行する
    // 既存の月タブが古い列構成（手数料の列があった頃など）なら、見出し名で対応づけて作り直す
    for (const name of wb.worksheets.map(w => w.name)) {
      if (isMonthSheetName(name)) ensureSheetSchema(wb, name, payrollHeaders(), buildPayrollSheetHeader);
      else if (isOpsMonthSheetName(name)) ensureSheetSchema(wb, name, OPS_HEADERS, buildOpsSheetHeader);
    }

    migrateLegacySheet(wb, EXCEL_SHEET_NAME, payrollHeaders(), buildPayrollSheetHeader, (m) => m);
    migrateLegacySheet(wb, EXCEL_OPS_SHEET_NAME, OPS_HEADERS, buildOpsSheetHeader, opsSheetNameOf);

    const count = appendRowsByMonth(wb, recs.map(excelRowFromRec), buildPayrollSheetHeader, (m) => m);
    const opsRows = opsRecs.map(opsRowFromRec).filter(Boolean);
    const opsCount = appendRowsByMonth(wb, opsRows, buildOpsSheetHeader, opsSheetNameOf);

    rebuildSummarySheets(wb);
    // タブの並びを整える（集計→月の新しい順→使い方・移行前バックアップ）
    sortWorkbookSheets(wb);

    const outBuf = await wb.xlsx.writeBuffer();
    const writable = await handle.createWritable();
    await writable.write(outBuf);
    await writable.close();
    return { ok: true, count, opsCount };
  }

  function sortWorkbookSheets(wb) {
    const rank = (name) => {
      if (name === SUMMARY_TOTAL_SHEET) return 0;
      if (name === SUMMARY_STAFF_SHEET) return 1;
      if (isMonthSheetName(name) || isOpsMonthSheetName(name)) return 2;
      return 3;
    };
    const sorted = [...wb.worksheets].sort((a, b) => {
      const d = rank(a.name) - rank(b.name);
      if (d !== 0) return d;
      if (rank(a.name) === 2) {
        // 月は新しい順。同じ月なら給与→運行の順
        const ma = a.name.slice(0, 7), mb = b.name.slice(0, 7);
        if (ma !== mb) return mb.localeCompare(ma);
        return a.name.length - b.name.length;
      }
      return 0;
    });
    sorted.forEach((ws, i) => { ws.orderNo = i + 1; });
  }

  // Excel自動保存の「送信済み」フラグはこの端末だけのローカルな状態（データ本体はSupabase共有のため、
  // 打刻レコードにフラグを持たせると他端末にも波及してしまう）。
  // 給与関連タブと運行実績タブは別々に追跡する（給与タブに反映済みでも、後から元帳取り込みで
  // 運行実績だけ追加された打刻は、運行実績タブにはまだ書き込まれていないことがあるため）。
  // IDだけでなく「実際に書き込んだ内容のハッシュ」も一緒に覚えておく。退勤直後は売上・歩合給が
  // 未入力のまま一度Excelに自動で書き込まれるため、IDだけで「送信済み」を判定すると、あとから
  // 管理者が売上を入力・修正してもExcel側がずっと更新されないままになってしまう
  // （歩合給がエクセルに反映されない不具合の原因）。内容が変わったら再び「未反映」として扱う
  const EXCEL_SYNCED_KEY = 'fuji-kintai-excel-synced-ids';
  const EXCEL_OPS_SYNCED_KEY = 'fuji-kintai-excel-ops-synced-ids';
  function rowHash(vals) {
    return JSON.stringify(vals);
  }
  function getSyncedMap(key) {
    try {
      const raw = JSON.parse(localStorage.getItem(key) || '{}');
      // 旧形式（IDのみの配列）は内容の変更を検知できないため、次回すべて書き直す
      return (raw && typeof raw === 'object' && !Array.isArray(raw)) ? raw : {};
    } catch { return {}; }
  }
  function markSyncedMap(key, entries) {
    const cur = getSyncedMap(key);
    for (const [id, hash] of entries) cur[id] = hash;
    localStorage.setItem(key, JSON.stringify(cur));
  }

  async function syncUnsyncedToExcel(showAlert) {
    const syncedMap = getSyncedMap(EXCEL_SYNCED_KEY);
    const syncedOpsMap = getSyncedMap(EXCEL_OPS_SYNCED_KEY);
    // 表示中の月（log）だけでなく、過去分も含めた全期間のデータを対象にする
    let allRecs;
    try {
      allRecs = await fetchAllAttendance();
    } catch (e) {
      if (showAlert) alert(SAVE_FAIL_MSG);
      return { ok: false, reason: 'fetch-failed' };
    }
    // 前回書き込んだ内容（ハッシュ）と今書き込むはずの内容が同じ記録は除外し、
    // 新規・内容が変わった記録だけを対象にする
    const unsyncedPairs = allRecs.filter(r => r.out)
      .map(r => [r, rowHash(excelRowFromRec(r))])
      .filter(([r, h]) => syncedMap[r.id] !== h);
    const unsyncedOpsPairs = allRecs.filter(hasOperationDetail)
      .map(r => [r, rowHash(opsRowFromRec(r))])
      .filter(([r, h]) => syncedOpsMap[r.id] !== h);
    const unsynced = unsyncedPairs.map(([r]) => r);
    const unsyncedOps = unsyncedOpsPairs.map(([r]) => r);
    const result = await appendRecordsToExcel(unsynced, unsyncedOps);
    if (result.ok) {
      if (result.count) markSyncedMap(EXCEL_SYNCED_KEY, unsyncedPairs.map(([r, h]) => [r.id, h]));
      if (result.opsCount) markSyncedMap(EXCEL_OPS_SYNCED_KEY, unsyncedOpsPairs.map(([r, h]) => [r.id, h]));
      if (showAlert) {
        const parts = [];
        if (result.count) parts.push(`打刻${result.count}件`);
        if (result.opsCount) parts.push(`運行実績${result.opsCount}件`);
        alert(parts.length ? `${parts.join('・')}をExcelに書き込みました。` : '未反映のデータはありませんでした。');
      }
    } else if (showAlert) {
      const messages = {
        'no-handle': 'Excelファイルが選択されていません。「Excelファイルを選択」から設定してください。',
        'no-permission': 'ファイルへのアクセス許可が得られませんでした。',
        'no-sheet': `選択したファイルに「${EXCEL_SHEET_NAME}」シートが見つかりません。`,
      };
      alert(messages[result.reason] || 'Excelへの書き込みに失敗しました。');
    }
    return result;
  }

