  $('excelTemplateBtn').onclick = async () => {
    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet(EXCEL_SHEET_NAME);
    const FIXED_HEADERS = ['日付', '名前', '区分', '電話番', '出勤', '退勤', '休憩(分)', '時間内外出(分)', '実働(分)', '実働(時:分)', '売上税込(円)', '売上税抜(円)', '未収(円)', 'カード手数料等(円)', '基本給(円)', '歩合・手当(円)', '合計支給額(円)', '時給換算(円)', '最低賃金判定'];
    const FIXED_WIDTHS = [10, 12, 16, 8, 8, 8, 9, 13, 9, 11, 12, 12, 10, 16, 10, 12, 13, 11, 14];
    const MONEY_HEADERS = new Set(['売上税込(円)', '売上税抜(円)', '未収(円)', 'カード手数料等(円)', '基本給(円)', '歩合・手当(円)', '合計支給額(円)', '時給換算(円)']);
    const headers = [...FIXED_HEADERS, ...PAY_METHODS.map(m => `${m.label}(円)`)];
    headers.forEach((h, i) => {
      const col = i + 1;
      const cell = ws.getCell(1, col);
      cell.value = h;
      cell.font = { name: '游ゴシック', size: 10, bold: true };
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD9E1F2' } };
      cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
      cell.border = { bottom: { style: 'thin', color: { argb: 'FF9DB4D0' } } };
      const width = FIXED_WIDTHS[i] != null ? FIXED_WIDTHS[i] : Math.min(30, Math.max(12, Math.ceil(h.length * 1.6) + 2));
      ws.getColumn(col).width = width;
