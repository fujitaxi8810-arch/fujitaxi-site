  // 運行実績タブの見出し行を作る（テンプレート作成時と、タブが無いファイルへの初回書き込み時に使う）
  function buildOpsSheetHeader(ws) {
    OPS_HEADERS.forEach((h, i) => {
      const col = i + 1;
      const cell = ws.getCell(1, col);
      cell.value = h;
      cell.font = { name: '游ゴシック', size: 10, bold: true };
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE2EFDA' } };
      cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
      cell.border = { bottom: { style: 'thin', color: { argb: 'FF9DC3A0' } } };
      ws.getColumn(col).width = OPS_WIDTHS[i];
      if (h === '給油金額(円)' || h === '身障者割引(円)') ws.getColumn(col).numFmt = '#,##0';
    });
    ws.getRow(1).height = 22;
    ws.views = [{ state: 'frozen', ySplit: 1 }];
  }

  // 給与タブ（月ごと）の見出し行を作る
  function buildPayrollSheetHeader(ws) {
    const headers = payrollHeaders();
    headers.forEach((h, i) => {
      const col = i + 1;
      const cell = ws.getCell(1, col);
      cell.value = h;
      cell.font = { name: '游ゴシック', size: 10, bold: true };
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD9E1F2' } };
      cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
      cell.border = { bottom: { style: 'thin', color: { argb: 'FF9DB4D0' } } };
      const width = PAYROLL_FIXED_WIDTHS[i] != null ? PAYROLL_FIXED_WIDTHS[i] : Math.min(30, Math.max(12, Math.ceil(h.length * 1.6) + 2));
      ws.getColumn(col).width = width;
      if (PAYROLL_MONEY_HEADERS.has(h)) ws.getColumn(col).numFmt = '#,##0';
    });
    ws.getRow(1).height = 22;
    // 見出し行を画面に固定し、データが増えても常に見出しが見えるようにする
    ws.views = [{ state: 'frozen', ySplit: 1 }];
  }

