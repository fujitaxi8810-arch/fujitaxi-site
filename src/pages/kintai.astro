  // ── 打刻漏れ検知（退勤し忘れて「勤務中」のまま長時間経過している人を警告） ──
  const OPEN_WARN_HOURS = 15; // 最も長い遅番シフトより十分長い時間を経過したら「打刻漏れ」とみなす
  let openWarnRecs = [];
  async function refreshOpenWarnings() {
    if (!isAdmin()) { openWarnRecs = []; return; }
    try {
      const recs = await fetchOpenAttendance();
      const now = Date.now();
      openWarnRecs = recs.filter(r => r.in && (now - new Date(r.in).getTime()) >= OPEN_WARN_HOURS * 3600000);
    } catch { openWarnRecs = []; }
  }
  function renderOpenWarnings() {
    if (!isAdmin()) { $('openWarnBox').hidden = true; return; }
    $('openWarnBox').hidden = openWarnRecs.length === 0;
    const list = $('openWarnList');
    list.innerHTML = '';
    for (const r of openWarnRecs) {
      const s = staff.find(x => x.id === r.staffId);
      const elapsedHours = Math.floor((Date.now() - new Date(r.in).getTime()) / 3600000);
      const span = document.createElement('span');
      span.className = 'kt-openwarn__item';
      const inDate = new Date(r.in);
      span.textContent = `${s ? s.name : '（不明）'}：${inDate.getMonth() + 1}/${inDate.getDate()} ${timeStr(r.in)}出勤・経過${elapsedHours}時間`;
      list.appendChild(span);
    }
  }
  async function refreshAndRenderOpenWarnings() {
