---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="勤怠管理 – 富士タクシー（社内用）"
  description="富士タクシー社内用の勤怠管理アプリ。出勤・退勤の打刻、シフト日給・歩合給の給与計算、CSV出力ができます。"
  noindex
  hideFloatCta
  hideNav
  appIcon={{ key: 'kintai', name: '勤怠' }}
>

  <section class="page-hero bg-black">
    <div class="container">
      <p class="eyebrow">Staff Only</p>
      <h1 class="text-yellow">勤怠管理</h1>
      <p class="page-hero__lead">出勤・退勤をワンタップで記録。このページは社内用です。</p>
      <p class="kintai-clock" id="clock" aria-live="polite">--:--:--</p>
      <p class="kintai-date" id="today"></p>
    </div>
  </section>

  <section class="section bg-black" style="padding-top: 1rem;">
    <div class="container kintai-wrap">

      <!-- スタッフ選択 -->
      <div class="kt-panel">
        <div class="kt-panel__head">
          <h2 class="kt-title">スタッフ</h2>
          <button type="button" class="kt-btn kt-btn--ghost" id="addStaffBtn">＋ 追加</button>
        </div>
        <div class="kt-staff-list" id="staffList"></div>
        <p class="kt-empty" id="staffEmpty">「＋ 追加」からスタッフを登録してください。</p>
        <p class="kt-msg" id="staffMsg" aria-live="polite"></p>
      </div>

      <!-- 打刻パネル -->
      <div class="kt-panel kt-panel--punch" id="punchPanel" hidden>
        <p class="kt-selected">選択中：<strong id="selectedName"></strong></p>
        <p class="kt-status" id="statusLabel"></p>

        <!-- 出勤前：シフト選択（正社員） -->
        <div class="kt-shift-select" id="shiftSelect">
          <div id="phoneDutyBlock">
            <p class="kt-shift-select__label">① 電話番を担当する場合はチェック</p>
            <label class="kt-check">
              <input type="checkbox" id="phoneDutyCheck" />
              <span>電話番を担当する</span>
            </label>
            <p class="kt-shift-select__label">② シフトを選んで出勤</p>
          </div>
          <div class="kt-shift-grid" id="fulltimeShiftGrid">
            <button type="button" class="kt-shift-btn kt-shift-btn--normal" id="punchInNormal">
              <span class="kt-shift-btn__name">普通番で出勤</span>
            </button>
            <button type="button" class="kt-shift-btn kt-shift-btn--late" id="punchInLate">
              <span class="kt-shift-btn__name">遅番で出勤</span>
            </button>
          </div>
          <!-- 出勤前（パート）：シフトなしの単一出勤ボタン -->
          <div class="kt-shift-grid" id="partShiftGrid" hidden>
            <button type="button" class="kt-shift-btn kt-shift-btn--normal" id="punchInPart">
              <span class="kt-shift-btn__name">出勤</span>
            </button>
          </div>
        </div>

        <!-- 出勤後：通常の打刻グリッド -->
        <div class="kt-punch-grid" id="punchGrid" hidden>
          <button type="button" class="kt-punch kt-punch--out" id="punchOut">退勤</button>
          <button type="button" class="kt-punch kt-punch--break" id="punchBreakStart">休憩 開始</button>
          <button type="button" class="kt-punch kt-punch--break" id="punchBreakEnd">休憩 終了</button>
          <button type="button" class="kt-punch kt-punch--away" id="punchAwayStart">時間内退勤</button>
          <button type="button" class="kt-punch kt-punch--away" id="punchAwayEnd">時間内出勤</button>
        </div>

        <p class="kt-msg" id="punchMsg" aria-live="polite"></p>
        <button type="button" class="kt-btn kt-btn--ghost" id="undoBtn" hidden>操作を取り消す（押し間違えた場合）</button>
      </div>

      <!-- 売上入力モーダル（管理者専用・履歴から開く） -->
      <div class="kt-modal-overlay" id="salesModal" hidden>
        <div class="kt-modal" role="dialog" aria-modal="true" aria-labelledby="salesModalTitle">
          <h2 class="kt-title" id="salesModalTitle">売上の入力（管理者）</h2>
          <p class="kt-modal__staff" id="salesModalStaff"></p>

          <label class="kt-field kt-field--sales">
            <span>その日の売上合計（税込・円）</span>
            <input type="number" id="salesTotalInput" class="kt-input" min="0" inputmode="numeric" placeholder="例: 30000" />
          </label>
          <p class="kt-modal__taxnote" id="salesNetPreview">税抜：0円（歩合給の計算に使用）</p>

          <label class="kt-field">
            <span>未収（円・掛け／請求書払いなど当日未回収分）</span>
            <input type="number" id="salesUncollectedInput" class="kt-input" min="0" inputmode="numeric" placeholder="例: 0" />
          </label>

          <p class="kt-shift-select__label">決済方法ごとの内訳（該当分のみ入力・現金は不要）</p>
          <div class="kt-modal__methods" id="salesMethodFields"></div>

          <div class="kt-modal__summary">
            <div class="kt-modal__summary-row">
              <span>手数料合計（自動計算）</span>
              <strong id="salesFeeAuto">0円</strong>
            </div>
            <label class="kt-field">
              <span>手数料合計を手修正する場合（円）</span>
              <input type="number" id="salesFeeOverride" class="kt-input" min="0" inputmode="numeric" placeholder="空欄なら自動計算を使用" />
            </label>
          </div>

          <div class="kt-modal__actions">
            <button type="button" class="kt-punch kt-punch--out" id="salesModalSubmit">保存する</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="salesModalCancel">キャンセル</button>
          </div>
        </div>
      </div>

      <!-- 打刻の手入力モーダル（管理者専用・電波障害等で打刻できなかった分をあとから入力） -->
      <div class="kt-modal-overlay" id="manualEntryModal" hidden>
        <div class="kt-modal" role="dialog" aria-modal="true" aria-labelledby="manualEntryModalTitle">
          <h2 class="kt-title" id="manualEntryModalTitle">打刻の手入力（管理者）</h2>
          <p class="kt-note">※ 電波障害などで打刻できなかった場合に、あとから出勤・退勤・休憩・時間内退勤の時刻を入力できます。既に記録がある日を選ぶと、その内容を修正できます。</p>

          <label class="kt-field">
            <span>スタッフ</span>
            <select id="manualEntryStaff" class="kt-input"></select>
          </label>
          <label class="kt-field">
            <span>日付</span>
            <input type="date" id="manualEntryDate" class="kt-input" />
          </label>
          <p class="kt-modal__taxnote" id="manualEntryExisting"></p>

          <p class="kt-shift-select__label">シフト区分</p>
          <div class="kt-settings-grid">
            <label class="kt-inline-check"><input type="radio" name="manualEntryShift" value="normal" checked /><span>普通番</span></label>
            <label class="kt-inline-check"><input type="radio" name="manualEntryShift" value="late" /><span>遅番</span></label>
            <label class="kt-inline-check"><input type="radio" name="manualEntryShift" value="part" /><span>パート</span></label>
          </div>
          <label class="kt-inline-check">
            <input type="checkbox" id="manualEntryPhoneDuty" /><span>電話番を担当</span>
          </label>

          <div class="kt-settings-grid">
            <label class="kt-field">
              <span>出勤時刻</span>
              <input type="time" id="manualEntryIn" class="kt-input" />
            </label>
            <label class="kt-field">
              <span>退勤時刻</span>
              <input type="time" id="manualEntryOut" class="kt-input" />
            </label>
            <label class="kt-field">
              <span>休憩開始（任意）</span>
              <input type="time" id="manualEntryBreakStart" class="kt-input" />
            </label>
            <label class="kt-field">
              <span>休憩終了（任意）</span>
              <input type="time" id="manualEntryBreakEnd" class="kt-input" />
            </label>
            <label class="kt-field">
              <span>時間内退勤時刻（任意）</span>
              <input type="time" id="manualEntryAwayStart" class="kt-input" />
            </label>
            <label class="kt-field">
              <span>時間内出勤時刻（任意）</span>
              <input type="time" id="manualEntryAwayEnd" class="kt-input" />
            </label>
          </div>

          <div class="kt-modal__actions">
            <button type="button" class="kt-punch kt-punch--out" id="manualEntrySubmit">保存する</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="manualEntryCancel">キャンセル</button>
          </div>
        </div>
      </div>

      <!-- 本日の状況 -->
      <div class="kt-panel">
        <h2 class="kt-title">本日の状況</h2>
        <div class="kt-today" id="todayBoard"></div>
        <p class="kt-empty" id="todayEmpty">本日の打刻はまだありません。</p>
      </div>

      <!-- 管理者ロック -->
      <div class="kt-adminbar">
        <span class="kt-adminbar__label" id="adminState">🔒 売上・給与データは非表示中</span>
        <button type="button" class="kt-btn kt-btn--ghost" id="adminToggleBtn">管理者ロック解除</button>
      </div>

      <!-- 打刻漏れ警告（管理者のみ） -->
      <div class="kt-openwarn" id="openWarnBox" hidden>
        <p class="kt-openwarn__title">⚠️ 退勤の打刻漏れの可能性があります</p>
        <div class="kt-openwarn__list" id="openWarnList"></div>
      </div>

      <!-- 履歴（管理者のみ） -->
      <div class="kt-panel" id="histPanel" hidden>
        <div class="kt-panel__head">
          <h2 class="kt-title">勤務履歴（管理者）</h2>
          <div class="kt-panel__tools">
            <input type="month" id="monthPick" class="kt-input" />
            <button type="button" class="kt-btn" id="csvBtn">CSV出力</button>
            <button type="button" class="kt-btn" id="timecardBtn">給与計算Excel出力</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="manualEntryOpenBtn">📝 打刻を手入力で追加・修正</button>
          </div>
        </div>
        <div class="kt-exportstatus" id="exportStatus">
          <span class="kt-exportstatus__item" id="exportStatusCsv"></span>
          <span class="kt-exportstatus__item" id="exportStatusExcel"></span>
        </div>
        <p class="kt-note">※ CSV・給与計算Excelはブラウザの「ダウンロード」フォルダに保存されます（保存先を選ぶダイアログが出た場合はそちらで指定した場所）。出力状況は管理者・端末を問わず共通で表示されます。</p>
        <div class="kt-excelsync" id="excelSyncBox" hidden>
          <span class="kt-excelsync__label" id="excelSyncState">Excel自動保存：未設定</span>
          <div class="kt-excelsync__btns">
            <button type="button" class="kt-btn kt-btn--ghost" id="excelTemplateBtn">テンプレートをダウンロード</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelPickBtn">Excelファイルを選択</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelSyncNowBtn">未反映分を書き込む</button>
            <button type="button" class="kt-btn kt-btn--ghost" id="excelDisconnectBtn">接続を解除</button>
          </div>
          <p class="kt-note">※ 初めて自動保存を設定する場合は、まず「テンプレートをダウンロード」→ 保存した場所を「Excelファイルを選択」で選んでください。この接続はこの端末・このブラウザだけの設定です（他のパソコンや管理者には表示されません）。別の端末で自動保存を使う場合は、その端末でも同じ手順をやり直してください。</p>
        </div>

        <div class="kt-importsales">
          <p class="kt-title" style="font-size:1rem;">📥 元帳から売上を取り込む</p>
          <div class="kt-panel__tools">
            <input type="text" id="importSheetUrl" class="kt-input" placeholder="スプレッドシートのURLを貼り付け" style="min-width:280px;flex:1;" />
            <input type="month" id="importMonth" class="kt-input" />
            <button type="button" class="kt-btn kt-btn--ghost" id="importFetchBtn">取り込み内容を確認</button>
          </div>
          <p class="kt-note">※ 元帳タブ（例：2026.7月分）を開いた状態のURLを貼り付けてください。内容を確認してから反映するので、自動で上書きされることはありません。出勤の打刻が無い日は反映対象になりません。</p>
          <div class="kt-table-wrap" id="importPreviewWrap" hidden>
            <table class="kt-table" id="importPreviewTable">
              <thead>
                <tr><th>反映</th><th>日付</th><th>名前</th><th>状態</th><th>売上合計(円)</th><th>未収入金(円)</th></tr>
              </thead>
              <tbody id="importPreviewBody"></tbody>
            </table>
          </div>
          <button type="button" class="kt-btn" id="importApplyBtn" hidden>選択した内容を反映</button>
        </div>

        <p class="kt-note kt-note--scrollhint">← 表を横にスクロールすると他の項目も見られます →</p>
        <div class="kt-table-wrap">
          <table class="kt-table" id="histTable">
            <thead>
              <tr><th>日付</th><th>名前</th><th>区分</th><th>出勤</th><th>退勤</th><th>休憩</th><th>時間内外出</th><th>実働</th><th>売上(税込)</th><th>未収</th><th>カード手数料</th><th>基本給</th><th>歩合・手当</th><th>合計</th><th>時給換算</th><th>操作</th></tr>
            </thead>
            <tbody id="histBody"></tbody>
          </table>
        </div>
        <p class="kt-empty" id="histEmpty">この月の記録はありません。</p>
      </div>

      <!-- 月次給与サマリー（管理者のみ） -->
      <div class="kt-panel" id="wagePanel" hidden>
        <h2 class="kt-title">月次給与サマリー（管理者）</h2>
        <p class="kt-note kt-note--scrollhint">← 表を横にスクロールすると他の項目も見られます →</p>
        <div class="kt-table-wrap">
          <table class="kt-table" id="wageTable">
            <thead>
              <tr><th>名前</th><th>区分</th><th>出勤日数</th><th>実働合計</th><th>基本給合計</th><th>売上合計</th><th>歩合・手当合計</th><th>交通費(月額)</th><th>管理者手当</th><th>住宅手当</th><th>総支給額</th></tr>
            </thead>
            <tbody id="wageBody"></tbody>
          </table>
        </div>
        <p class="kt-empty" id="wageEmpty">この月の記録はありません。</p>
        <p class="kt-note" id="wageFormula">※ 正社員：総支給額 ＝ シフト日給 ＋ 電話番手当 ＋ 歩合給｛（売上税抜 − カード手数料等）× 歩合率｝＋ 交通費（月額・設定した場合）<br />※ 正社員（基本給のみ）：総支給額 ＝ シフト日給 ＋ 電話番手当 ＋ 交通費（月額・設定した場合）｛歩合給なし｝<br />※ 時給制（パート・正社員(時給)）：総支給額 ＝ 時間給 × 実働時間 ＋ 残業割増（8時間超×25%）＋ 深夜割増（22時以降×25%）＋ 交通費（月額）<br />※ 月給制（正社員(月給)）：総支給額 ＝ 月給（固定）＋ 交通費（月額）<br />※ 交通費は出勤日数に関わらず、その月に打刻があれば月額を1回だけ加算します。<br />※ 勤務履歴の「時給換算」は 日ごとの基本給＋歩合・割増（交通費を含まない）÷ 実働時間 で算出し、最低賃金（設定値）を下回った日は赤色で警告表示します（月給制は対象外）。<br />※ 売上は税込で入力すると税抜が自動計算されます（歩合給の計算には税抜額を使用）。未収（掛け・請求書払いなど当日未回収分）は売上合計に含めて入力するため、歩合給の計算にも通常どおり反映されます（内訳を記録するための項目です）。</p>
      </div>

      <!-- 給与設定 -->
      <div class="kt-panel" id="settingsPanel" hidden>
        <h2 class="kt-title">給与設定（管理者）</h2>
        <div class="kt-settings-grid">
          <label class="kt-field">
            <span>普通番 基本日給（円）</span>
            <input type="number" id="setNormalWage" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>遅番 基本日給（円）</span>
            <input type="number" id="setLateWage" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>遅番 割増賃金（円）</span>
            <input type="number" id="setLateBonus" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>電話番手当（円）</span>
            <input type="number" id="setPhoneAllowance" class="kt-input" min="0" />
          </label>
          <label class="kt-field">
            <span>歩合率（％）</span>
            <input type="number" id="setCommissionRate" class="kt-input" min="0" max="100" step="0.01" />
          </label>
          <label class="kt-field">
            <span>最低賃金（円・確認用）</span>
            <input type="number" id="setMinWage" class="kt-input" min="0" />
          </label>
        </div>
        <p class="kt-shift-select__label" style="margin-top:1rem;">決済方法ごとの手数料率（％）</p>
        <div class="kt-settings-grid" id="feeRateFields"></div>
        <button type="button" class="kt-btn" id="saveSettingsBtn">設定を保存</button>
        <p class="kt-note">※ ここで設定した金額・歩合率・手数料率が、すべてのスタッフの給与計算に使われます。手数料率はSBペイメントサービス収納明細書（2026年6月分）の実績値を初期値にしています。料率改定があった場合はここで更新してください。</p>
      </div>
      <button type="button" class="kt-btn kt-btn--ghost" id="settingsToggleBtn" hidden>⚙ 給与設定を開く</button>
      <button type="button" class="kt-btn kt-btn--ghost" id="backupAllBtn" hidden>💾 全データバックアップを出力</button>
      <p class="kt-note" id="backupAllNote" hidden>※ スタッフ設定・給与設定・全期間の打刻・シフトデータをまとめてJSONファイルで保存します。誤操作や障害が起きた際の最後の砦として、月1回程度の実行をおすすめします。</p>
      <button type="button" class="kt-btn kt-btn--danger" id="clearLogBtn" hidden>🗑 全打刻データを削除</button>

      <p class="kt-note">※ データは全端末で共有されます。月末に「給与計算Excel出力」またはCSV出力で保管してください。</p>

    </div>
  </section>

</Layout>

<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>

<script>
  import {
    initAuth, isAdmin, isSuperAdmin, signInAdmin, signOutToKiosk,
    fetchStaff, insertStaff, updateStaff, deactivateStaff,
    fetchSettings, updateSettings as dbUpdateSettings,
    fetchMonth, fetchTodayOrOpen, fetchOpenAttendance, fetchAllAttendance, fetchOne, upsertAttendance, deleteAllAttendance, deleteAttendance,
    fetchExportLog, recordExport,
    fetchAllShifts, fetchAllShiftNotes,
    isBackendOutage,
  } from '../lib/kintai-db';

  // 決済方法マスタ。rateはSBペイメントサービス収納明細書（2026/06/16-06/30分）の実績値。
  // 楽天Pay・au PAYは決済手数料3.24%＋決済サービス利用料0.15%の合算。
  const PAY_METHODS = [
    { id: 'visa',       label: 'VISA / Mastercard',              rate: 2.8 },
    { id: 'jcb',        label: 'JCB / AMEX / Diners',            rate: 3.24 },
    { id: 'transit',    label: '交通系IC',                        rate: 2.0 },
    { id: 'emoney',     label: '電子マネー（Edy・iD・WAON・nanaco）', rate: 2.9 },
    { id: 'quicpay',    label: 'QUICPay',                        rate: 3.24 },
    { id: 'rakuten',    label: '楽天Pay / au PAY',               rate: 3.39 },
    { id: 'paypay',     label: 'PayPay（別端末）',                rate: 2.18 },
    { id: 'dbarai',     label: 'd払い（別端末）',                 rate: 2.6 },
    { id: 'merpay',     label: 'メルペイ（別端末）',               rate: 2.6 },
    { id: 'aiticket',   label: '愛のタクシーチケット',             rate: 5 },
    { id: 'jcbticket',  label: 'JCBタクシーチケット',             rate: 4 },
  ];

  // データはSupabaseが正。起動時にboot()でまとめて読み込む
  let staff = [];
  let settings = null;
  let log = [];       // 表示中の月（monthPick）の打刻データ
  let todayLog = [];  // 本日分の打刻データ（全スタッフ）
  let exportLog = []; // 表示中の月のCSV/給与計算Excel出力状況（全管理者・全端末で共有）
  let selectedId = null;

  // 直後の打刻取り消し（管理者パスワード不要・本人がその場で押し間違いに気づいた時用）。
  // 直前の1操作分だけを、操作前のスナップショットに戻す（時刻を自由に書き換えられるものではない）。
  // 共有端末で他のスタッフが間に打刻しても消えないよう、スタッフIDごとに直前操作を保持する
  const UNDO_WINDOW_MS = 30000;
  const lastActions = new Map(); // staffId -> { date, before, expiresAt, timer }
  function armUndo(staffId, date, before) {
    const existing = lastActions.get(staffId);
    if (existing && existing.timer) clearTimeout(existing.timer);
    const timer = setTimeout(() => {
      lastActions.delete(staffId);
      if (selectedId === staffId) renderPunch();
    }, UNDO_WINDOW_MS);
    lastActions.set(staffId, { date, before, expiresAt: Date.now() + UNDO_WINDOW_MS, timer });
  }
  function clearUndo(staffId) {
    const existing = lastActions.get(staffId);
    if (existing && existing.timer) clearTimeout(existing.timer);
    lastActions.delete(staffId);
  }
  async function undoLastAction() {
    const action = lastActions.get(selectedId);
    if (!action) return;
    const staffId = selectedId;
    const { date, before } = action;
    $('undoBtn').disabled = true;
    try {
      if (before === null) {
        const rec = todayRec(staffId);
        if (rec) await deleteAttendance(rec.id);
      } else {
        await upsertAttendance({
          staffId, date,
          in: before.in, out: before.out, shiftType: before.shiftType, phoneDuty: before.phoneDuty,
          breaks: before.breaks, leaves: before.leaves, empType: before.empType,
          hourlyWage: before.hourlyWage, monthlyWage: before.monthlyWage, dailyWage: before.dailyWage,
          commute: before.commute, commuteType: before.commuteType,
          salesGross: before.salesGross, sales: before.sales, uncollected: before.uncollected,
          cardFee: before.cardFee, payments: before.payments,
        });
      }
      clearUndo(staffId);
      await refreshData();
      $('punchMsg').textContent = '↩️ 直前の操作を取り消しました。';
      renderPunch(); renderToday(); renderHist(); renderWage();
    } catch (e) {
      alert(SAVE_FAIL_MSG);
    } finally {
      $('undoBtn').disabled = false;
    }
  }

